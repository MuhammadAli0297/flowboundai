---
import "../index.css"
import Seo from "../components/Seo.astro"
import Nav from "../components/Nav.astro"
import Footer from "../components/Footer.astro"

interface Props {
  title: string
  description: string
  path?: string
  ogImage?: string
  schema?: Record<string, unknown> | Record<string, unknown>[]
  noindex?: boolean
}

const { title, description, path, ogImage, schema, noindex } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)" />
    <link rel="alternate" type="application/rss+xml" title="Flowbound Blog" href="/rss.xml" />
    <Seo title={title} description={description} path={path} ogImage={ogImage} schema={schema} noindex={noindex} />

    <!-- Satoshi stays preloaded even though only /404 renders it now (the Hot Sauce rebuild's
         standing exception): it's still the base-layer default (src/index.css's `h1-h4`/`body`
         rules), so any page content that ever skips an explicit font-hanken override falls back to
         it, and /404 itself needs it unconditionally. -->
    <link rel="preload" href="/fonts/satoshi-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/satoshi-400.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="min-h-screen bg-bold-paper">
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
