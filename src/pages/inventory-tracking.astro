---
import BaseLayout from "../layouts/BaseLayout.astro"
import Cta from "../components/Cta.astro"
import InventoryTrackingBackground from "../components/InventoryTrackingBackground.astro"
import SectionIcon from "../components/icons/SectionIcon.astro"

const GLOW_SIZE = 420

const capabilities = [
  {
    title: "Real-Time Stock Levels",
    description:
      "On-hand counts stay current the moment something sells, ships, or gets restocked, so what you see is what's actually sitting on the shelf.",
  },
  {
    title: "Tracks What's Incoming",
    description:
      "Every open purchase order and its expected arrival date is visible against your current stock, so nothing gets reordered twice while it's already on the way.",
  },
  {
    title: "Reserves What's Already Spoken For",
    description:
      "Stock that's allocated to an order or a wholesale commitment is netted out automatically, so you never promise inventory you don't actually have free to sell.",
  },
  {
    title: "One View Across Every Channel",
    description:
      "Warehouse, storefront, and wholesale stock all roll up into a single number per SKU, instead of three spreadsheets that disagree with each other.",
  },
  {
    title: "Flags Discrepancies Automatically",
    description:
      "When a recorded count and an actual count drift apart, Flowbound flags it right away, before a small mismatch turns into a larger reconciliation problem.",
  },
  {
    title: "No Manual Counts Required",
    description:
      "The system of record updates itself from real activity, so your team isn't the one keeping the spreadsheet honest.",
  },
]

const signals = [
  "On-hand quantity by SKU and location",
  "Incoming purchase orders and ETAs",
  "Reserved and allocated stock",
  "Channel-level stock across storefront and wholesale",
  "Returns and restocks",
  "Cycle count adjustments",
  "Transfers between locations",
  "Backorder and stockout status",
]

const steps = [
  {
    n: "01",
    title: "It syncs with every location",
    body: "Flowbound pulls live counts from your warehouse, storefront, and wholesale systems continuously, not on a nightly schedule.",
  },
  {
    n: "02",
    title: "It nets out what's already spoken for",
    body: "Reserved and allocated stock gets subtracted automatically, so the number you see is what's actually available to sell.",
  },
  {
    n: "03",
    title: "It tells you what's real",
    body: "One number for what's on hand, what's incoming, and what's promised, no reconciling three reports by hand to find out.",
  },
]

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Inventory Tracking",
  applicationCategory: "BusinessApplication",
  description:
    "Flowbound's inventory tracking service gives small and mid-sized businesses real-time visibility into what's on hand, what's incoming, and what's already spoken for, across every channel.",
  audience: {
    "@type": "Audience",
    audienceType: "Small and mid-sized businesses",
  },
}
---

<BaseLayout
  title="Inventory Tracking | Flowbound"
  description="Flowbound's inventory tracking gives you real-time visibility into what's on hand, what's incoming, and what's already spoken for, so you never reorder something you already have or promise stock you don't."
  path="/inventory-tracking"
  schema={schema}
>
  <section class="relative min-h-[560px] overflow-hidden bg-fb-black md:min-h-[680px]">
    <InventoryTrackingBackground />
    <div class="absolute inset-0 bg-gradient-to-r from-fb-black/90 from-0% via-fb-black/55 via-55% to-fb-black/10" />
    <div class="absolute inset-0 bg-gradient-to-t from-fb-black via-transparent to-transparent" />

    <div class="container-fb relative flex min-h-[560px] flex-col justify-center py-20 md:min-h-[680px]">
      <div class="mb-5 flex items-center gap-3">
        <SectionIcon name="crate" class="h-6 w-6 text-fb-green-300" />
        <p class="eyebrow text-fb-green-300">Inventory Tracking</p>
      </div>
      <h1 class="max-w-2xl text-[2.5rem] font-semibold leading-[1.08] tracking-tight text-fb-white md:text-[3.2rem]">
        What's on hand, what's incoming, and what's already spoken for, in real time.
      </h1>
      <p class="mt-6 max-w-lg text-[1.05rem] leading-relaxed text-fb-white/65">
        No more reordering something you already have or promising stock you don't. Flowbound tracks every SKU
        across every channel continuously, so the number your team sees is the number that's actually true.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a
          href="#cta"
          class="inline-flex items-center bg-fb-green-500 px-6 py-3.5 font-body font-normal text-fb-white transition-colors hover:bg-fb-green-400"
        >
          Request a pilot
        </a>
        <a
          href="#how"
          class="inline-flex items-center border border-fb-white/25 px-6 py-3.5 font-body font-normal text-fb-white transition-colors hover:border-fb-white/60"
        >
          See how it works
        </a>
      </div>
    </div>
  </section>

  <section id="what" class="border-b border-fb-black/10 bg-fb-paper bg-grain py-20 md:py-28">
    <div class="container-fb">
      <div class="flex items-start justify-between gap-8">
        <div class="max-w-xl">
          <p class="eyebrow mb-4">What it is</p>
          <h2 class="text-[1.9rem] font-semibold leading-tight tracking-tight text-fb-black md:text-[2.2rem]">
            One live number for every SKU, not a spreadsheet from yesterday.
          </h2>
          <p class="mt-5 text-[0.98rem] leading-relaxed text-fb-black/65">
            Most small and mid-sized teams are tracking inventory across a warehouse system, a storefront, and
            a wholesale spreadsheet that all quietly disagree with each other. Flowbound keeps one live picture
            instead: what's actually on the shelf, what's already on its way, and what's already promised to
            an order, updated continuously instead of reconciled by hand at the end of the week.
          </p>
        </div>
        <SectionIcon name="crate" class="hidden h-[7.5rem] w-[7.5rem] shrink-0 text-fb-green-500/[14%] md:block" />
      </div>
    </div>
  </section>

  <section id="capabilities" class="border-b border-fb-black/10 bg-fb-white bg-grain py-20 md:py-28">
    <div class="container-fb">
      <div class="max-w-xl">
        <p class="eyebrow mb-4">What it does</p>
        <h2 class="text-[1.9rem] font-semibold leading-tight tracking-tight text-fb-black md:text-[2.2rem]">
          Built so the number you see is the number that's true.
        </h2>
      </div>

      <div
        data-glow-container
        data-glow-size={GLOW_SIZE}
        class="relative mt-14 grid grid-cols-1 gap-6 overflow-hidden md:grid-cols-3"
      >
        {capabilities.map((capability, i) => (
          <div class="group relative z-10 overflow-hidden border border-fb-black/10 bg-fb-white p-8 transition-all duration-500 ease-out hover:-translate-y-0.5 hover:border-fb-green-500/35 hover:bg-fb-green-50/50">
            <span class="font-mono text-sm text-fb-green-500">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="mt-3 text-[1.15rem] font-semibold leading-snug text-fb-black">{capability.title}</h3>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-fb-black/65">{capability.description}</p>
            <div class="absolute inset-x-0 bottom-0 h-0.5 origin-center scale-x-0 bg-fb-green-500 transition-transform duration-500 ease-out group-hover:scale-x-100" />
          </div>
        ))}

        <div
          data-glow
          aria-hidden="true"
          class="glow-cursor z-20 rounded-full mix-blend-multiply"
          style={`width: ${GLOW_SIZE}px; height: ${GLOW_SIZE}px; background: radial-gradient(circle, rgba(0,88,64,0.16), transparent 70%);`}
        />
      </div>
    </div>
  </section>

  <section id="signals" class="border-b border-fb-black/10 bg-fb-black py-20 md:py-28">
    <div class="container-fb">
      <div class="max-w-xl">
        <p class="eyebrow text-fb-green-300 mb-4">What it watches</p>
        <h2 class="text-[1.9rem] font-semibold leading-tight tracking-tight text-fb-white md:text-[2.2rem]">
          Every live input it keeps in sync, all the time.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-2">
        {signals.map((signal) => (
          <div class="flex items-start gap-3 border border-fb-white/15 bg-fb-white/5 px-5 py-4">
            <SectionIcon name="crate" class="mt-0.5 h-5 w-5 shrink-0 text-fb-green-400" />
            <span class="text-[0.98rem] leading-snug text-fb-white/80">{signal}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="how" class="border-b border-fb-black/10 bg-fb-white py-20 md:py-28">
    <div class="container-fb">
      <div class="max-w-xl">
        <p class="eyebrow mb-4">How it works</p>
        <h2 class="text-[1.9rem] font-semibold leading-tight tracking-tight text-fb-black md:text-[2.2rem]">
          From scattered systems to one number you can trust.
        </h2>
      </div>

      <div
        data-glow-container
        data-glow-size={GLOW_SIZE}
        class="relative mt-12 grid grid-cols-1 gap-6 overflow-hidden md:grid-cols-3"
      >
        {steps.map((s) => (
          <div class="group relative z-10 overflow-hidden border border-fb-green-400/30 bg-fb-green-50 p-8 transition-all duration-500 ease-out hover:-translate-y-0.5 hover:border-fb-green-500/40">
            <span class="font-mono text-sm text-fb-green-500">{s.n}</span>
            <h3 class="relative z-30 mt-3 text-[1.05rem] font-semibold leading-snug text-fb-black">{s.title}</h3>
            <p class="relative z-30 mt-3 text-[0.92rem] leading-relaxed text-fb-black">{s.body}</p>
            <div class="absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-fb-green-500 transition-transform duration-500 ease-out group-hover:scale-x-100" />
          </div>
        ))}

        <div
          data-glow
          aria-hidden="true"
          class="glow-cursor z-20 rounded-full mix-blend-screen"
          style={`width: ${GLOW_SIZE}px; height: ${GLOW_SIZE}px; background: radial-gradient(circle, rgba(255,255,255,0.55), transparent 70%);`}
        />
      </div>
    </div>
  </section>

  <Cta />
</BaseLayout>

<script>
  import "../scripts/hoverGlow"
</script>
