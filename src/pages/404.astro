---
import BaseLayout from "../layouts/BaseLayout.astro"
---

<BaseLayout title="Page not found | Flowbound" description="This page doesn't exist.">
  <section class="container-fb flex min-h-[50vh] flex-col items-center justify-center py-24 text-center">
    <p class="eyebrow mb-4">404</p>
    <h1 class="text-[1.9rem] font-semibold leading-tight tracking-tight text-fb-black md:text-[2.2rem]">
      We couldn't find that page.
    </h1>
    <p class="mt-4 max-w-md text-[1rem] leading-relaxed text-fb-black/65">
      The page you're looking for may have moved or no longer exists.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center bg-fb-green-500 px-6 py-3.5 font-body font-normal text-fb-white transition-colors hover:bg-fb-green-400"
    >
      Back to homepage
    </a>
  </section>
</BaseLayout>
