---
import BaseLayout from "../layouts/BaseLayout.astro"
import Cta from "../components/Cta.astro"
import ReorderBackground from "../components/ReorderBackground.astro"
import SectionIcon from "../components/icons/SectionIcon.astro"

const GLOW_SIZE = 420

const capabilities = [
  {
    title: "Fires the Moment the Reorder Point Hits",
    description:
      "Flowbound places the purchase order the instant your reorder point is crossed, not after someone checks a dashboard and remembers to click a button.",
  },
  {
    title: "Right Quantity, Every Time",
    description:
      "The order goes out at the quantity Flowbound already calculated from your demand forecast and lead times, not a round number someone guessed.",
  },
  {
    title: "Right Supplier, Automatically",
    description:
      "It reorders from the supplier it already recommended for that SKU, so a reorder never accidentally goes to the wrong vendor or the wrong price.",
  },
  {
    title: "Guardrails You Set, Not a Free-for-All",
    description:
      "You set the boundaries, budget caps, approval thresholds, preferred suppliers, and every autonomous reorder stays inside them.",
  },
  {
    title: "You Find Out After, Not Before",
    description:
      "Once you trust the call, Flowbound tells you what it ordered and why, instead of waiting for you to approve a purchase order it already knows is right.",
  },
  {
    title: "No Reorder Slips Through",
    description:
      "Because the trigger is automatic, a busy week or a missed alert can't quietly turn into a stockout.",
  },
]

const signals = [
  "Current stock level against the reorder point",
  "Open purchase orders already in transit",
  "Supplier lead times",
  "Demand forecast for the SKU",
  "Preferred supplier and backup options",
  "Budget and approval guardrails you've set",
  "Recent price or minimum order changes from the supplier",
  "Seasonal demand shifts",
]

const steps = [
  {
    n: "01",
    title: "It watches stock against the reorder point",
    body: "Every SKU's stock level is checked continuously against the reorder point Flowbound already calculated from demand and lead time.",
  },
  {
    n: "02",
    title: "It places the order inside your guardrails",
    body: "The moment the threshold is hit, Flowbound places the purchase order at the right quantity and supplier, within the budget and approval limits you set.",
  },
  {
    n: "03",
    title: "It tells you what happened and why",
    body: "You get a plain-language summary of what was ordered, from whom, and why, instead of a purchase order sitting in a queue waiting on a click.",
  },
]

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Reorder",
  applicationCategory: "BusinessApplication",
  description:
    "Flowbound places the purchase order the moment your reorder point is hit, at the quantity and supplier it already recommended, so restocking doesn't wait on someone opening their laptop.",
  audience: {
    "@type": "Audience",
    audienceType: "Small and mid-sized businesses",
  },
}
---

<BaseLayout
  title="Reorder | Flowbound"
  description="Flowbound places the purchase order the moment your reorder point is hit, at the quantity and supplier it already recommended, so restocking doesn't wait on someone opening their laptop."
  path="/reorder"
  schema={schema}
>
  <section class="relative min-h-[560px] overflow-hidden bg-fb-black md:min-h-[680px]">
    <ReorderBackground />
    <div class="absolute inset-0 bg-gradient-to-r from-fb-black/90 from-0% via-fb-black/55 via-55% to-fb-black/10" />
    <div class="absolute inset-0 bg-gradient-to-t from-fb-black via-transparent to-transparent" />

    <div class="container-fb relative flex min-h-[560px] flex-col justify-center py-20 md:min-h-[680px]">
      <div class="mb-5 flex items-center gap-3">
        <SectionIcon name="bolt" class="h-6 w-6 text-fb-green-300" />
        <p class="eyebrow text-fb-green-300">Reorder</p>
      </div>
      <h1 class="max-w-2xl text-[2.5rem] font-semibold leading-[1.08] tracking-tight text-fb-white md:text-[3.2rem]">
        The reorder goes out the moment it's needed, not when someone gets to it.
      </h1>
      <p class="mt-6 max-w-lg text-[1.05rem] leading-relaxed text-fb-white/65">
        Flowbound places the purchase order the moment your reorder point is hit, at the quantity and supplier
        it already recommended, so restocking doesn't wait on someone opening their laptop.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a
          href="#cta"
          class="inline-flex items-center bg-fb-green-500 px-6 py-3.5 font-body font-normal text-fb-white transition-colors hover:bg-fb-green-400"
        >
          Request a pilot
        </a>
        <a
          href="#how"
          class="inline-flex items-center border border-fb-white/25 px-6 py-3.5 font-body font-normal text-fb-white transition-colors hover:border-fb-white/60"
        >
          See how it works
        </a>
      </div>
    </div>
  </section>

  <section id="what" class="border-b border-fb-black/10 bg-fb-paper bg-grain py-20 md:py-28">
    <div class="container-fb">
      <div class="flex items-start justify-between gap-8">
        <div class="max-w-xl">
          <p class="eyebrow mb-4">What it is</p>
          <h2 class="text-[1.9rem] font-semibold leading-tight tracking-tight text-fb-black md:text-[2.2rem]">
            The purchase order that doesn't wait for someone to open their laptop.
          </h2>
          <p class="mt-5 text-[0.98rem] leading-relaxed text-fb-black/65">
            Most reorder systems tell you a SKU is running low and wait for someone to act on it. Flowbound
            goes a step further: once you trust the call, it places the purchase order itself, at the
            quantity and supplier it already recommended, the moment the reorder point is hit. Nothing sits
            in a queue waiting for a click.
          </p>
        </div>
        <SectionIcon name="bolt" class="hidden h-[7.5rem] w-[7.5rem] shrink-0 text-fb-green-500/[14%] md:block" />
      </div>
    </div>
  </section>

  <section id="capabilities" class="border-b border-fb-black/10 bg-fb-white bg-grain py-20 md:py-28">
    <div class="container-fb">
      <div class="max-w-xl">
        <p class="eyebrow mb-4">What it does</p>
        <h2 class="text-[1.9rem] font-semibold leading-tight tracking-tight text-fb-black md:text-[2.2rem]">
          Built so a stockout never comes down to who checked the dashboard.
        </h2>
      </div>

      <div
        data-glow-container
        data-glow-size={GLOW_SIZE}
        class="relative mt-14 grid grid-cols-1 gap-6 overflow-hidden md:grid-cols-3"
      >
        {capabilities.map((capability, i) => (
          <div class="group relative z-10 overflow-hidden border border-fb-black/10 bg-fb-white p-8 transition-all duration-500 ease-out hover:-translate-y-0.5 hover:border-fb-green-500/35 hover:bg-fb-green-50/50">
            <span class="font-mono text-sm text-fb-green-500">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="mt-3 text-[1.15rem] font-semibold leading-snug text-fb-black">{capability.title}</h3>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-fb-black/65">{capability.description}</p>
            <div class="absolute inset-x-0 bottom-0 h-0.5 origin-center scale-x-0 bg-fb-green-500 transition-transform duration-500 ease-out group-hover:scale-x-100" />
          </div>
        ))}

        <div
          data-glow
          aria-hidden="true"
          class="glow-cursor z-20 rounded-full mix-blend-multiply"
          style={`width: ${GLOW_SIZE}px; height: ${GLOW_SIZE}px; background: radial-gradient(circle, rgba(0,88,64,0.16), transparent 70%);`}
        />
      </div>
    </div>
  </section>

  <section id="signals" class="border-b border-fb-black/10 bg-fb-black py-20 md:py-28">
    <div class="container-fb">
      <div class="max-w-xl">
        <p class="eyebrow text-fb-green-300 mb-4">What it watches</p>
        <h2 class="text-[1.9rem] font-semibold leading-tight tracking-tight text-fb-white md:text-[2.2rem]">
          Everything that has to line up before an order goes out on its own.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-2">
        {signals.map((signal) => (
          <div class="flex items-start gap-3 border border-fb-white/15 bg-fb-white/5 px-5 py-4">
            <SectionIcon name="bolt" class="mt-0.5 h-5 w-5 shrink-0 text-fb-green-400" />
            <span class="text-[0.98rem] leading-snug text-fb-white/80">{signal}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="how" class="border-b border-fb-black/10 bg-fb-white py-20 md:py-28">
    <div class="container-fb">
      <div class="max-w-xl">
        <p class="eyebrow mb-4">How it works</p>
        <h2 class="text-[1.9rem] font-semibold leading-tight tracking-tight text-fb-black md:text-[2.2rem]">
          From a stock level to a placed order, without a person in between.
        </h2>
      </div>

      <div
        data-glow-container
        data-glow-size={GLOW_SIZE}
        class="relative mt-12 grid grid-cols-1 gap-6 overflow-hidden md:grid-cols-3"
      >
        {steps.map((s) => (
          <div class="group relative z-10 overflow-hidden border border-fb-green-400/30 bg-fb-green-50 p-8 transition-all duration-500 ease-out hover:-translate-y-0.5 hover:border-fb-green-500/40">
            <span class="font-mono text-sm text-fb-green-500">{s.n}</span>
            <h3 class="relative z-30 mt-3 text-[1.05rem] font-semibold leading-snug text-fb-black">{s.title}</h3>
            <p class="relative z-30 mt-3 text-[0.92rem] leading-relaxed text-fb-black">{s.body}</p>
            <div class="absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-fb-green-500 transition-transform duration-500 ease-out group-hover:scale-x-100" />
          </div>
        ))}

        <div
          data-glow
          aria-hidden="true"
          class="glow-cursor z-20 rounded-full mix-blend-screen"
          style={`width: ${GLOW_SIZE}px; height: ${GLOW_SIZE}px; background: radial-gradient(circle, rgba(255,255,255,0.55), transparent 70%);`}
        />
      </div>
    </div>
  </section>

  <Cta />
</BaseLayout>

<script>
  import "../scripts/hoverGlow"
</script>
