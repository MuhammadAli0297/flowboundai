---
// Hot Sauce rebuild, checklist item 3: the first capability-template page (see CLAUDE.md). Follows
// the approved mockup's capability-hero (stills 06), stacked-bento "what it does" (still 07), and
// real FAQ accordion (still 08), extended with "what it is"/"what it watches"/"how it works"
// sections the mockup didn't render as stills but the existing six-section template already needs.
// Items 4-9 (the other six capability pages) share this exact template, so once this one is
// approved the rest should move fast.
import BaseLayout from "../layouts/BaseLayout.astro"
import Cta from "../components/Cta.astro"
import SectionIcon from "../components/icons/SectionIcon.astro"
import Breadcrumbs from "../components/Breadcrumbs.astro"
import { buildBreadcrumbSchema } from "../lib/breadcrumbs"

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Services", path: "/services" },
  { name: "Reorder", path: "/reorder" },
]
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbItems, Astro.site!)

// Signal Primitives merge: the hero used to end at the CTA row with the whole right side empty,
// the one deliberate exception sitewide to the "glass panel with real-looking product UI" hero
// convention, on the reasoning that a capability page explains one thing rather than showcasing
// the whole product. Flagged directly as "just so plain," fixed by giving the hero a glass panel
// like every other page's. First attempt reused the homepage's generic live-data-rows template
// verbatim (different copy, identical structure), which was then flagged as reading like the same
// image as the homepage hero at a glance. Fixed by making the hero panel BE this page's own Stock
// Gauge widget instead, moved up from "what it watches" (which goes back to a plain signal list)
// so it isn't shown twice.

const capabilities = [
  {
    title: "Fires the Moment the Reorder Point Hits",
    description:
      "Flowbound places the purchase order the instant your reorder point is crossed, not after someone checks a dashboard and remembers to click a button.",
  },
  {
    title: "Right Quantity, Every Time",
    description:
      "The order goes out at the quantity Flowbound already calculated from your demand forecast and lead times, not a round number someone guessed.",
  },
  {
    title: "Right Supplier, Automatically",
    description:
      "It reorders from the supplier it already recommended for that SKU, so a reorder never accidentally goes to the wrong vendor or the wrong price.",
  },
  {
    title: "Guardrails You Set, Not a Free-for-All",
    description:
      "You set the boundaries, budget caps, approval thresholds, preferred suppliers, and every autonomous reorder stays inside them.",
  },
  {
    title: "You Find Out After, Not Before",
    description:
      "Once you trust the call, Flowbound tells you what it ordered and why, instead of waiting for you to approve a purchase order it already knows is right.",
  },
  {
    title: "No Reorder Slips Through",
    description:
      "Because the trigger is automatic, a busy week or a missed alert can't quietly turn into a stockout.",
  },
]

const signals = [
  "Current stock level against the reorder point",
  "Open purchase orders already in transit",
  "Supplier lead times",
  "Demand forecast for the SKU",
  "Preferred supplier and backup options",
  "Budget and approval guardrails you've set",
  "Recent price or minimum order changes from the supplier",
  "Seasonal demand shifts",
]

const steps = [
  {
    n: "01",
    title: "It watches stock against the reorder point",
    body: "Every SKU's stock level is checked continuously against the reorder point Flowbound already calculated from demand and lead time.",
  },
  {
    n: "02",
    title: "It places the order inside your guardrails",
    body: "The moment the threshold is hit, Flowbound places the purchase order at the right quantity and supplier, within the budget and approval limits you set.",
  },
  {
    n: "03",
    title: "It tells you what happened and why",
    body: "You get a plain-language summary of what was ordered, from whom, and why, instead of a purchase order sitting in a queue waiting on a click.",
  },
]

const faqs = [
  {
    question: "What actually triggers a reorder?",
    answer:
      "The reorder point itself, calculated from your demand forecast and each supplier's lead time. The instant your stock crosses it, Flowbound places the order, it doesn't wait for someone to check a dashboard first.",
  },
  {
    question: "Can I limit what Flowbound is allowed to order on its own?",
    answer:
      "Yes. You set the budget caps, approval thresholds, and preferred suppliers, and every autonomous reorder stays inside those guardrails. It's not a free-for-all.",
  },
  {
    question: "Does it always reorder from the same supplier?",
    answer:
      "It reorders from the supplier it already recommended for that SKU, so an order never accidentally goes out to the wrong vendor or at the wrong price.",
  },
  {
    question: "What happens after Flowbound places an order automatically?",
    answer:
      "Once you trust the call, Flowbound tells you what it ordered and why afterward, instead of holding a purchase order in a queue waiting on your approval.",
  },
]

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
}

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Reorder",
  name: "Reorder",
  description:
    "Flowbound places the purchase order the moment your reorder point is hit, at the quantity and supplier it already recommended, so restocking doesn't wait on someone opening their laptop.",
  provider: { "@type": "Organization", name: "Flowbound" },
  audience: {
    "@type": "Audience",
    audienceType: "Small and mid-sized businesses",
  },
}
---

<BaseLayout
  title="Automated Reorder Point Software | Flowbound"
  description="Flowbound places the purchase order the moment your reorder point is hit, at the quantity and supplier already recommended. Restocking doesn't wait on you."
  path="/reorder"
  schema={[schema, faqSchema, breadcrumbSchema]}
>
  <section id="top" class="relative overflow-hidden bg-bold-paper py-24 pt-28 font-hanken md:py-32 md:pt-36">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <!-- Same hero grammar as the homepage (grain + orb), deliberately quieter per the approved
         mockup: one orb instead of two, no glass panel, since this page's job is to explain one
         capability well, not showcase the whole product. Purple per direct feedback (was mint).
         Not literal `ink` (#2E1630): at any opacity low enough to read as a soft blurred glow
         rather than a hard shape, ink's near-black lightness (~14%) just desaturates to gray
         against bold-paper, confirmed by testing it directly up to 32% opacity. #C998CD is ink's
         own hue (~295°) lifted to a glow-friendly ~70% lightness, same saturation, so it reads as
         a real soft purple wash instead of gray. -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <span class="bold-orb" style="width:19rem;height:19rem;top:-6rem;right:-3rem;background:#8FE3D3;opacity:0.3;" />
      <span class="bold-orb" style="width:15rem;height:15rem;top:4rem;right:13rem;background:#C998CD;opacity:0.26;" />
    </div>

    <div class="container-fb relative">
      <Breadcrumbs items={breadcrumbItems} />

      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-10">
        <div>
          <div data-reveal class="reveal-item mb-5 flex items-center gap-3">
            <SectionIcon name="bolt" class="h-6 w-6 text-bold-mint-deep" />
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">Reorder</p>
          </div>
          <h1 data-reveal class="font-hanken reveal-item max-w-2xl text-[2.5rem] font-bold leading-[1.08] tracking-tighter text-bold-ink md:text-[3.2rem]" style="transition-delay: 60ms">
            The reorder goes out the moment it's needed, not when someone gets to <em class="font-instrument font-normal italic text-bold-mint-deep">it</em>.
          </h1>
          <p data-reveal class="reveal-item mt-6 max-w-lg text-[1.05rem] font-normal leading-relaxed text-bold-ink/70" style="transition-delay: 120ms">
            Flowbound places the purchase order the moment your reorder point is hit, at the quantity and supplier
            it already recommended, so restocking doesn't wait on someone opening their laptop.
          </p>
          <div data-reveal class="reveal-item mt-9 flex flex-wrap items-center gap-4" style="transition-delay: 180ms">
            <a
              href="#cta"
              data-magnetic
              class="bold-btn bold-btn-primary bold-btn-md group"
            >
              <span class="relative z-10">Request a pilot</span>
              <span aria-hidden="true" class="relative z-10 transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
            </a>
            <a
              href="#how"
              data-magnetic
              class="bold-btn bold-btn-secondary bold-btn-md group"
            >
              <span class="relative z-10">See how it works</span>
              <span aria-hidden="true" class="relative z-10 transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
            </a>
          </div>
        </div>

        <div data-reveal class="reveal-item bold-glass rounded-2xl p-5" style="transition-delay: 240ms" id="reorder-gauge">
          <div class="mb-3.5 flex items-center justify-between font-mono text-xs uppercase tracking-[0.05em] text-bold-taupe">
            <span class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-bold-mint-deep" aria-hidden="true" />
              Live &middot; SKU&ndash;4471
            </span>
            <span>Reorder point</span>
          </div>
          <svg viewBox="0 0 120 70" class="w-full" aria-hidden="true">
            <path class="gauge-track" d="M10,65 A55,55 0 0 1 110,65"></path>
            <path id="reorderGaugeFill" class="gauge-fill" d="M10,65 A55,55 0 0 1 110,65"></path>
            <line x1="27" y1="22" x2="33" y2="30" class="gauge-threshold"></line>
          </svg>
          <div class="mt-1 flex items-end justify-between">
            <span id="reorderGaugeNum" class="text-[1.9rem] font-bold text-bold-ink">92%</span>
            <span id="reorderGaugeBadge" class="rounded-full bg-bold-mint-deep px-2.5 py-0.5 font-mono text-xs font-bold text-bold-paper opacity-0 transition-opacity duration-300">Triggered</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="what" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <span class="what-ambient-blob"></span>
    </div>
    <div class="container-fb relative">
      <div class="flex items-start justify-between gap-8">
        <div class="reveal-item max-w-xl" data-reveal>
          <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">What it is</p>
          <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
            The purchase order that doesn't wait for someone to open their laptop.
          </h2>
          <p class="mt-5 text-[0.98rem] font-normal leading-relaxed text-bold-ink/70">
            Most reorder systems tell you a SKU is running low and wait for someone to act on it. Flowbound
            goes a step further: once you trust the call, it places the purchase order itself, at the
            quantity and supplier it already recommended, the moment the reorder point is hit. Nothing sits
            in a queue waiting for a click.
          </p>
        </div>
        <div class="relative hidden shrink-0 md:block" data-icon-drift>
          <span class="icon-pulse-ring absolute inset-0 rounded-full border border-bold-ink/15" aria-hidden="true"></span>
          <SectionIcon name="bolt" class="icon-spin relative h-[7.5rem] w-[7.5rem] text-bold-ink/20" />
        </div>
      </div>
    </div>
  </section>

  <section id="capabilities" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">What it does</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
          Built so a stockout never comes down to who checked the dashboard.
        </h2>
      </div>

      <!-- Same "give one item real weight" bento idea as the homepage's capability grid, but a
           full-width lead tile plus a naturally-sized grid for the rest rather than a fixed-row
           span: this page's capability copy runs noticeably longer and more variable in length
           than the homepage bento's short lines, and a fixed auto-rows height (tried first, same
           as the homepage bento) overflowed on three of the five small tiles once body copy wrapped
           past 3 lines on a narrow column. Letting each tile size to its own content can't overflow
           regardless of how long a future capability's copy runs. -->
      <div class="mt-12 grid grid-cols-1 gap-3.5">
        <div data-reveal class="reveal-item">
          <div data-tilt class="tilt-card bold-tile-feature bold-glass rounded-2xl p-7 md:p-8">
            <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-bold-ink font-mono text-[0.65rem] font-bold text-bold-paper">01</span>
            <h3 class="font-hanken mt-3 text-[1.15rem] font-semibold text-bold-ink">{capabilities[0].title}</h3>
            <p class="mt-2 max-w-2xl text-[0.92rem] leading-relaxed text-bold-ink/65">{capabilities[0].description}</p>
          </div>
        </div>
        <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2 md:grid-cols-3">
          {capabilities.slice(1).map((capability, i) => (
            <div
              data-reveal
              class="reveal-item h-full rounded-2xl border border-bold-ink/8 bg-bold-paper p-6 transition-colors duration-300 hover:border-bold-ink/25 hover:bg-bold-ink/[0.04]"
              style={`transition-delay: ${(i + 1) * 70}ms`}
            >
              <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-bold-ink font-mono text-[0.65rem] font-bold text-bold-paper">{String(i + 2).padStart(2, "0")}</span>
              <h3 class="font-hanken mt-3 text-[0.95rem] font-semibold text-bold-ink">{capability.title}</h3>
              <p class="mt-2 text-[0.85rem] leading-relaxed text-bold-ink/65">{capability.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="signals" class="bold-depth-ink relative overflow-hidden py-20 font-hanken md:py-28">
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-mint">What it watches</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-paper md:text-[2.2rem]">
          Everything that has to line up before an order goes out on its own.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-2">
        {signals.map((signal, i) => (
          <div
            data-reveal
            class="reveal-item flex items-start gap-3 border border-bold-paper/15 bg-bold-paper/5 px-5 py-4"
            style={`transition-delay: ${(i % 4) * 70}ms`}
          >
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-bold-mint" aria-hidden="true" />
            <span class="text-[0.98rem] leading-snug text-bold-paper/80">{signal}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="how" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <span class="how-ambient-blob"></span>
    </div>
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">How it works</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
          From a stock level to a placed order, without a person in between.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-3">
        {steps.map((s, i) => (
          <div
            data-reveal
            class="reveal-item h-full rounded-2xl border border-bold-ink/10 bg-bold-paper p-7 transition-colors duration-300 hover:border-bold-ink/25 hover:bg-bold-ink/[0.04]"
            style={`transition-delay: ${i * 90}ms`}
          >
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-bold-ink font-mono text-xs font-bold text-bold-paper">{s.n}</span>
            <h3 class="font-hanken mt-3 text-[1.05rem] font-medium leading-snug text-bold-ink">{s.title}</h3>
            <p class="mt-3 text-[0.92rem] font-normal leading-relaxed text-bold-ink/65">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="faq" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">FAQ</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
          Straight answers about how the automatic reorder actually behaves.
        </h2>
      </div>

      <div data-reveal class="reveal-item mt-12 overflow-hidden rounded-2xl border border-bold-ink/10 bg-bold-paper shadow-[0_24px_48px_-30px_rgba(46,22,48,0.25)]" data-faq-list style="transition-delay: 100ms">
        {faqs.map((faq, i) => (
          <>
            <button
              type="button"
              class={`bold-faq-row flex w-full items-center justify-between gap-6 px-7 py-6 text-left hover:bg-bold-ink/[0.025] ${i > 0 ? "border-t border-bold-ink/10" : ""}`}
              aria-expanded={i === 0 ? "true" : "false"}
              aria-controls={`faq-answer-${i}`}
            >
              <span class="text-[0.98rem] font-semibold text-bold-ink">{faq.question}</span>
              <span class="bold-faq-chevron-ring flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-bold-ink/10">
                <svg class="bold-faq-chevron h-4 w-4 text-bold-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </span>
            </button>
            <div id={`faq-answer-${i}`} class="bold-faq-panel" aria-hidden={i === 0 ? "false" : "true"}>
              <div class="px-7">
                <p class="max-w-2xl text-[0.92rem] font-normal leading-relaxed text-bold-ink/65">{faq.answer}</p>
              </div>
            </div>
          </>
        ))}
      </div>
    </div>
  </section>

  <Cta />
</BaseLayout>

<style>
  .what-ambient-blob {
    position: absolute;
    top: -10%;
    right: -6%;
    width: 28vw;
    height: 28vw;
    max-width: 380px;
    max-height: 380px;
    border-radius: 9999px;
    filter: blur(80px);
    background: radial-gradient(circle, rgba(110, 156, 163, 0.16) 0%, transparent 70%);
  }

  .how-ambient-blob {
    position: absolute;
    bottom: -15%;
    left: -6%;
    width: 28vw;
    height: 28vw;
    max-width: 380px;
    max-height: 380px;
    border-radius: 9999px;
    filter: blur(80px);
    background: radial-gradient(circle, rgba(110, 156, 163, 0.14) 0%, transparent 70%);
  }
</style>

<script>
  import "../scripts/scrollReveal"
  import "../scripts/sectionIconDrift"
  import "../scripts/faqAccordion"
  import "../scripts/cardTilt"
  import "../scripts/magneticButton"
  import "../scripts/reorderGauge"
</script>
