---
// Hot Sauce rebuild, checklist item 8: the sixth capability-template page, following
// /supplier-coordination's approved shape exactly (see CLAUDE.md "Checkpoint 3" and the Signal
// Primitives merge notes): grain+orb hero whose glass panel IS this page's assigned widget
// (Account Ladder), "what it is" with an icon-drift watermark, "what it does" as one featured
// glass+gradient-ring tile plus a quiet ink-tint grid, "what it watches" as a plain signal list
// on a bold-depth-ink dark section, "how it works" as plain quiet tiles, and the luxurious
// .bold-faq-row/.bold-faq-panel accordion. All copy/schema content carried over unchanged from
// the prior ocean-palette build, it was already accurate, only the visual system and the
// widget/glass-panel additions are new.
import BaseLayout from "../layouts/BaseLayout.astro"
import Cta from "../components/Cta.astro"
import SectionIcon from "../components/icons/SectionIcon.astro"
import Breadcrumbs from "../components/Breadcrumbs.astro"
import { buildBreadcrumbSchema } from "../lib/breadcrumbs"

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Services", path: "/services" },
  { name: "Wholesale Account Management", path: "/wholesale-account-management" },
]
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbItems, Astro.site!)

// The hero's Account Ladder widget: 4 pricing tiers, DOM order Tier 1 to Tier 4 (bottom to top
// visually, see the .ladder-widget CSS note). This account sits at Tier 3, matching
// accountLadder.ts's REACHED_INDEX = 2.
const tiers = [
  { label: "Tier 1", value: "Up to $3k/mo" },
  { label: "Tier 2", value: "$3k–$8k/mo" },
  { label: "Tier 3", value: "$8k–$15k/mo" },
  { label: "Tier 4", value: "$15k+/mo" },
]

const capabilities = [
  {
    title: "Pricing Tiers Tracked Per Account",
    description:
      "Every wholesale account keeps its own pricing tier on record, so a reorder never accidentally goes out at the wrong rate.",
  },
  {
    title: "Order Minimums Enforced Automatically",
    description:
      "Minimum order quantities and dollar thresholds are checked before an order goes out, not caught after a customer calls to ask why it was rejected.",
  },
  {
    title: "Standing Agreements Stay Current",
    description:
      "Contract terms, renewal dates, and special conditions live with the account itself, so nobody has to dig up the original agreement to confirm a detail.",
  },
  {
    title: "One Record Per Wholesale Account",
    description:
      "Pricing, terms, order history, and contact details for an account live in one place, instead of split across a contract folder and a spreadsheet.",
  },
  {
    title: "Flags Terms That Need a Refresh",
    description:
      "An agreement approaching renewal or a tier that no longer matches actual order volume gets surfaced, so terms don't go stale without anyone noticing.",
  },
  {
    title: "Consistent Terms, Every Time",
    description:
      "Whoever processes the order, the account's actual terms are what goes out, removing the guesswork of double-checking a contract each time.",
  },
]

const signals = [
  "Pricing tier per wholesale account",
  "Order minimums and quantity breaks",
  "Standing agreement terms and renewal dates",
  "Order history against agreed terms",
  "Account-specific shipping or payment terms",
  "Volume trends against current tier",
  "Contract exceptions and special conditions",
  "Account contact and billing details",
]

const steps = [
  {
    n: "01",
    title: "It keeps the account's terms on record",
    body: "Pricing tier, order minimums, and standing agreement details are attached to the account itself, not filed away in a separate contract.",
  },
  {
    n: "02",
    title: "It checks every order against those terms",
    body: "Before an order goes out, it's checked against the account's actual pricing and minimums, so the terms applied are always the right ones.",
  },
  {
    n: "03",
    title: "It flags what's due for a second look",
    body: "An agreement nearing renewal or a tier that no longer fits actual volume gets flagged, so terms stay current instead of going stale.",
  },
]

const faqs = [
  {
    question: "What does Flowbound actually track for a wholesale account?",
    answer:
      "Pricing tier, order minimums, and standing agreement terms, all attached to the account itself instead of split across a contract folder and a spreadsheet.",
  },
  {
    question: "Does it stop an order that doesn't meet the account's minimum?",
    answer:
      "Order minimums and dollar thresholds are checked before the order goes out, not caught after a customer calls to ask why it was rejected.",
  },
  {
    question: "What happens when an agreement is close to renewal?",
    answer:
      "Flowbound flags it, along with any pricing tier that no longer matches the account's actual order volume, so terms don't go stale without anyone noticing.",
  },
  {
    question: "Does every team member apply the same terms to an order?",
    answer:
      "Yes. Whoever processes the order, the account's actual terms are what goes out, so nobody has to double-check the contract from memory.",
  },
]

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
}

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Wholesale Account Management",
  name: "Wholesale Account Management",
  description:
    "Flowbound's wholesale account management service tracks pricing tiers, order minimums, and standing wholesale agreements per account, so every reorder goes out at the right terms.",
  provider: { "@type": "Organization", name: "Flowbound" },
  audience: {
    "@type": "Audience",
    audienceType: "Small and mid-sized businesses",
  },
}
---

<BaseLayout
  title="Wholesale Account Management Software | Flowbound"
  description="Flowbound tracks pricing tiers, order minimums, and standing agreements per wholesale account, so every reorder goes out at the right terms automatically."
  path="/wholesale-account-management"
  schema={[schema, faqSchema, breadcrumbSchema]}
>
  <section id="top" class="relative overflow-hidden bg-bold-paper py-24 pt-28 font-hanken md:py-32 md:pt-36">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <span class="bold-orb" style="width:20rem;height:20rem;top:-6rem;right:-5rem;background:#8FE3D3;opacity:0.31;" />
      <span class="bold-orb" style="width:16rem;height:16rem;top:7rem;right:18rem;background:#C998CD;opacity:0.26;" />
    </div>

    <div class="container-fb relative">
      <Breadcrumbs items={breadcrumbItems} />

      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-10">
        <div>
          <div data-reveal class="reveal-item mb-5 flex items-center gap-3">
            <SectionIcon name="network" class="h-6 w-6 text-bold-mint-deep" />
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">Wholesale Account Management</p>
          </div>
          <h1 data-reveal class="font-hanken reveal-item max-w-2xl text-[2.5rem] font-bold leading-[1.08] tracking-tighter text-bold-ink md:text-[3.2rem]" style="transition-delay: 60ms">
            Every wholesale account, on the right terms, <em class="font-instrument font-normal italic text-bold-mint-deep">every time</em>.
          </h1>
          <p data-reveal class="reveal-item mt-6 max-w-lg text-[1.05rem] font-normal leading-relaxed text-bold-ink/70" style="transition-delay: 120ms">
            Track pricing tiers, order minimums, and standing wholesale agreements per account, so every
            reorder goes out at the right terms without you having to double check the contract each time.
          </p>
          <div data-reveal class="reveal-item mt-9 flex flex-wrap items-center gap-4" style="transition-delay: 180ms">
            <a
              href="#cta"
              data-magnetic
              class="bold-btn bold-btn-primary bold-btn-md group"
            >
              <span class="relative z-10">Request a pilot</span>
              <span aria-hidden="true" class="relative z-10 transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
            </a>
            <a
              href="#how"
              data-magnetic
              class="bold-btn bold-btn-secondary bold-btn-md group"
            >
              <span class="relative z-10">See how it works</span>
              <span aria-hidden="true" class="relative z-10 transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
            </a>
          </div>
        </div>

        <div data-reveal class="reveal-item bold-glass rounded-2xl p-5" style="transition-delay: 240ms">
          <div class="mb-3.5 flex items-center justify-between font-mono text-xs uppercase tracking-[0.05em] text-bold-taupe">
            <span class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-bold-mint-deep" aria-hidden="true" />
              Live &middot; Acme Wholesale
            </span>
            <span>Account tier</span>
          </div>
          <div id="ladderWidget" class="ladder-widget px-1 py-2" aria-hidden="true">
            <span id="ladderTrack" class="ladder-track" />
            <span id="ladderFill" class="ladder-fill" />
            {tiers.map((tier, i) => (
              <div class="ladder-rung" style={`--step: ${i}`}>
                <span class="ladder-dot" />
                <span class="ladder-rung-label">{tier.label} <span class="ladder-rung-value">&middot; {tier.value}</span></span>
              </div>
            ))}
          </div>
          <div class="mt-3 flex items-end justify-between">
            <span class="text-[1.05rem] font-bold text-bold-ink">Acme Wholesale<span class="ml-1.5 text-[0.85rem] font-normal text-bold-ink/50">&middot; Tier 3</span></span>
            <span id="ladderBadge" class="rounded-full bg-bold-mint-deep px-2.5 py-0.5 font-mono text-xs font-bold text-bold-paper opacity-0 transition-opacity duration-300">Terms applied</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="what" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <span class="what-ambient-blob"></span>
    </div>
    <div class="container-fb relative">
      <div class="flex items-start justify-between gap-8">
        <div class="reveal-item max-w-xl" data-reveal>
          <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">What it is</p>
          <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
            The contract's terms, attached to the account, not buried in a folder.
          </h2>
          <p class="mt-5 text-[0.98rem] font-normal leading-relaxed text-bold-ink/70">
            Wholesale terms tend to live in whatever contract was signed and then get double-checked from
            memory every time an order comes in. Flowbound keeps every account's pricing tier, order
            minimums, and standing agreement details on record and applies them automatically, so the right
            terms go out without anyone having to go dig up the original paperwork.
          </p>
        </div>
        <div class="relative hidden shrink-0 md:block" data-icon-drift>
          <span class="icon-pulse-ring absolute inset-0 rounded-full border border-bold-ink/15" aria-hidden="true"></span>
          <SectionIcon name="network" class="icon-spin relative h-[7.5rem] w-[7.5rem] text-bold-ink/20" />
        </div>
      </div>
    </div>
  </section>

  <section id="capabilities" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">What it does</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
          Built so every account gets the terms it actually agreed to.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-3.5">
        <div data-reveal class="reveal-item">
          <div data-tilt class="tilt-card bold-tile-feature bold-glass rounded-2xl p-7 md:p-8">
            <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-bold-ink font-mono text-[0.65rem] font-bold text-bold-paper">01</span>
            <h3 class="font-hanken mt-3 text-[1.15rem] font-semibold text-bold-ink">{capabilities[0].title}</h3>
            <p class="mt-2 max-w-2xl text-[0.92rem] leading-relaxed text-bold-ink/65">{capabilities[0].description}</p>
          </div>
        </div>
        <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2 md:grid-cols-3">
          {capabilities.slice(1).map((capability, i) => (
            <div
              data-reveal
              class="reveal-item h-full rounded-2xl border border-bold-ink/8 bg-bold-paper p-6 transition-colors duration-300 hover:border-bold-ink/25 hover:bg-bold-ink/[0.04]"
              style={`transition-delay: ${(i + 1) * 70}ms`}
            >
              <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-bold-ink font-mono text-[0.65rem] font-bold text-bold-paper">{String(i + 2).padStart(2, "0")}</span>
              <h3 class="font-hanken mt-3 text-[0.95rem] font-semibold text-bold-ink">{capability.title}</h3>
              <p class="mt-2 text-[0.85rem] leading-relaxed text-bold-ink/65">{capability.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="signals" class="bold-depth-ink relative overflow-hidden py-20 font-hanken md:py-28">
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-mint">What it watches</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-paper md:text-[2.2rem]">
          Every term that goes into a wholesale order, kept current.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-2">
        {signals.map((signal, i) => (
          <div
            data-reveal
            class="reveal-item flex items-start gap-3 border border-bold-paper/15 bg-bold-paper/5 px-5 py-4"
            style={`transition-delay: ${(i % 4) * 70}ms`}
          >
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-bold-mint" aria-hidden="true" />
            <span class="text-[0.98rem] leading-snug text-bold-paper/80">{signal}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="how" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <span class="how-ambient-blob"></span>
    </div>
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">How it works</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
          From a signed contract to the terms on every order.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-3">
        {steps.map((s, i) => (
          <div
            data-reveal
            class="reveal-item h-full rounded-2xl border border-bold-ink/10 bg-bold-paper p-7 transition-colors duration-300 hover:border-bold-ink/25 hover:bg-bold-ink/[0.04]"
            style={`transition-delay: ${i * 90}ms`}
          >
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-bold-ink font-mono text-xs font-bold text-bold-paper">{s.n}</span>
            <h3 class="font-hanken mt-3 text-[1.05rem] font-medium leading-snug text-bold-ink">{s.title}</h3>
            <p class="mt-3 text-[0.92rem] font-normal leading-relaxed text-bold-ink/65">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="faq" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">FAQ</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
          Straight answers about how account terms are actually applied.
        </h2>
      </div>

      <div data-reveal class="reveal-item mt-12 overflow-hidden rounded-2xl border border-bold-ink/10 bg-bold-paper shadow-[0_24px_48px_-30px_rgba(46,22,48,0.25)]" data-faq-list style="transition-delay: 100ms">
        {faqs.map((faq, i) => (
          <>
            <button
              type="button"
              class={`bold-faq-row flex w-full items-center justify-between gap-6 px-7 py-6 text-left hover:bg-bold-ink/[0.025] ${i > 0 ? "border-t border-bold-ink/10" : ""}`}
              aria-expanded={i === 0 ? "true" : "false"}
              aria-controls={`faq-answer-${i}`}
            >
              <span class="text-[0.98rem] font-semibold text-bold-ink">{faq.question}</span>
              <span class="bold-faq-chevron-ring flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-bold-ink/10">
                <svg class="bold-faq-chevron h-4 w-4 text-bold-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </span>
            </button>
            <div id={`faq-answer-${i}`} class="bold-faq-panel" aria-hidden={i === 0 ? "false" : "true"}>
              <div class="px-7">
                <p class="max-w-2xl text-[0.92rem] font-normal leading-relaxed text-bold-ink/65">{faq.answer}</p>
              </div>
            </div>
          </>
        ))}
      </div>
    </div>
  </section>

  <Cta />
</BaseLayout>

<style>
  .what-ambient-blob {
    position: absolute;
    top: -10%;
    right: -6%;
    width: 28vw;
    height: 28vw;
    max-width: 380px;
    max-height: 380px;
    border-radius: 9999px;
    filter: blur(80px);
    background: radial-gradient(circle, rgba(110, 156, 163, 0.16) 0%, transparent 70%);
  }

  .how-ambient-blob {
    position: absolute;
    bottom: -15%;
    left: -6%;
    width: 28vw;
    height: 28vw;
    max-width: 380px;
    max-height: 380px;
    border-radius: 9999px;
    filter: blur(80px);
    background: radial-gradient(circle, rgba(110, 156, 163, 0.14) 0%, transparent 70%);
  }
</style>

<script>
  import "../scripts/scrollReveal"
  import "../scripts/sectionIconDrift"
  import "../scripts/faqAccordion"
  import "../scripts/cardTilt"
  import "../scripts/magneticButton"
  import "../scripts/accountLadder"
</script>
