---
// Hot Sauce rebuild, checklist item 6: the fourth capability-template page, following
// /inventory-tracking's approved shape exactly (see CLAUDE.md "Checkpoint 3" and the Signal
// Primitives merge notes): grain+orb hero whose glass panel IS this page's assigned widget
// (Route Pick), "what it is" with an icon-drift watermark, "what it does" as one featured
// glass+gradient-ring tile plus a quiet ink-tint grid, "what it watches" as a plain signal list
// on a bold-depth-ink dark section, "how it works" as plain quiet tiles, and the luxurious
// .bold-faq-row/.bold-faq-panel accordion. All copy/schema content carried over unchanged from
// the prior ocean-palette build, it was already accurate, only the visual system and the
// widget/glass-panel additions are new.
import BaseLayout from "../layouts/BaseLayout.astro"
import Cta from "../components/Cta.astro"
import SectionIcon from "../components/icons/SectionIcon.astro"
import Breadcrumbs from "../components/Breadcrumbs.astro"
import { buildBreadcrumbSchema } from "../lib/breadcrumbs"

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Services", path: "/services" },
  { name: "Shipping Optimization", path: "/shipping-optimization" },
]
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbItems, Astro.site!)

// The hero's Route Pick widget: four carrier lanes, one marked the winner. routePick.ts races a
// dot down each lane to its own end point; the winner's end point (100) and its data-winner flag
// are the only two things that have to stay in sync between this markup and the script.
const lanes = [
  { label: "Carrier A", winner: false },
  { label: "Carrier B", winner: false },
  { label: "Carrier C", winner: true },
  { label: "Carrier D", winner: false },
]

const capabilities = [
  {
    title: "Compares Every Carrier Automatically",
    description:
      "Flowbound checks rates across your carriers for every shipment, instead of a person defaulting to whichever one they used last time.",
  },
  {
    title: "Weighs Cost Against Lead Time",
    description:
      "The cheapest option isn't always picked blind: Flowbound checks it against the delivery date your order actually needs, so speed and cost get weighed together.",
  },
  {
    title: "Recommends the Lane, Not Just the Rate",
    description:
      "Carrier, lane, and service level are evaluated together, so the recommendation is the one that actually gets the order there on time for the least cost.",
  },
  {
    title: "Re-Checks as Rates Change",
    description:
      "Carrier pricing shifts more often than most teams can track by hand. Flowbound re-runs the comparison continuously instead of relying on a rate sheet from last quarter.",
  },
  {
    title: "No Manual Rate Shopping",
    description:
      "Nobody has to open three carrier portals and copy numbers into a spreadsheet before a shipment goes out. The comparison already happened.",
  },
  {
    title: "Explains the Pick",
    description:
      "Every recommendation comes with the reasoning attached: which carriers were compared, what it would've cost each way, and why this lane won.",
  },
]

const signals = [
  "Carrier rates by lane and service level",
  "Current transit times and delays",
  "Order destination and required delivery date",
  "Package weight and dimensions",
  "Historical on-time performance by carrier",
  "Fuel surcharges and accessorial fees",
  "Shipment volume and carrier discounts",
  "Real-time carrier capacity",
]

const steps = [
  {
    n: "01",
    title: "It checks every lane",
    body: "Flowbound pulls live rates and transit times from every carrier you use, for the specific package and destination in front of it.",
  },
  {
    n: "02",
    title: "It weighs cost against the delivery date",
    body: "Cost and speed get evaluated together against what the order actually needs, not the cheapest option regardless of when it arrives.",
  },
  {
    n: "03",
    title: "It picks the lane and tells you why",
    body: "You get a straight recommendation, with the comparison behind it, so the choice is easy to trust and never a manual rate-shopping exercise.",
  },
]

const faqs = [
  {
    question: "How does Flowbound choose a carrier?",
    answer:
      "It compares carrier, lane, and service level together for that specific shipment, and recommends whichever combination gets it there on time for the least cost.",
  },
  {
    question: "Does it just pick the cheapest option?",
    answer:
      "No. Cost gets weighed against the delivery date the order actually needs, so a slower but cheaper option isn't picked blind.",
  },
  {
    question: "How often are carrier rates re-checked?",
    answer:
      "Continuously. Carrier pricing shifts more often than most teams can track by hand, so Flowbound re-runs the comparison instead of relying on a rate sheet from last quarter.",
  },
  {
    question: "Can I see why a specific carrier was recommended?",
    answer:
      "Every recommendation comes with the comparison attached, which carriers were checked, what each would have cost, and why the winning lane won.",
  },
]

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
}

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Shipping Optimization",
  name: "Shipping Optimization",
  description:
    "Flowbound's shipping optimization service compares carriers, lanes, and lead times automatically and recommends the option that gets an order there on time for the least cost.",
  provider: { "@type": "Organization", name: "Flowbound" },
  audience: {
    "@type": "Audience",
    audienceType: "Small and mid-sized businesses",
  },
}
---

<BaseLayout
  title="Shipping Optimization Software | Flowbound"
  description="Flowbound compares carriers, lanes, and lead times automatically and recommends the option that gets your order there on time for the least cost."
  path="/shipping-optimization"
  schema={[schema, faqSchema, breadcrumbSchema]}
>
  <section id="top" class="relative overflow-hidden bg-bold-paper py-24 pt-28 font-hanken md:py-32 md:pt-36">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <span class="bold-orb" style="width:21rem;height:21rem;top:-7rem;right:-4rem;background:#8FE3D3;opacity:0.33;" />
      <span class="bold-orb" style="width:17rem;height:17rem;top:8rem;right:20rem;background:#C998CD;opacity:0.28;" />
    </div>

    <div class="container-fb relative">
      <Breadcrumbs items={breadcrumbItems} />

      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-10">
        <div>
          <div data-reveal class="reveal-item mb-5 flex items-center gap-3">
            <SectionIcon name="crate" class="h-6 w-6 text-bold-mint-deep" />
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">Shipping Optimization</p>
          </div>
          <h1 data-reveal class="font-hanken reveal-item max-w-2xl text-[2.5rem] font-bold leading-[1.08] tracking-tighter text-bold-ink md:text-[3.2rem]" style="transition-delay: 60ms">
            The cheapest way to get there on time, picked <em class="font-instrument font-normal italic text-bold-mint-deep">automatically</em>.
          </h1>
          <p data-reveal class="reveal-item mt-6 max-w-lg text-[1.05rem] font-normal leading-relaxed text-bold-ink/70" style="transition-delay: 120ms">
            Flowbound compares carriers, lanes, and lead times automatically and recommends the option that
            gets your order there on time for the least cost. No manual rate shopping required.
          </p>
          <div data-reveal class="reveal-item mt-9 flex flex-wrap items-center gap-4" style="transition-delay: 180ms">
            <a
              href="#cta"
              data-magnetic
              class="bold-btn bold-btn-primary bold-btn-md group"
            >
              <span class="relative z-10">Request a pilot</span>
              <span aria-hidden="true" class="relative z-10 transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
            </a>
            <a
              href="#how"
              data-magnetic
              class="bold-btn bold-btn-secondary bold-btn-md group"
            >
              <span class="relative z-10">See how it works</span>
              <span aria-hidden="true" class="relative z-10 transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
            </a>
          </div>
        </div>

        <div data-reveal class="reveal-item bold-glass rounded-2xl p-5" style="transition-delay: 240ms">
          <div class="mb-3.5 flex items-center justify-between font-mono text-xs uppercase tracking-[0.05em] text-bold-taupe">
            <span class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-bold-mint-deep" aria-hidden="true" />
              Live &middot; Order&ndash;9043
            </span>
            <span>Carrier pick</span>
          </div>
          <div id="routePickLanes" class="route-lanes" aria-hidden="true">
            {lanes.map((lane) => (
              <div class="route-lane" data-winner={lane.winner ? "true" : "false"}>
                <span class="font-mono text-[0.68rem] uppercase tracking-[0.05em] text-bold-taupe">{lane.label}</span>
                <div class="route-track">
                  <span class="route-fill" />
                  <span class="route-dot" />
                </div>
              </div>
            ))}
          </div>
          <div class="mt-3.5 flex items-end justify-between">
            <span class="text-[1.1rem] font-bold text-bold-ink">Carrier C<span class="ml-1.5 text-[0.85rem] font-normal text-bold-ink/50">&middot; 2 days</span></span>
            <span id="routePickBadge" class="rounded-full bg-bold-mint-deep px-2.5 py-0.5 font-mono text-xs font-bold text-bold-paper opacity-0 transition-opacity duration-300">Selected</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="what" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <span class="what-ambient-blob"></span>
    </div>
    <div class="container-fb relative">
      <div class="flex items-start justify-between gap-8">
        <div class="reveal-item max-w-xl" data-reveal>
          <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">What it is</p>
          <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
            Rate shopping done automatically, on every shipment.
          </h2>
          <p class="mt-5 text-[0.98rem] font-normal leading-relaxed text-bold-ink/70">
            Most small teams pick a carrier out of habit, not because anyone checked whether it was actually
            the best option for that shipment. Flowbound compares carriers, lanes, and lead times every time
            an order goes out, and recommends the one that gets it there on time for the least cost, so the
            choice is never a guess and never a spreadsheet somebody has to build by hand.
          </p>
        </div>
        <div class="relative hidden shrink-0 md:block" data-icon-drift>
          <span class="icon-pulse-ring absolute inset-0 rounded-full border border-bold-ink/15" aria-hidden="true"></span>
          <SectionIcon name="crate" class="icon-spin relative h-[7.5rem] w-[7.5rem] text-bold-ink/20" />
        </div>
      </div>
    </div>
  </section>

  <section id="capabilities" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">What it does</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
          Built to pick the right lane, not just the cheapest one.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-3.5">
        <div data-reveal class="reveal-item">
          <div data-tilt class="tilt-card bold-tile-feature bold-glass rounded-2xl p-7 md:p-8">
            <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-bold-ink font-mono text-[0.65rem] font-bold text-bold-paper">01</span>
            <h3 class="font-hanken mt-3 text-[1.15rem] font-semibold text-bold-ink">{capabilities[0].title}</h3>
            <p class="mt-2 max-w-2xl text-[0.92rem] leading-relaxed text-bold-ink/65">{capabilities[0].description}</p>
          </div>
        </div>
        <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2 md:grid-cols-3">
          {capabilities.slice(1).map((capability, i) => (
            <div
              data-reveal
              class="reveal-item h-full rounded-2xl border border-bold-ink/8 bg-bold-paper p-6 transition-colors duration-300 hover:border-bold-ink/25 hover:bg-bold-ink/[0.04]"
              style={`transition-delay: ${(i + 1) * 70}ms`}
            >
              <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-bold-ink font-mono text-[0.65rem] font-bold text-bold-paper">{String(i + 2).padStart(2, "0")}</span>
              <h3 class="font-hanken mt-3 text-[0.95rem] font-semibold text-bold-ink">{capability.title}</h3>
              <p class="mt-2 text-[0.85rem] leading-relaxed text-bold-ink/65">{capability.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="signals" class="bold-depth-ink relative overflow-hidden py-20 font-hanken md:py-28">
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-mint">What it watches</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-paper md:text-[2.2rem]">
          Every signal that goes into a shipping decision, checked every time.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-2">
        {signals.map((signal, i) => (
          <div
            data-reveal
            class="reveal-item flex items-start gap-3 border border-bold-paper/15 bg-bold-paper/5 px-5 py-4"
            style={`transition-delay: ${(i % 4) * 70}ms`}
          >
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-bold-mint" aria-hidden="true" />
            <span class="text-[0.98rem] leading-snug text-bold-paper/80">{signal}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="how" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <span class="how-ambient-blob"></span>
    </div>
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">How it works</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
          From every carrier option to the one you can trust.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-3">
        {steps.map((s, i) => (
          <div
            data-reveal
            class="reveal-item h-full rounded-2xl border border-bold-ink/10 bg-bold-paper p-7 transition-colors duration-300 hover:border-bold-ink/25 hover:bg-bold-ink/[0.04]"
            style={`transition-delay: ${i * 90}ms`}
          >
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-bold-ink font-mono text-xs font-bold text-bold-paper">{s.n}</span>
            <h3 class="font-hanken mt-3 text-[1.05rem] font-medium leading-snug text-bold-ink">{s.title}</h3>
            <p class="mt-3 text-[0.92rem] font-normal leading-relaxed text-bold-ink/65">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="faq" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">FAQ</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
          Straight answers about how a carrier actually gets picked.
        </h2>
      </div>

      <div data-reveal class="reveal-item mt-12 overflow-hidden rounded-2xl border border-bold-ink/10 bg-bold-paper shadow-[0_24px_48px_-30px_rgba(46,22,48,0.25)]" data-faq-list style="transition-delay: 100ms">
        {faqs.map((faq, i) => (
          <>
            <button
              type="button"
              class={`bold-faq-row flex w-full items-center justify-between gap-6 px-7 py-6 text-left hover:bg-bold-ink/[0.025] ${i > 0 ? "border-t border-bold-ink/10" : ""}`}
              aria-expanded={i === 0 ? "true" : "false"}
              aria-controls={`faq-answer-${i}`}
            >
              <span class="text-[0.98rem] font-semibold text-bold-ink">{faq.question}</span>
              <span class="bold-faq-chevron-ring flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-bold-ink/10">
                <svg class="bold-faq-chevron h-4 w-4 text-bold-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </span>
            </button>
            <div id={`faq-answer-${i}`} class="bold-faq-panel" aria-hidden={i === 0 ? "false" : "true"}>
              <div class="px-7">
                <p class="max-w-2xl text-[0.92rem] font-normal leading-relaxed text-bold-ink/65">{faq.answer}</p>
              </div>
            </div>
          </>
        ))}
      </div>
    </div>
  </section>

  <Cta />
</BaseLayout>

<style>
  .what-ambient-blob {
    position: absolute;
    top: -10%;
    right: -6%;
    width: 28vw;
    height: 28vw;
    max-width: 380px;
    max-height: 380px;
    border-radius: 9999px;
    filter: blur(80px);
    background: radial-gradient(circle, rgba(110, 156, 163, 0.16) 0%, transparent 70%);
  }

  .how-ambient-blob {
    position: absolute;
    bottom: -15%;
    left: -6%;
    width: 28vw;
    height: 28vw;
    max-width: 380px;
    max-height: 380px;
    border-radius: 9999px;
    filter: blur(80px);
    background: radial-gradient(circle, rgba(110, 156, 163, 0.14) 0%, transparent 70%);
  }
</style>

<script>
  import "../scripts/scrollReveal"
  import "../scripts/sectionIconDrift"
  import "../scripts/faqAccordion"
  import "../scripts/cardTilt"
  import "../scripts/magneticButton"
  import "../scripts/routePick"
</script>
