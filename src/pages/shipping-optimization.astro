---
import BaseLayout from "../layouts/BaseLayout.astro"
import Cta from "../components/Cta.astro"
import ShippingOptimizationBackground from "../components/ShippingOptimizationBackground.astro"
import SectionIcon from "../components/icons/SectionIcon.astro"

const GLOW_SIZE = 420

const capabilities = [
  {
    title: "Compares Every Carrier Automatically",
    description:
      "Flowbound checks rates across your carriers for every shipment, instead of a person defaulting to whichever one they used last time.",
  },
  {
    title: "Weighs Cost Against Lead Time",
    description:
      "The cheapest option isn't always picked blind: Flowbound checks it against the delivery date your order actually needs, so speed and cost get weighed together.",
  },
  {
    title: "Recommends the Lane, Not Just the Rate",
    description:
      "Carrier, lane, and service level are evaluated together, so the recommendation is the one that actually gets the order there on time for the least cost.",
  },
  {
    title: "Re-Checks as Rates Change",
    description:
      "Carrier pricing shifts more often than most teams can track by hand. Flowbound re-runs the comparison continuously instead of relying on a rate sheet from last quarter.",
  },
  {
    title: "No Manual Rate Shopping",
    description:
      "Nobody has to open three carrier portals and copy numbers into a spreadsheet before a shipment goes out. The comparison already happened.",
  },
  {
    title: "Explains the Pick",
    description:
      "Every recommendation comes with the reasoning attached: which carriers were compared, what it would've cost each way, and why this lane won.",
  },
]

const signals = [
  "Carrier rates by lane and service level",
  "Current transit times and delays",
  "Order destination and required delivery date",
  "Package weight and dimensions",
  "Historical on-time performance by carrier",
  "Fuel surcharges and accessorial fees",
  "Shipment volume and carrier discounts",
  "Real-time carrier capacity",
]

const steps = [
  {
    n: "01",
    title: "It checks every lane",
    body: "Flowbound pulls live rates and transit times from every carrier you use, for the specific package and destination in front of it.",
  },
  {
    n: "02",
    title: "It weighs cost against the delivery date",
    body: "Cost and speed get evaluated together against what the order actually needs, not the cheapest option regardless of when it arrives.",
  },
  {
    n: "03",
    title: "It picks the lane and tells you why",
    body: "You get a straight recommendation, with the comparison behind it, so the choice is easy to trust and never a manual rate-shopping exercise.",
  },
]

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Shipping Optimization",
  applicationCategory: "BusinessApplication",
  description:
    "Flowbound's shipping optimization service compares carriers, lanes, and lead times automatically and recommends the option that gets an order there on time for the least cost.",
  audience: {
    "@type": "Audience",
    audienceType: "Small and mid-sized businesses",
  },
}
---

<BaseLayout
  title="Shipping Optimization | Flowbound"
  description="Flowbound compares carriers, lanes, and lead times automatically and recommends the option that gets your order there on time for the least cost, no manual rate shopping required."
  path="/shipping-optimization"
  schema={schema}
>
  <section class="relative min-h-[560px] overflow-hidden bg-fb-black md:min-h-[680px]">
    <ShippingOptimizationBackground />
    <div class="absolute inset-0 bg-gradient-to-r from-fb-black/90 from-0% via-fb-black/55 via-55% to-fb-black/10" />
    <div class="absolute inset-0 bg-gradient-to-t from-fb-black via-transparent to-transparent" />

    <div class="container-fb relative flex min-h-[560px] flex-col justify-center py-20 md:min-h-[680px]">
      <div class="mb-5 flex items-center gap-3">
        <SectionIcon name="crate" class="h-6 w-6 text-fb-green-300" />
        <p class="eyebrow text-fb-green-300">Shipping Optimization</p>
      </div>
      <h1 class="max-w-2xl text-[2.5rem] font-semibold leading-[1.08] tracking-tight text-fb-white md:text-[3.2rem]">
        The cheapest way to get there on time, picked automatically.
      </h1>
      <p class="mt-6 max-w-lg text-[1.05rem] leading-relaxed text-fb-white/65">
        Flowbound compares carriers, lanes, and lead times automatically and recommends the option that gets
        your order there on time for the least cost. No manual rate shopping required.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a
          href="#cta"
          class="inline-flex items-center bg-fb-green-500 px-6 py-3.5 font-body font-normal text-fb-white transition-colors hover:bg-fb-green-400"
        >
          Request a pilot
        </a>
        <a
          href="#how"
          class="inline-flex items-center border border-fb-white/25 px-6 py-3.5 font-body font-normal text-fb-white transition-colors hover:border-fb-white/60"
        >
          See how it works
        </a>
      </div>
    </div>
  </section>

  <section id="what" class="border-b border-fb-black/10 bg-fb-paper bg-grain py-20 md:py-28">
    <div class="container-fb">
      <div class="flex items-start justify-between gap-8">
        <div class="max-w-xl">
          <p class="eyebrow mb-4">What it is</p>
          <h2 class="text-[1.9rem] font-semibold leading-tight tracking-tight text-fb-black md:text-[2.2rem]">
            Rate shopping done automatically, on every shipment.
          </h2>
          <p class="mt-5 text-[0.98rem] leading-relaxed text-fb-black/65">
            Most small teams pick a carrier out of habit, not because anyone checked whether it was actually
            the best option for that shipment. Flowbound compares carriers, lanes, and lead times every time an
            order goes out, and recommends the one that gets it there on time for the least cost, so the choice
            is never a guess and never a spreadsheet somebody has to build by hand.
          </p>
        </div>
        <SectionIcon name="crate" class="hidden h-[7.5rem] w-[7.5rem] shrink-0 text-fb-green-500/[14%] md:block" />
      </div>
    </div>
  </section>

  <section id="capabilities" class="border-b border-fb-black/10 bg-fb-white bg-grain py-20 md:py-28">
    <div class="container-fb">
      <div class="max-w-xl">
        <p class="eyebrow mb-4">What it does</p>
        <h2 class="text-[1.9rem] font-semibold leading-tight tracking-tight text-fb-black md:text-[2.2rem]">
          Built to pick the right lane, not just the cheapest one.
        </h2>
      </div>

      <div
        data-glow-container
        data-glow-size={GLOW_SIZE}
        class="relative mt-14 grid grid-cols-1 gap-6 overflow-hidden md:grid-cols-3"
      >
        {capabilities.map((capability, i) => (
          <div class="group relative z-10 overflow-hidden border border-fb-black/10 bg-fb-white p-8 transition-all duration-500 ease-out hover:-translate-y-0.5 hover:border-fb-green-500/35 hover:bg-fb-green-50/50">
            <span class="font-mono text-sm text-fb-green-500">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="mt-3 text-[1.15rem] font-semibold leading-snug text-fb-black">{capability.title}</h3>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-fb-black/65">{capability.description}</p>
            <div class="absolute inset-x-0 bottom-0 h-0.5 origin-center scale-x-0 bg-fb-green-500 transition-transform duration-500 ease-out group-hover:scale-x-100" />
          </div>
        ))}

        <div
          data-glow
          aria-hidden="true"
          class="glow-cursor z-20 rounded-full mix-blend-multiply"
          style={`width: ${GLOW_SIZE}px; height: ${GLOW_SIZE}px; background: radial-gradient(circle, rgba(0,88,64,0.16), transparent 70%);`}
        />
      </div>
    </div>
  </section>

  <section id="signals" class="border-b border-fb-black/10 bg-fb-black py-20 md:py-28">
    <div class="container-fb">
      <div class="max-w-xl">
        <p class="eyebrow text-fb-green-300 mb-4">What it watches</p>
        <h2 class="text-[1.9rem] font-semibold leading-tight tracking-tight text-fb-white md:text-[2.2rem]">
          Every signal that goes into a shipping decision, checked every time.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-2">
        {signals.map((signal) => (
          <div class="flex items-start gap-3 border border-fb-white/15 bg-fb-white/5 px-5 py-4">
            <SectionIcon name="crate" class="mt-0.5 h-5 w-5 shrink-0 text-fb-green-400" />
            <span class="text-[0.98rem] leading-snug text-fb-white/80">{signal}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="how" class="border-b border-fb-black/10 bg-fb-white py-20 md:py-28">
    <div class="container-fb">
      <div class="max-w-xl">
        <p class="eyebrow mb-4">How it works</p>
        <h2 class="text-[1.9rem] font-semibold leading-tight tracking-tight text-fb-black md:text-[2.2rem]">
          From every carrier option to the one you can trust.
        </h2>
      </div>

      <div
        data-glow-container
        data-glow-size={GLOW_SIZE}
        class="relative mt-12 grid grid-cols-1 gap-6 overflow-hidden md:grid-cols-3"
      >
        {steps.map((s) => (
          <div class="group relative z-10 overflow-hidden border border-fb-green-400/30 bg-fb-green-50 p-8 transition-all duration-500 ease-out hover:-translate-y-0.5 hover:border-fb-green-500/40">
            <span class="font-mono text-sm text-fb-green-500">{s.n}</span>
            <h3 class="relative z-30 mt-3 text-[1.05rem] font-semibold leading-snug text-fb-black">{s.title}</h3>
            <p class="relative z-30 mt-3 text-[0.92rem] leading-relaxed text-fb-black">{s.body}</p>
            <div class="absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-fb-green-500 transition-transform duration-500 ease-out group-hover:scale-x-100" />
          </div>
        ))}

        <div
          data-glow
          aria-hidden="true"
          class="glow-cursor z-20 rounded-full mix-blend-screen"
          style={`width: ${GLOW_SIZE}px; height: ${GLOW_SIZE}px; background: radial-gradient(circle, rgba(255,255,255,0.55), transparent 70%);`}
        />
      </div>
    </div>
  </section>

  <Cta />
</BaseLayout>

<script>
  import "../scripts/hoverGlow"
</script>
