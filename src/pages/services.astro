---
// Hot Sauce rebuild, checklist item 14: the second of three remaining one-off pages, following
// the approved "Signal Primitives II" concept lab and the /how-it-works lesson (see CLAUDE.md):
// the hero switches to the standard light grain+orb + bold-glass panel pattern every other
// converted page uses, dropping the full-screen WebGL hero (ServicesOrbit) and its scattered
// floating pill-links entirely, at the user's explicit direction. The approved Signal Relay
// widget, originally scoped for "near the hero or above the service sections," lives in the
// hero's glass panel, the natural home for a widget that visualizes this page's whole thesis.
//
// The old three-tone system (paper/white/dark) collapses to two: light (former paper+white, both
// were only subtly different ocean shades) and dark (former "dark", used by exactly one service,
// Autonomous), keeping the page's real rhythm, 4 light sections + 1 dark bookend, matching the
// "exactly one dark bookend per page" convention every other Bold page already follows. The
// slide/scale/clip reveal-variety rotation (this page's own distinct feature, see CLAUDE.md) is
// unchanged, those CSS classes were never ocean-specific.
import BaseLayout from "../layouts/BaseLayout.astro"
import Cta from "../components/Cta.astro"
import SectionIcon from "../components/icons/SectionIcon.astro"
import { services } from "../data/services"

// Every section on this page picks one of three [data-reveal] treatments (see src/index.css) and
// they're assigned in a fixed rotation, slide/scale/clip repeating, so no two consecutive sections
// reveal the same way. This is deliberately different from the plain rise-and-fade `.reveal-item`
// the homepage and /product both use everywhere, see CLAUDE.md's "Services page" note.
const revealCycle = ["reveal-slide", "reveal-scale", "reveal-clip"] as const

const toneStyles = {
  light: {
    section: "bg-bold-paper",
    eyebrow: "text-bold-taupe",
    heading: "text-bold-ink",
    body: "text-bold-ink/70",
    card: "border-bold-ink/8 bg-bold-paper transition-colors duration-300 hover:border-bold-ink/25 hover:bg-bold-ink/[0.04]",
    cardHeading: "text-bold-ink",
    cardBody: "text-bold-ink/65",
    badge: "bg-bold-ink text-bold-paper",
    icon: "text-bold-ink/20",
    iconRing: "border-bold-ink/15",
    // The featured lead tile, reused from the capability pages: glass fill + the ink-to-mint
    // gradient ring (.bold-tile-feature), paired with [data-tilt] on the same element per the
    // existing tilt-card rule (the reveal-item wrapper stays separate, see cardTilt's comment in
    // CLAUDE.md about transition conflicts).
    featureCard: "tilt-card bold-tile-feature bold-glass rounded-2xl p-7 md:p-8",
    // Per-card footer action (see .bold-tile-link in index.css): a hairline divider plus a text
    // link, not another pill, so it reads as part of the card rather than a second button bolted
    // on below it.
    footerBorder: "border-bold-ink/10",
    link: "bold-tile-link text-bold-mint-deep hover:text-bold-ink",
  },
  dark: {
    section: "bold-depth-ink",
    eyebrow: "text-bold-mint",
    heading: "text-bold-paper",
    body: "text-bold-paper/70",
    card: "border-bold-paper/15 bg-bold-paper/5 transition-colors duration-300 hover:border-bold-paper/35 hover:bg-bold-paper/10",
    cardHeading: "text-bold-paper",
    cardBody: "text-bold-paper/60",
    badge: "bg-bold-paper text-bold-ink",
    icon: "text-bold-paper/15",
    iconRing: "border-bold-paper/15",
    // Same gradient ring, but no .bold-glass: its light frosted fill is built for sitting over
    // imagery (the hero), not a dark content section. A slightly stronger paper-tint fill than
    // the quiet tile (/8 vs /5) marks it as the featured one instead.
    featureCard: "tilt-card bold-tile-feature rounded-2xl border border-bold-paper/15 bg-bold-paper/8 p-7 md:p-8",
    footerBorder: "border-bold-paper/15",
    link: "bold-tile-link text-bold-mint hover:text-bold-paper",
  },
} as const

const toneFor = (tone: "paper" | "white" | "dark") => (tone === "dark" ? toneStyles.dark : toneStyles.light)

const agentCapabilities = [
  {
    title: "Ask, and Get an Answer",
    description:
      "Type a question about inventory, a supplier, an order, or a price, and get a straight answer pulled from your live data. No dashboard to dig through and no report to wait on.",
  },
  {
    title: "Embedded, Not Separate",
    description:
      "The agent lives inside the web app your team already uses every day. There's no extra tool to log into and nothing new to learn.",
  },
  {
    title: "Knows Your Business",
    description:
      "It answers from your actual numbers: your suppliers, your SKUs, your orders, not a generic help doc. Every answer is specific to your operation.",
  },
]

const agentSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Ask Flowbound",
  name: "Ask Flowbound",
  description:
    "An on-demand supply chain consultant embedded in the Flowbound web app, answering questions and pulling live data the moment a team asks for it.",
  provider: { "@type": "Organization", name: "Flowbound" },
  audience: {
    "@type": "Audience",
    audienceType: "Small and mid-sized businesses",
  },
}

const schema = [
  agentSchema,
  ...services.map((service) => ({
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: service.name,
    name: service.headline,
    description: service.description,
    provider: { "@type": "Organization", name: "Flowbound" },
    audience: {
      "@type": "Audience",
      audienceType: "Small and mid-sized businesses",
    },
  })),
]
---

<BaseLayout
  title="Supply Chain Services for Small Business | Flowbound"
  description="Flowbound's supply chain services for small businesses: inventory, suppliers, autonomous reordering and pricing, customer service, quality monitoring."
  path="/services"
  schema={schema}
>
  <section id="top" class="relative overflow-hidden bg-bold-paper py-24 pt-28 font-hanken md:py-32 md:pt-36">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <span class="bold-orb" style="width:21rem;height:21rem;top:-8rem;right:-4rem;background:#8FE3D3;opacity:0.33;" />
      <span class="bold-orb" style="width:16rem;height:16rem;top:8rem;right:11rem;background:#C998CD;opacity:0.26;" />
    </div>

    <div class="container-fb relative">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-10">
        <div>
          <div data-reveal class="reveal-item mb-5 flex items-center gap-3">
            <SectionIcon name="network" class="h-6 w-6 text-bold-mint-deep" />
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">Services</p>
          </div>
          <h1 data-reveal class="font-hanken reveal-item max-w-2xl text-[2.5rem] font-bold leading-[1.08] tracking-tighter text-bold-ink md:text-[3.2rem]" style="transition-delay: 60ms">
            Supply chain services built for teams without an <em class="font-instrument font-normal italic text-bold-mint-deep">SAP budget</em>.
          </h1>
          <p data-reveal class="reveal-item mt-6 max-w-lg text-[1.05rem] font-normal leading-relaxed text-bold-ink/70" style="transition-delay: 120ms">
            Every Flowbound service works the same way: watch the signal, make the call, and explain the
            reasoning in plain language. No dashboards to interpret yourself and no consultant required to
            make sense of it.
          </p>
          <div data-reveal class="reveal-item mt-9 flex flex-wrap items-center gap-4" style="transition-delay: 180ms">
            <a href="#cta" data-magnetic class="bold-btn bold-btn-primary bold-btn-md group">
              <span>Request a pilot</span>
              <span aria-hidden="true" class="transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
            </a>
            <a href="#agent" data-magnetic class="bold-btn bold-btn-secondary bold-btn-md group">
              <span>See how it works</span>
              <span aria-hidden="true" class="transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
            </a>
          </div>
        </div>

        <div data-reveal class="reveal-item bold-glass rounded-2xl p-5" style="transition-delay: 240ms">
          <div class="mb-4 flex items-center justify-between font-mono text-xs uppercase tracking-[0.05em] text-bold-taupe">
            <span class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-bold-mint-deep" aria-hidden="true" />
              Live &middot; All services
            </span>
            <span>Signal relay</span>
          </div>
          <div id="signalRelayWidget" aria-hidden="true">
            <div id="relayService" class="min-h-[1.3em] text-[1.05rem] font-bold text-bold-ink"></div>
            <div id="relayCap" class="mt-1 min-h-[1.3em] text-[0.85rem] text-bold-ink/60"></div>
            <div class="relay-track mt-3"><div id="relayFill" class="relay-fill"></div></div>
            <div id="relayDots" class="mt-4 flex gap-2"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="agent" class={`relative overflow-hidden border-t border-bold-ink/8 py-20 font-hanken md:py-28 ${toneStyles.light.section}`}>
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="container-fb relative">
      <div class="flex items-start justify-between gap-8">
        <div class={`${revealCycle[0]} max-w-xl`} data-reveal>
          <p class={`mb-4 font-mono text-xs uppercase tracking-[0.2em] ${toneStyles.light.eyebrow}`}>Ask Flowbound</p>
          <h2 class={`font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter md:text-[2.2rem] ${toneStyles.light.heading}`}>
            A consultant on demand, built into your web app.
          </h2>
          <p class={`mt-5 text-[0.98rem] font-normal leading-relaxed ${toneStyles.light.body}`}>
            Every service on this page runs through the same agent. It's not a separate tool you have to log
            into or a report you have to request: it's a consultant on demand, built right into your web app,
            that pulls whatever data you need the moment you ask for it.
          </p>
        </div>
        <div class="relative hidden shrink-0 md:block" data-icon-drift>
          <span class={`icon-pulse-ring absolute inset-0 rounded-full border ${toneStyles.light.iconRing}`} aria-hidden="true"></span>
          <SectionIcon name="spark" class={`icon-spin relative h-[7.5rem] w-[7.5rem] ${toneStyles.light.icon}`} />
        </div>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-3.5">
        <div data-reveal class={revealCycle[0]}>
          <div data-tilt class={toneStyles.light.featureCard}>
            <span class={`inline-flex h-6 w-6 items-center justify-center rounded-full font-mono text-[0.65rem] font-bold ${toneStyles.light.badge}`}>01</span>
            <h3 class={`font-hanken mt-3 text-[1.15rem] font-semibold ${toneStyles.light.cardHeading}`}>{agentCapabilities[0].title}</h3>
            <p class={`mt-2 max-w-2xl text-[0.92rem] leading-relaxed ${toneStyles.light.cardBody}`}>{agentCapabilities[0].description}</p>
          </div>
        </div>
        <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2">
          {agentCapabilities.slice(1).map((capability, i) => (
            <div data-reveal class={`${revealCycle[0]} h-full`} style={`transition-delay: ${(i + 1) * 90}ms`}>
              <div class={`h-full rounded-2xl border p-6 ${toneStyles.light.card}`}>
                <span class={`inline-flex h-6 w-6 items-center justify-center rounded-full font-mono text-[0.65rem] font-bold ${toneStyles.light.badge}`}>{String(i + 2).padStart(2, "0")}</span>
                <h3 class={`font-hanken mt-3 text-[0.95rem] font-semibold ${toneStyles.light.cardHeading}`}>{capability.title}</h3>
                <p class={`mt-2 text-[0.85rem] leading-relaxed ${toneStyles.light.cardBody}`}>{capability.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class={`${revealCycle[0]} mt-12 flex justify-center`} data-reveal style="transition-delay: 300ms">
        <a href="/ask-flowbound/" data-magnetic class="bold-btn bold-btn-primary bold-btn-lg group">
          <SectionIcon name="spark" class="h-5 w-5 shrink-0 transition-transform duration-500 ease-out group-hover:rotate-45" />
          <span>Explore Ask Flowbound</span>
          <span aria-hidden="true" class="transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  {services.map((service, si) => {
    const tone = toneFor(service.tone)
    const isDark = service.tone === "dark"
    const lead = service.capabilities[0]
    const rest = service.capabilities.slice(1)
    const restCols = rest.length >= 2 ? "sm:grid-cols-2" : ""
    // offset by 1 since the Ask Flowbound section above already used revealCycle[0]; keeps the
    // rotation continuous down the whole page instead of restarting per section
    const variant = revealCycle[(si + 1) % revealCycle.length]
    return (
      <section id={service.slug} class={`relative overflow-hidden border-t border-bold-ink/8 py-20 font-hanken md:py-28 ${tone.section}`}>
        {!isDark && <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />}
        <div class="container-fb relative">
          <div class="flex items-start justify-between gap-8">
            <div class={`${variant} max-w-xl`} data-reveal>
              {/* reveal-clip's actual clip-path animation lives one level in, on this wrapper,
                 never on the [data-reveal] element itself, see src/index.css's .reveal-clip-mask
                 comment for why (a real bug this codebase already shipped and fixed once). */}
              <div class={variant === "reveal-clip" ? "reveal-clip-mask" : ""}>
                <p class={`mb-4 font-mono text-xs uppercase tracking-[0.2em] ${tone.eyebrow}`}>{service.name}</p>
                <h2 class={`font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter md:text-[2.2rem] ${tone.heading}`}>
                  {service.headline}
                </h2>
                <p class={`mt-5 text-[0.98rem] font-normal leading-relaxed ${tone.body}`}>{service.description}</p>
              </div>
            </div>
            <div class="relative hidden shrink-0 md:block" data-icon-drift>
              <span class={`icon-pulse-ring absolute inset-0 rounded-full border ${tone.iconRing}`} aria-hidden="true"></span>
              <SectionIcon name={service.icon} class={`icon-spin relative h-[7.5rem] w-[7.5rem] ${tone.icon}`} />
            </div>
          </div>

          <div class="mt-12 grid grid-cols-1 gap-3.5">
            <div data-reveal class={variant}>
              <div class={variant === "reveal-clip" ? "reveal-clip-mask" : ""}>
                <div data-tilt class={`flex h-full flex-col ${tone.featureCard}`}>
                  <span class={`inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full font-mono text-[0.65rem] font-bold ${tone.badge}`}>01</span>
                  <h3 class={`font-hanken mt-3 text-[1.15rem] font-semibold ${tone.cardHeading}`}>{lead.title}</h3>
                  <p class={`mt-2 max-w-2xl text-[0.92rem] leading-relaxed ${tone.cardBody}`}>{lead.description}</p>
                  {lead.href && (
                    <div class={`mt-6 border-t pt-4 ${tone.footerBorder}`}>
                      <a href={lead.href} class={`group/link inline-flex items-center gap-2 text-[0.88rem] font-semibold ${tone.link}`}>
                        <SectionIcon name={service.icon} class="h-4 w-4 shrink-0 transition-transform duration-300 ease-out group-hover/link:rotate-45" />
                        <span>{lead.ctaLabel ?? `Explore ${lead.title}`}</span>
                        <span aria-hidden="true" class="transition-transform duration-300 ease-out group-hover/link:translate-x-1">&rarr;</span>
                      </a>
                    </div>
                  )}
                </div>
              </div>
            </div>

            {rest.length > 0 && (
              <div class={`grid grid-cols-1 gap-3.5 ${restCols}`}>
                {rest.map((capability, i) => (
                  <div data-reveal class={`${variant} h-full`} style={`transition-delay: ${(i + 1) * 90}ms`}>
                    <div class={`h-full ${variant === "reveal-clip" ? "reveal-clip-mask" : ""}`}>
                      <div class={`flex h-full flex-col rounded-2xl border p-6 ${tone.card}`}>
                        <span class={`inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full font-mono text-[0.65rem] font-bold ${tone.badge}`}>{String(i + 2).padStart(2, "0")}</span>
                        <h3 class={`font-hanken mt-3 text-[0.95rem] font-semibold ${tone.cardHeading}`}>{capability.title}</h3>
                        <p class={`mt-2 text-[0.85rem] leading-relaxed ${tone.cardBody}`}>{capability.description}</p>
                        {capability.href && (
                          <div class={`mt-auto border-t pt-4 ${tone.footerBorder}`}>
                            <a href={capability.href} class={`group/link inline-flex items-center gap-2 text-[0.82rem] font-semibold ${tone.link}`}>
                              <SectionIcon name={service.icon} class="h-3.5 w-3.5 shrink-0 transition-transform duration-300 ease-out group-hover/link:rotate-45" />
                              <span>{capability.ctaLabel ?? `Explore ${capability.title}`}</span>
                              <span aria-hidden="true" class="transition-transform duration-300 ease-out group-hover/link:translate-x-1">&rarr;</span>
                            </a>
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>

          {service.href && (
            <div class={`${variant} mt-12 flex justify-center`} data-reveal style="transition-delay: 300ms">
              <a
                href={service.href}
                data-magnetic
                class={`bold-btn bold-btn-primary bold-btn-lg group ${variant === "reveal-clip" ? "reveal-clip-mask" : ""}`}
              >
                <SectionIcon name={service.icon} class="h-5 w-5 shrink-0 transition-transform duration-500 ease-out group-hover:rotate-45" />
                <span>{service.ctaLabel ?? `Explore ${service.name}`}</span>
                <span aria-hidden="true" class="transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
              </a>
            </div>
          )}
        </div>
      </section>
    )
  })}

  <Cta />
</BaseLayout>

<script>
  import "../scripts/scrollReveal"
  import "../scripts/sectionIconDrift"
  import "../scripts/magneticButton"
  import "../scripts/signalRelay"
  import "../scripts/cardTilt"
</script>
