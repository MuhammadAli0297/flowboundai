---
// Hot Sauce rebuild, checklist item 9: the seventh and final capability-template page, following
// /wholesale-account-management's approved shape exactly (see CLAUDE.md "Checkpoint 3" and the
// Signal Primitives merge notes): grain+orb hero whose glass panel IS this page's assigned widget
// (Price Delta), "what it is" with an icon-drift watermark, "what it does" as one featured
// glass+gradient-ring tile plus a quiet ink-tint grid, "what it watches" as a plain signal list
// on a bold-depth-ink dark section, "how it works" as plain quiet tiles, and the luxurious
// .bold-faq-row/.bold-faq-panel accordion. All copy/schema content carried over unchanged from
// the prior ocean-palette build, it was already accurate, only the visual system and the
// widget/glass-panel additions are new.
import BaseLayout from "../layouts/BaseLayout.astro"
import Cta from "../components/Cta.astro"
import SectionIcon from "../components/icons/SectionIcon.astro"
import Breadcrumbs from "../components/Breadcrumbs.astro"
import { buildBreadcrumbSchema } from "../lib/breadcrumbs"

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Services", path: "/services" },
  { name: "Pricing", path: "/pricing" },
]
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbItems, Astro.site!)

const capabilities = [
  {
    title: "Reacts the Moment Costs or Demand Shift",
    description:
      "When a supplier's cost changes or demand moves, Flowbound recalculates your sell price right away, not whenever someone gets around to reviewing margins.",
  },
  {
    title: "Every Adjustment Stays Inside Your Bounds",
    description:
      "You set the floor, the ceiling, and how much a price can move at once, and every automatic adjustment stays inside those limits.",
  },
  {
    title: "Margin Holds Without the Manual Math",
    description:
      "The math that used to mean re-running a spreadsheet every time a supplier changed a cost now happens automatically, so your margin holds without you doing it by hand.",
  },
  {
    title: "One Price, Everywhere It's Listed",
    description:
      "When Flowbound adjusts a price, it updates everywhere that price lives, so customers never see two different numbers for the same SKU.",
  },
  {
    title: "You Find Out After, Not Before",
    description:
      "Once you trust the call, Flowbound tells you what it changed and why, instead of waiting on an approval before a price can move.",
  },
  {
    title: "Nothing Slips Through on a Busy Week",
    description:
      "Because the adjustment is automatic, a cost change doesn't sit unnoticed until it's already eaten into margin.",
  },
]

const signals = [
  "Live supplier cost per SKU",
  "Current sell price and margin",
  "Price floor and ceiling you've set",
  "Maximum single-move percentage",
  "Demand trend for the SKU",
  "Competitor or market price signals, if you track them",
  "Recent supplier cost or freight changes",
  "Approval thresholds for larger moves",
]

const steps = [
  {
    n: "01",
    title: "It watches cost and demand together",
    body: "Supplier costs and demand signals are tracked continuously against your current sell price and margin target.",
  },
  {
    n: "02",
    title: "It adjusts the price inside your bounds",
    body: "When something shifts enough to matter, Flowbound moves the price within the floor, ceiling, and max-move limits you set.",
  },
  {
    n: "03",
    title: "It tells you what changed and why",
    body: "You get a plain-language summary of what moved, by how much, and why, instead of a spreadsheet you have to reconcile yourself.",
  },
]

const faqs = [
  {
    question: "Is this page about what Flowbound costs?",
    answer:
      "No, this is Flowbound's autonomous repricing capability, adjusting your product's sell price when costs or demand shift. Reach out directly to talk about what Flowbound itself costs to run.",
  },
  {
    question: "What actually triggers a price change?",
    answer:
      "A shift in supplier cost or demand that's big enough to matter, checked continuously against your current margin target.",
  },
  {
    question: "How much can a price move on its own?",
    answer:
      "Only within the floor, ceiling, and maximum single-move percentage you set. Every automatic adjustment stays inside those bounds.",
  },
  {
    question: "Do I need to approve a price change before it happens?",
    answer:
      "Not once you trust the call. Flowbound tells you what it changed and why afterward, the same after-the-fact pattern it uses for autonomous reorders.",
  },
]

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
}

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Pricing",
  name: "Pricing",
  description:
    "When supplier costs shift or demand moves, Flowbound adjusts your sell price within the bounds you set, so your margin holds without you re-running the math every time something changes.",
  provider: { "@type": "Organization", name: "Flowbound" },
  audience: {
    "@type": "Audience",
    audienceType: "Small and mid-sized businesses",
  },
}
---

<BaseLayout
  title="Automated Repricing Software | Flowbound"
  description="When supplier costs or demand shift, Flowbound adjusts your sell price within limits you set, so margin holds without re-running the math yourself."
  path="/pricing"
  schema={[schema, faqSchema, breadcrumbSchema]}
>
  <section id="top" class="relative overflow-hidden bg-bold-paper py-24 pt-28 font-hanken md:py-32 md:pt-36">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <span class="bold-orb" style="width:18rem;height:18rem;top:-8rem;right:-2rem;background:#8FE3D3;opacity:0.29;" />
      <span class="bold-orb" style="width:15rem;height:15rem;top:5rem;right:12rem;background:#C998CD;opacity:0.28;" />
    </div>

    <div class="container-fb relative">
      <Breadcrumbs items={breadcrumbItems} />

      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-10">
        <div>
          <div data-reveal class="reveal-item mb-5 flex items-center gap-3">
            <SectionIcon name="bolt" class="h-6 w-6 text-bold-mint-deep" />
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">Pricing</p>
          </div>
          <h1 data-reveal class="font-hanken reveal-item max-w-2xl text-[2.5rem] font-bold leading-[1.08] tracking-tighter text-bold-ink md:text-[3.2rem]" style="transition-delay: 60ms">
            Your margin holds, even when costs move without <em class="font-instrument font-normal italic text-bold-mint-deep">warning</em>.
          </h1>
          <p data-reveal class="reveal-item mt-6 max-w-lg text-[1.05rem] font-normal leading-relaxed text-bold-ink/70" style="transition-delay: 120ms">
            When supplier costs shift or demand moves, Flowbound adjusts your sell price within the bounds
            you set, so your margin holds without you re-running the math every time something changes.
          </p>
          <div data-reveal class="reveal-item mt-9 flex flex-wrap items-center gap-4" style="transition-delay: 180ms">
            <a
              href="#cta"
              data-magnetic
              class="bold-btn bold-btn-primary bold-btn-md group"
            >
              <span class="relative z-10">Request a pilot</span>
              <span aria-hidden="true" class="relative z-10 transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
            </a>
            <a
              href="#how"
              data-magnetic
              class="bold-btn bold-btn-secondary bold-btn-md group"
            >
              <span class="relative z-10">See how it works</span>
              <span aria-hidden="true" class="relative z-10 transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
            </a>
          </div>
        </div>

        <div data-reveal class="reveal-item bold-glass rounded-2xl p-5" style="transition-delay: 240ms">
          <div class="mb-4 flex items-center justify-between font-mono text-xs uppercase tracking-[0.05em] text-bold-taupe">
            <span class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-bold-mint-deep" aria-hidden="true" />
              Live &middot; SKU&ndash;1182
            </span>
            <span>Price delta</span>
          </div>
          <div id="priceDeltaWidget" class="mt-1" aria-hidden="true">
            <div class="flex items-center justify-between font-mono text-[0.65rem] uppercase tracking-[0.05em] text-bold-taupe">
              <span>Floor $18.00</span>
              <span>Ceiling $32.00</span>
            </div>
            <div class="delta-track mt-3">
              <span class="delta-tick" style="left:0%" />
              <span class="delta-tick" style="left:100%" />
              <span id="deltaRange" class="delta-range" />
              <span id="deltaMarker" class="delta-marker" />
            </div>
          </div>
          <div class="mt-5 flex items-end justify-between">
            <span class="text-[1.1rem] font-bold text-bold-ink">$24.00 <span class="text-bold-ink/40">&rarr;</span> $24.58</span>
            <span id="deltaBadge" class="rounded-full bg-bold-mint-deep px-2.5 py-0.5 font-mono text-xs font-bold text-bold-paper opacity-0 transition-opacity duration-300">+2.4%</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="what" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <span class="what-ambient-blob"></span>
    </div>
    <div class="container-fb relative">
      <div class="flex items-start justify-between gap-8">
        <div class="reveal-item max-w-xl" data-reveal>
          <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">What it is</p>
          <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
            The spreadsheet re-run you used to do by hand, now happening on its own.
          </h2>
          <p class="mt-5 text-[0.98rem] font-normal leading-relaxed text-bold-ink/70">
            A supplier cost changes or demand shifts, and your margin quietly moves with it until someone
            notices and re-runs the numbers. Flowbound watches that math continuously and adjusts your sell
            price the moment it needs to move, within the floor, ceiling, and max-move limits you set. Your
            margin holds without you having to catch every change yourself.
          </p>
        </div>
        <div class="relative hidden shrink-0 md:block" data-icon-drift>
          <span class="icon-pulse-ring absolute inset-0 rounded-full border border-bold-ink/15" aria-hidden="true"></span>
          <SectionIcon name="bolt" class="icon-spin relative h-[7.5rem] w-[7.5rem] text-bold-ink/20" />
        </div>
      </div>
    </div>
  </section>

  <section id="capabilities" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">What it does</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
          Built so your margin holds without you doing the math every time.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-3.5">
        <div data-reveal class="reveal-item">
          <div data-tilt class="tilt-card bold-tile-feature bold-glass rounded-2xl p-7 md:p-8">
            <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-bold-ink font-mono text-[0.65rem] font-bold text-bold-paper">01</span>
            <h3 class="font-hanken mt-3 text-[1.15rem] font-semibold text-bold-ink">{capabilities[0].title}</h3>
            <p class="mt-2 max-w-2xl text-[0.92rem] leading-relaxed text-bold-ink/65">{capabilities[0].description}</p>
          </div>
        </div>
        <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2 md:grid-cols-3">
          {capabilities.slice(1).map((capability, i) => (
            <div
              data-reveal
              class="reveal-item h-full rounded-2xl border border-bold-ink/8 bg-bold-paper p-6 transition-colors duration-300 hover:border-bold-ink/25 hover:bg-bold-ink/[0.04]"
              style={`transition-delay: ${(i + 1) * 70}ms`}
            >
              <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-bold-ink font-mono text-[0.65rem] font-bold text-bold-paper">{String(i + 2).padStart(2, "0")}</span>
              <h3 class="font-hanken mt-3 text-[0.95rem] font-semibold text-bold-ink">{capability.title}</h3>
              <p class="mt-2 text-[0.85rem] leading-relaxed text-bold-ink/65">{capability.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="signals" class="bold-depth-ink relative overflow-hidden py-20 font-hanken md:py-28">
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-mint">What it watches</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-paper md:text-[2.2rem]">
          Every input that has to line up before a price moves on its own.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-2">
        {signals.map((signal, i) => (
          <div
            data-reveal
            class="reveal-item flex items-start gap-3 border border-bold-paper/15 bg-bold-paper/5 px-5 py-4"
            style={`transition-delay: ${(i % 4) * 70}ms`}
          >
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-bold-mint" aria-hidden="true" />
            <span class="text-[0.98rem] leading-snug text-bold-paper/80">{signal}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="how" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <span class="how-ambient-blob"></span>
    </div>
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">How it works</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
          From a cost change to a price update, without a spreadsheet in between.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-3">
        {steps.map((s, i) => (
          <div
            data-reveal
            class="reveal-item h-full rounded-2xl border border-bold-ink/10 bg-bold-paper p-7 transition-colors duration-300 hover:border-bold-ink/25 hover:bg-bold-ink/[0.04]"
            style={`transition-delay: ${i * 90}ms`}
          >
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-bold-ink font-mono text-xs font-bold text-bold-paper">{s.n}</span>
            <h3 class="font-hanken mt-3 text-[1.05rem] font-medium leading-snug text-bold-ink">{s.title}</h3>
            <p class="mt-3 text-[0.92rem] font-normal leading-relaxed text-bold-ink/65">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="faq" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">FAQ</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
          Straight answers about how the price actually moves on its own.
        </h2>
      </div>

      <div data-reveal class="reveal-item mt-12 overflow-hidden rounded-2xl border border-bold-ink/10 bg-bold-paper shadow-[0_24px_48px_-30px_rgba(46,22,48,0.25)]" data-faq-list style="transition-delay: 100ms">
        {faqs.map((faq, i) => (
          <>
            <button
              type="button"
              class={`bold-faq-row flex w-full items-center justify-between gap-6 px-7 py-6 text-left hover:bg-bold-ink/[0.025] ${i > 0 ? "border-t border-bold-ink/10" : ""}`}
              aria-expanded={i === 0 ? "true" : "false"}
              aria-controls={`faq-answer-${i}`}
            >
              <span class="text-[0.98rem] font-semibold text-bold-ink">{faq.question}</span>
              <span class="bold-faq-chevron-ring flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-bold-ink/10">
                <svg class="bold-faq-chevron h-4 w-4 text-bold-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </span>
            </button>
            <div id={`faq-answer-${i}`} class="bold-faq-panel" aria-hidden={i === 0 ? "false" : "true"}>
              <div class="px-7">
                <p class="max-w-2xl text-[0.92rem] font-normal leading-relaxed text-bold-ink/65">{faq.answer}</p>
              </div>
            </div>
          </>
        ))}
      </div>
    </div>
  </section>

  <Cta />
</BaseLayout>

<style>
  .what-ambient-blob {
    position: absolute;
    top: -10%;
    right: -6%;
    width: 28vw;
    height: 28vw;
    max-width: 380px;
    max-height: 380px;
    border-radius: 9999px;
    filter: blur(80px);
    background: radial-gradient(circle, rgba(110, 156, 163, 0.16) 0%, transparent 70%);
  }

  .how-ambient-blob {
    position: absolute;
    bottom: -15%;
    left: -6%;
    width: 28vw;
    height: 28vw;
    max-width: 380px;
    max-height: 380px;
    border-radius: 9999px;
    filter: blur(80px);
    background: radial-gradient(circle, rgba(110, 156, 163, 0.14) 0%, transparent 70%);
  }
</style>

<script>
  import "../scripts/scrollReveal"
  import "../scripts/sectionIconDrift"
  import "../scripts/faqAccordion"
  import "../scripts/cardTilt"
  import "../scripts/magneticButton"
  import "../scripts/priceDelta"
</script>
