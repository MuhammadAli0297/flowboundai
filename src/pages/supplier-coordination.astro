---
// Hot Sauce rebuild, checklist item 7: the fifth capability-template page, following
// /shipping-optimization's approved shape exactly (see CLAUDE.md "Checkpoint 3" and the Signal
// Primitives merge notes): grain+orb hero whose glass panel IS this page's assigned widget
// (Supplier Ping), "what it is" with an icon-drift watermark, "what it does" as one featured
// glass+gradient-ring tile plus a quiet ink-tint grid, "what it watches" as a plain signal list
// on a bold-depth-ink dark section, "how it works" as plain quiet tiles, and the luxurious
// .bold-faq-row/.bold-faq-panel accordion. All copy/schema content carried over unchanged from
// the prior ocean-palette build, it was already accurate, only the visual system and the
// widget/glass-panel additions are new.
import BaseLayout from "../layouts/BaseLayout.astro"
import Cta from "../components/Cta.astro"
import SectionIcon from "../components/icons/SectionIcon.astro"
import Breadcrumbs from "../components/Breadcrumbs.astro"
import { buildBreadcrumbSchema } from "../lib/breadcrumbs"

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Services", path: "/services" },
  { name: "Supplier Coordination", path: "/supplier-coordination" },
]
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbItems, Astro.site!)

const capabilities = [
  {
    title: "Every Conversation in One Place",
    description:
      "Supplier calls, emails, and purchase order updates land in a single record per vendor, so nothing important is buried in someone's personal inbox.",
  },
  {
    title: "Tracks Every Lead Time Change",
    description:
      "When a supplier pushes back a delivery date, Flowbound logs it against the affected purchase orders immediately, not whenever someone happens to notice.",
  },
  {
    title: "Flags What Needs Your Attention",
    description:
      "A slipping lead time or a purchase order going quiet gets surfaced right away, before it turns into a stockout nobody saw coming.",
  },
  {
    title: "One Status Per Supplier",
    description:
      "Instead of piecing together a supplier's status from three email threads, you get one current answer: what's on order, what's late, and what's next.",
  },
  {
    title: "No Chasing Status by Phone",
    description:
      "The updates that used to require a call to check in are already logged and visible, so your team spends less time chasing and more time deciding.",
  },
  {
    title: "Works Across Every Vendor",
    description:
      "The same coordination applies whether you have three suppliers or thirty, so growing your vendor list doesn't mean growing the busywork.",
  },
]

const signals = [
  "Open purchase orders by supplier",
  "Lead time changes and delivery updates",
  "Supplier email and call history",
  "Reorder points tied to each vendor",
  "Pricing and quote changes",
  "Late or at-risk shipments",
  "Vendor performance over time",
  "Upcoming renewals and standing orders",
]

const steps = [
  {
    n: "01",
    title: "It keeps every supplier record current",
    body: "Purchase orders, lead times, and conversations are logged in one place per supplier as they happen, not reconstructed after the fact.",
  },
  {
    n: "02",
    title: "It watches for anything drifting off track",
    body: "A slipping delivery date or a stalled order gets checked against what it means for your stock, not just noted and forgotten.",
  },
  {
    n: "03",
    title: "It flags what actually needs you",
    body: "You see the supplier situations that need a decision, with the context attached, instead of scanning every vendor to find them yourself.",
  },
]

const faqs = [
  {
    question: "Where do supplier conversations and purchase orders actually live?",
    answer:
      "In one record per vendor, calls, emails, and PO updates all land there, instead of getting buried in someone's personal inbox.",
  },
  {
    question: "What happens when a supplier pushes back a delivery date?",
    answer:
      "Flowbound logs it against the affected purchase orders immediately, not whenever someone happens to notice the email.",
  },
  {
    question: "How does Flowbound decide what needs my attention?",
    answer:
      "A slipping lead time or a purchase order gone quiet gets flagged before it turns into a stockout, so you're not scanning every vendor yourself to find the one problem.",
  },
  {
    question: "Does this work the same with three suppliers or thirty?",
    answer:
      "Yes, the same coordination applies either way, so a growing vendor list doesn't mean growing busywork.",
  },
]

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
}

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Supplier Coordination",
  name: "Supplier Coordination",
  description:
    "Flowbound's supplier coordination service keeps every supplier conversation, purchase order, and lead time change in one place, and flags the ones that need attention before a delay turns into a stockout.",
  provider: { "@type": "Organization", name: "Flowbound" },
  audience: {
    "@type": "Audience",
    audienceType: "Small and mid-sized businesses",
  },
}
---

<BaseLayout
  title="Supplier Coordination Software | Flowbound"
  description="Flowbound keeps every supplier conversation, purchase order, and lead time change in one place, flagging what needs attention before it becomes a stockout."
  path="/supplier-coordination"
  schema={[schema, faqSchema, breadcrumbSchema]}
>
  <section id="top" class="relative overflow-hidden bg-bold-paper py-24 pt-28 font-hanken md:py-32 md:pt-36">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <span class="bold-orb" style="width:19rem;height:19rem;top:-9rem;right:-3rem;background:#8FE3D3;opacity:0.3;" />
      <span class="bold-orb" style="width:13rem;height:13rem;top:2rem;right:8rem;background:#C998CD;opacity:0.24;" />
    </div>

    <div class="container-fb relative">
      <Breadcrumbs items={breadcrumbItems} />

      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-10">
        <div>
          <div data-reveal class="reveal-item mb-5 flex items-center gap-3">
            <SectionIcon name="network" class="h-6 w-6 text-bold-mint-deep" />
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">Supplier Coordination</p>
          </div>
          <h1 data-reveal class="font-hanken reveal-item max-w-2xl text-[2.5rem] font-bold leading-[1.08] tracking-tighter text-bold-ink md:text-[3.2rem]" style="transition-delay: 60ms">
            Every supplier relationship in one place, nothing falling through the <em class="font-instrument font-normal italic text-bold-mint-deep">cracks</em>.
          </h1>
          <p data-reveal class="reveal-item mt-6 max-w-lg text-[1.05rem] font-normal leading-relaxed text-bold-ink/70" style="transition-delay: 120ms">
            Flowbound keeps every supplier conversation, purchase order, and lead time change in one place,
            and flags the ones that need your attention before a delay turns into a stockout.
          </p>
          <div data-reveal class="reveal-item mt-9 flex flex-wrap items-center gap-4" style="transition-delay: 180ms">
            <a
              href="#cta"
              data-magnetic
              class="bold-btn bold-btn-primary bold-btn-md group"
            >
              <span class="relative z-10">Request a pilot</span>
              <span aria-hidden="true" class="relative z-10 transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
            </a>
            <a
              href="#how"
              data-magnetic
              class="bold-btn bold-btn-secondary bold-btn-md group"
            >
              <span class="relative z-10">See how it works</span>
              <span aria-hidden="true" class="relative z-10 transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
            </a>
          </div>
        </div>

        <div data-reveal class="reveal-item bold-glass rounded-2xl p-5" style="transition-delay: 240ms">
          <div class="mb-3.5 flex items-center justify-between font-mono text-xs uppercase tracking-[0.05em] text-bold-taupe">
            <span class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-bold-mint-deep" aria-hidden="true" />
              Live &middot; 12 suppliers
            </span>
            <span>Supplier ping</span>
          </div>
          <div id="supplierPingDiagram" class="ping-diagram">
            <svg viewBox="0 0 220 110" class="w-full" aria-hidden="true">
              <line class="ping-line" x1="46" y1="24" x2="110" y2="55"></line>
              <line class="ping-line" x1="174" y1="24" x2="110" y2="55"></line>
              <line class="ping-line" x1="46" y1="86" x2="110" y2="55"></line>
              <line class="ping-line" x1="174" y1="86" x2="110" y2="55"></line>
              <circle class="ping-hub" cx="110" cy="55" r="7"></circle>
              <circle class="ping-node" cx="46" cy="24" r="5" style="animation-delay: 0s"></circle>
              <circle class="ping-node" cx="174" cy="24" r="5" style="animation-delay: 0.6s"></circle>
              <circle id="supplierPingNode" class="ping-node" cx="46" cy="86" r="5" style="animation-delay: 1.2s"></circle>
              <circle class="ping-node" cx="174" cy="86" r="5" style="animation-delay: 1.8s"></circle>
              <circle id="supplierPingPulse" class="ping-pulse" r="3.5"></circle>
            </svg>
          </div>
          <div class="mt-3 flex items-end justify-between">
            <span class="text-[1.05rem] font-bold text-bold-ink">Northline Goods<span class="ml-1.5 text-[0.85rem] font-normal text-bold-ink/50">lead time +4d</span></span>
            <span id="supplierPingBadge" class="rounded-full bg-bold-taupe px-2.5 py-0.5 font-mono text-xs font-bold text-bold-paper opacity-0 transition-opacity duration-300">1 flagged</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="what" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <span class="what-ambient-blob"></span>
    </div>
    <div class="container-fb relative">
      <div class="flex items-start justify-between gap-8">
        <div class="reveal-item max-w-xl" data-reveal>
          <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">What it is</p>
          <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
            One current status per supplier, not three email threads.
          </h2>
          <p class="mt-5 text-[0.98rem] font-normal leading-relaxed text-bold-ink/70">
            Most small teams manage suppliers through a mix of email, phone calls, and memory, which works
            until a lead time slips and nobody notices until the shelf is empty. Flowbound keeps every
            supplier's conversations, purchase orders, and delivery changes in one living record, and tells
            you the moment something needs a decision instead of leaving you to go looking for it.
          </p>
        </div>
        <div class="relative hidden shrink-0 md:block" data-icon-drift>
          <span class="icon-pulse-ring absolute inset-0 rounded-full border border-bold-ink/15" aria-hidden="true"></span>
          <SectionIcon name="network" class="icon-spin relative h-[7.5rem] w-[7.5rem] text-bold-ink/20" />
        </div>
      </div>
    </div>
  </section>

  <section id="capabilities" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">What it does</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
          Built to catch a slipping supplier before it costs you a stockout.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-3.5">
        <div data-reveal class="reveal-item">
          <div data-tilt class="tilt-card bold-tile-feature bold-glass rounded-2xl p-7 md:p-8">
            <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-bold-ink font-mono text-[0.65rem] font-bold text-bold-paper">01</span>
            <h3 class="font-hanken mt-3 text-[1.15rem] font-semibold text-bold-ink">{capabilities[0].title}</h3>
            <p class="mt-2 max-w-2xl text-[0.92rem] leading-relaxed text-bold-ink/65">{capabilities[0].description}</p>
          </div>
        </div>
        <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2 md:grid-cols-3">
          {capabilities.slice(1).map((capability, i) => (
            <div
              data-reveal
              class="reveal-item h-full rounded-2xl border border-bold-ink/8 bg-bold-paper p-6 transition-colors duration-300 hover:border-bold-ink/25 hover:bg-bold-ink/[0.04]"
              style={`transition-delay: ${(i + 1) * 70}ms`}
            >
              <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-bold-ink font-mono text-[0.65rem] font-bold text-bold-paper">{String(i + 2).padStart(2, "0")}</span>
              <h3 class="font-hanken mt-3 text-[0.95rem] font-semibold text-bold-ink">{capability.title}</h3>
              <p class="mt-2 text-[0.85rem] leading-relaxed text-bold-ink/65">{capability.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="signals" class="bold-depth-ink relative overflow-hidden py-20 font-hanken md:py-28">
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-mint">What it watches</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-paper md:text-[2.2rem]">
          Every signal that matters for a supplier relationship, tracked continuously.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-2">
        {signals.map((signal, i) => (
          <div
            data-reveal
            class="reveal-item flex items-start gap-3 border border-bold-paper/15 bg-bold-paper/5 px-5 py-4"
            style={`transition-delay: ${(i % 4) * 70}ms`}
          >
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-bold-mint" aria-hidden="true" />
            <span class="text-[0.98rem] leading-snug text-bold-paper/80">{signal}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="how" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <span class="how-ambient-blob"></span>
    </div>
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">How it works</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
          From scattered supplier updates to the one that needs you.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-3">
        {steps.map((s, i) => (
          <div
            data-reveal
            class="reveal-item h-full rounded-2xl border border-bold-ink/10 bg-bold-paper p-7 transition-colors duration-300 hover:border-bold-ink/25 hover:bg-bold-ink/[0.04]"
            style={`transition-delay: ${i * 90}ms`}
          >
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-bold-ink font-mono text-xs font-bold text-bold-paper">{s.n}</span>
            <h3 class="font-hanken mt-3 text-[1.05rem] font-medium leading-snug text-bold-ink">{s.title}</h3>
            <p class="mt-3 text-[0.92rem] font-normal leading-relaxed text-bold-ink/65">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="faq" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">FAQ</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
          Straight answers about how supplier coordination actually works.
        </h2>
      </div>

      <div data-reveal class="reveal-item mt-12 overflow-hidden rounded-2xl border border-bold-ink/10 bg-bold-paper shadow-[0_24px_48px_-30px_rgba(46,22,48,0.25)]" data-faq-list style="transition-delay: 100ms">
        {faqs.map((faq, i) => (
          <>
            <button
              type="button"
              class={`bold-faq-row flex w-full items-center justify-between gap-6 px-7 py-6 text-left hover:bg-bold-ink/[0.025] ${i > 0 ? "border-t border-bold-ink/10" : ""}`}
              aria-expanded={i === 0 ? "true" : "false"}
              aria-controls={`faq-answer-${i}`}
            >
              <span class="text-[0.98rem] font-semibold text-bold-ink">{faq.question}</span>
              <span class="bold-faq-chevron-ring flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-bold-ink/10">
                <svg class="bold-faq-chevron h-4 w-4 text-bold-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </span>
            </button>
            <div id={`faq-answer-${i}`} class="bold-faq-panel" aria-hidden={i === 0 ? "false" : "true"}>
              <div class="px-7">
                <p class="max-w-2xl text-[0.92rem] font-normal leading-relaxed text-bold-ink/65">{faq.answer}</p>
              </div>
            </div>
          </>
        ))}
      </div>
    </div>
  </section>

  <Cta />
</BaseLayout>

<style>
  .what-ambient-blob {
    position: absolute;
    top: -10%;
    right: -6%;
    width: 28vw;
    height: 28vw;
    max-width: 380px;
    max-height: 380px;
    border-radius: 9999px;
    filter: blur(80px);
    background: radial-gradient(circle, rgba(110, 156, 163, 0.16) 0%, transparent 70%);
  }

  .how-ambient-blob {
    position: absolute;
    bottom: -15%;
    left: -6%;
    width: 28vw;
    height: 28vw;
    max-width: 380px;
    max-height: 380px;
    border-radius: 9999px;
    filter: blur(80px);
    background: radial-gradient(circle, rgba(110, 156, 163, 0.14) 0%, transparent 70%);
  }
</style>

<script>
  import "../scripts/scrollReveal"
  import "../scripts/sectionIconDrift"
  import "../scripts/faqAccordion"
  import "../scripts/cardTilt"
  import "../scripts/magneticButton"
  import "../scripts/supplierPing"
</script>
