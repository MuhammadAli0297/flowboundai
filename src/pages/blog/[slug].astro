---
import { getCollection, render } from "astro:content"
import BaseLayout from "../../layouts/BaseLayout.astro"
import SectionIcon from "../../components/icons/SectionIcon.astro"
import { slugifyTag } from "../../lib/tags"
import { parseFaqFromMarkdown } from "../../lib/faq"
import { categoryIcon, categoryTint, categoryDeep } from "../../data/blogCategories"

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft)
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }))
}

const { post, allPosts } = Astro.props
const { Content } = await render(post)

const siteUrl = Astro.site!.toString().replace(/\/$/, "")

const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })

const readTime = (p: typeof post) =>
  Math.max(1, Math.round((p.body ?? "").trim().split(/\s+/).length / 200))

// Cross-linking for the "Related posts" strip: same category outranks a shared tag, ties broken by
// most recent, so every post ends up with real click-through paths into the rest of the blog rather
// than a dead end at the bottom of the article.
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id)
  .map((p) => {
    let score = 0
    if (p.data.category === post.data.category) score += 10
    score += p.data.tags.filter((tag) => post.data.tags.includes(tag)).length * 3
    return { post: p, score }
  })
  .sort((a, b) => b.score - a.score || b.post.data.publishDate.valueOf() - a.post.data.publishDate.valueOf())
  .slice(0, 3)
  .map(({ post }) => post)

const faqs = parseFaqFromMarkdown(post.body ?? "")

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.publishDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.publishDate).toISOString(),
    author: {
      "@type": "Person",
      name: post.data.author,
      ...(post.data.authorTitle ? { jobTitle: post.data.authorTitle } : {}),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Blog", item: `${siteUrl}/blog/` },
      { "@type": "ListItem", position: 2, name: post.data.title, item: `${siteUrl}/blog/${post.id}/` },
    ],
  },
  // Every post's "## FAQ" Markdown section already has real Q&A content (see CLAUDE.md's internal-
  // linking note); this just wraps it in FAQPage schema, parsed straight from post.body rather than
  // duplicated into frontmatter. Omitted entirely if a post has no FAQ section, rather than shipping
  // an empty/invalid FAQPage block.
  ...(faqs.length > 0
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: faqs.map((faq) => ({
            "@type": "Question",
            name: faq.question,
            acceptedAnswer: { "@type": "Answer", text: faq.answer },
          })),
        },
      ]
    : []),
]
---

<BaseLayout
  title={`${post.data.title} | Flowbound`}
  description={post.data.description}
  path={`/blog/${post.id}`}
  ogImage={post.data.ogImage ?? `/og/${post.id}.png`}
  schema={schema}
>
  <section class="relative overflow-hidden bg-bold-paper bg-grain py-20 font-hanken md:py-28">
    <article class="container-fb relative max-w-2xl">
      <a href="/blog/" data-back-to-blog class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-bold-mint-deep hover:underline">
        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M11 6l-6 6 6 6" />
        </svg>
        Back to Blog
      </a>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <span class="rounded-full border border-bold-ink/15 px-2 py-0.5 font-mono text-[0.65rem] uppercase tracking-wider text-bold-taupe">
          {post.data.category}
        </span>
        <p class="font-mono text-xs uppercase tracking-wider text-bold-ink/40">
          {post.data.publishDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })}
        </p>
        <span class="text-bold-ink/20">&middot;</span>
        <p class="font-mono text-xs uppercase tracking-wider text-bold-ink/40">
          By {post.data.author}{post.data.authorTitle && `, ${post.data.authorTitle}`}
        </p>
      </div>
      <h1 class="font-hanken mt-4 text-[2rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.4rem]">
        {post.data.title}
      </h1>

      <div class="bold-prose prose prose-neutral mt-10 max-w-none prose-headings:font-hanken prose-headings:font-semibold">
        <Content />
      </div>

      <div class="mt-14 flex flex-wrap items-center justify-between gap-6 border-t border-bold-ink/10 pt-6">
        {post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-3">
            {post.data.tags.map((tag) => (
              <a href={`/blog/tags/${slugifyTag(tag)}/`} class="font-mono text-xs uppercase tracking-wider text-bold-mint-deep hover:underline">
                #{tag}
              </a>
            ))}
          </div>
        )}
        <a href="/blog/" data-back-to-blog class="inline-flex items-center gap-2 text-sm font-medium text-bold-mint-deep hover:underline">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5M11 6l-6 6 6 6" />
          </svg>
          Back to Blog
        </a>
      </div>
    </article>
  </section>

  {relatedPosts.length > 0 && (
    <section class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper bg-grain py-16 font-hanken md:py-20">
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <span class="related-ambient-blob"></span>
      </div>
      <div class="container-fb relative max-w-2xl">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-bold-ink">Related reading</p>
        <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-3">
          {relatedPosts.map((related, i) => {
            const tint = categoryTint(related.data.category)
            const deep = categoryDeep(related.data.category)
            return (
              <div data-reveal class="reveal-item h-full" style={`transition-delay: ${i * 90}ms`}>
                <a
                  href={`/blog/${related.id}/`}
                  class="bold-post-card group relative flex h-full flex-col rounded-2xl p-5"
                  style={`--cat-tint: ${tint}; --cat-deep: ${deep};`}
                >
                  <SectionIcon name={categoryIcon(related.data.category)} class="bold-post-watermark" />
                  <span class="bold-post-label mb-3.5 inline-flex flex-col gap-1.5 font-mono text-[0.8rem] font-bold leading-none">
                    <span class="flex items-center gap-1.5">
                      <span class="h-1.5 w-1.5 shrink-0 rounded-full" style={`background: ${deep}`} />
                      {related.data.category}
                    </span>
                    <span class="bold-post-rule ml-[13px] h-0.5 w-5 rounded-full opacity-60" />
                  </span>
                  <h3 class="font-hanken text-[1.05rem] font-medium leading-snug text-bold-ink group-hover:text-bold-mint-deep">
                    {related.data.title}
                  </h3>
                  <p class="mt-2 line-clamp-2 flex-1 text-[0.85rem] leading-relaxed text-bold-ink/65">
                    {related.data.excerpt}
                  </p>
                  <div class="bold-post-foot mt-4 flex items-center gap-2 border-t pt-3 font-mono text-[0.65rem] uppercase tracking-wider text-bold-ink/40">
                    <span>{formatDate(related.data.publishDate)}</span>
                    <span aria-hidden="true">&middot;</span>
                    <svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.5 2" /></svg>
                    <span>{readTime(related)} min read</span>
                  </div>
                </a>
              </div>
            )
          })}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  import "../../scripts/scrollReveal"
  import "../../scripts/blogBackLink"
</script>

<style>
  /* Repoint @tailwindcss/typography's CSS-variable color hooks at the Bold palette instead of its
     default gray scale, so post body copy reads as part of this page's system rather than a leftover
     neutral prose theme. bold-ink for body/headings matches the verified-contrast text color used
     everywhere else on bold-paper (see CLAUDE.md's contrast note); bold-mint-deep for links clears
     ~4.8:1 against bold-paper, the same light-surface accent pairing used sitewide. */
  .bold-prose {
    --tw-prose-body: #2e1630;
    --tw-prose-headings: #2e1630;
    --tw-prose-lead: #2e1630;
    --tw-prose-links: #1a7a64;
    --tw-prose-bold: #2e1630;
    --tw-prose-counters: #6e5a52;
    --tw-prose-bullets: #c9efe6;
    --tw-prose-hr: rgba(110, 90, 82, 0.2);
    --tw-prose-quotes: #2e1630;
    --tw-prose-quote-borders: #6e5a52;
    --tw-prose-captions: #2e1630;
    --tw-prose-code: #2e1630;
    --tw-prose-pre-code: #eff7f2;
    --tw-prose-pre-bg: #2e1630;
    --tw-prose-th-borders: rgba(110, 90, 82, 0.2);
    --tw-prose-td-borders: rgba(110, 90, 82, 0.12);
  }

  .related-ambient-blob {
    position: absolute;
    top: -10%;
    right: -6%;
    width: 28vw;
    height: 28vw;
    max-width: 380px;
    max-height: 380px;
    border-radius: 9999px;
    filter: blur(80px);
    background: radial-gradient(circle, rgba(110, 156, 163, 0.14) 0%, transparent 70%);
  }
</style>
