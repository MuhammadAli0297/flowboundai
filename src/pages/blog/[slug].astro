---
import { getCollection, render } from "astro:content"
import BaseLayout from "../../layouts/BaseLayout.astro"
import BlogThumbnail from "../../components/BlogThumbnail.astro"
import { slugifyTag } from "../../lib/tags"
import { parseFaqFromMarkdown } from "../../lib/faq"

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft)
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }))
}

const { post, allPosts } = Astro.props
const { Content } = await render(post)

const siteUrl = Astro.site!.toString().replace(/\/$/, "")

const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })

// Cross-linking for the "Related posts" strip: same category outranks a shared tag, ties broken by
// most recent, so every post ends up with real click-through paths into the rest of the blog rather
// than a dead end at the bottom of the article.
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id)
  .map((p) => {
    let score = 0
    if (p.data.category === post.data.category) score += 10
    score += p.data.tags.filter((tag) => post.data.tags.includes(tag)).length * 3
    return { post: p, score }
  })
  .sort((a, b) => b.score - a.score || b.post.data.publishDate.valueOf() - a.post.data.publishDate.valueOf())
  .slice(0, 3)
  .map(({ post }) => post)

const faqs = parseFaqFromMarkdown(post.body ?? "")

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.publishDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.publishDate).toISOString(),
    author: { "@type": "Organization", name: post.data.author },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Blog", item: `${siteUrl}/blog/` },
      { "@type": "ListItem", position: 2, name: post.data.title, item: `${siteUrl}/blog/${post.id}/` },
    ],
  },
  // Every post's "## FAQ" Markdown section already has real Q&A content (see CLAUDE.md's internal-
  // linking note); this just wraps it in FAQPage schema, parsed straight from post.body rather than
  // duplicated into frontmatter. Omitted entirely if a post has no FAQ section, rather than shipping
  // an empty/invalid FAQPage block.
  ...(faqs.length > 0
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: faqs.map((faq) => ({
            "@type": "Question",
            name: faq.question,
            acceptedAnswer: { "@type": "Answer", text: faq.answer },
          })),
        },
      ]
    : []),
]
---

<BaseLayout
  title={`${post.data.title} | Flowbound`}
  description={post.data.description}
  path={`/blog/${post.id}`}
  ogImage={post.data.ogImage ?? `/og/${post.id}.png`}
  schema={schema}
>
  <section class="bg-ocean-100 bg-grain py-20 font-amulya md:py-28">
    <article class="container-fb max-w-2xl">
      <a href="/blog/" data-back-to-blog class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-ocean-600 hover:underline">
        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M11 6l-6 6 6 6" />
        </svg>
        Back to Blog
      </a>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <span class="border border-ocean-700/20 px-2 py-0.5 font-mono text-[0.65rem] uppercase tracking-wider text-ocean-600">
          {post.data.category}
        </span>
        <p class="font-mono text-xs uppercase tracking-wider text-ocean-950/40">
          {post.data.publishDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })}
        </p>
      </div>
      <h1 class="mt-4 font-amulya text-[2rem] font-semibold leading-tight tracking-tighter text-ocean-950 md:text-[2.4rem]">
        {post.data.title}
      </h1>

      <div class="ocean-prose prose prose-neutral mt-10 max-w-none prose-headings:font-amulya prose-headings:font-semibold">
        <Content />
      </div>

      <div class="mt-14 flex flex-wrap items-center justify-between gap-6 border-t border-ocean-700/15 pt-6">
        {post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-3">
            {post.data.tags.map((tag) => (
              <a href={`/blog/tags/${slugifyTag(tag)}/`} class="font-mono text-xs uppercase tracking-wider text-ocean-600 hover:underline">
                #{tag}
              </a>
            ))}
          </div>
        )}
        <a href="/blog/" data-back-to-blog class="inline-flex items-center gap-2 text-sm font-medium text-ocean-600 hover:underline">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5M11 6l-6 6 6 6" />
          </svg>
          Back to Blog
        </a>
      </div>
    </article>
  </section>

  {relatedPosts.length > 0 && (
    <section class="border-t border-ocean-700/15 bg-ocean-200 bg-grain py-16 font-amulya md:py-20">
      <div class="container-fb max-w-2xl">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-ocean-950">Related reading</p>
        <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-3">
          {relatedPosts.map((related, i) => (
            <div data-reveal class="reveal-item h-full" style={`transition-delay: ${i * 90}ms`}>
              <a
                href={`/blog/${related.id}/`}
                data-tilt
                class="tilt-card group relative z-10 flex h-full flex-col overflow-hidden border border-ocean-700/20 bg-ocean-100 transition-colors duration-500 ease-out hover:border-ocean-700/45"
              >
                <BlogThumbnail category={related.data.category} class="aspect-[16/10] w-full" />
                <div class="flex flex-1 flex-col p-4">
                  <span class="font-mono text-[0.65rem] uppercase tracking-wider text-ocean-950/35">
                    {formatDate(related.data.publishDate)}
                  </span>
                  <h3 class="mt-2 font-amulya text-[0.95rem] font-medium leading-snug text-ocean-950 group-hover:text-ocean-600">
                    {related.data.title}
                  </h3>
                </div>
                <div class="absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-ocean-500 transition-transform duration-500 ease-out group-hover:scale-x-100" />
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  import "../../scripts/hoverGlow"
  import "../../scripts/cardTilt"
  import "../../scripts/scrollReveal"
  import "../../scripts/blogBackLink"
</script>

<style>
  /* Repoint @tailwindcss/typography's CSS-variable color hooks at the ocean palette instead of its
     default gray scale, so post body copy reads as part of this page's system rather than a leftover
     neutral prose theme. ocean-950 for body/headings matches the verified-contrast text color used
     everywhere else ocean-950 sits on ocean-100/200 (see CLAUDE.md's contrast note). */
  .ocean-prose {
    --tw-prose-body: #104866;
    --tw-prose-headings: #104866;
    --tw-prose-lead: #104866;
    --tw-prose-links: #4c6e92;
    --tw-prose-bold: #104866;
    --tw-prose-counters: #4f6d7a;
    --tw-prose-bullets: #c0d6df;
    --tw-prose-hr: rgba(79, 109, 122, 0.2);
    --tw-prose-quotes: #104866;
    --tw-prose-quote-borders: #4f6d7a;
    --tw-prose-captions: #104866;
    --tw-prose-code: #104866;
    --tw-prose-pre-code: #dbe9ee;
    --tw-prose-pre-bg: #166088;
    --tw-prose-th-borders: rgba(79, 109, 122, 0.2);
    --tw-prose-td-borders: rgba(79, 109, 122, 0.12);
  }
</style>
