---
// Hot Sauce rebuild, checklist item 16: the blog index + pagination moves off the dark ocean-900
// canvas hero (BlogBackground.astro, "Insight Stream") onto the standard light grain+orb +
// bold-glass hero every other converted page uses. BlogBackground.astro is left on disk unused,
// same precedent as every other retired *Background.astro file. There's no dedicated Signal
// Primitives widget assigned to the blog (it was never part of that lab's scope), so the hero
// panel shows real, non-animated content instead: the actual latest post, pulled from the same
// sorted `allPosts` array the rest of the page already uses, not an invented widget.
//
// Post cards drop the ocean-era hoverGlow/cardTilt mouse-glow+tilt mechanic (already removed from
// every other converted page's grids, see CLAUDE.md's /services note). Card treatment itself is
// "Duotone Wash + Big Label" (see CLAUDE.md), picked from three mocked options: a soft two-stop
// gradient wash of the post's category color, a bold mono label with an underline rule, and a
// large rotated watermark icon, all via the shared .bold-post-card class in index.css. The old
// single-hex `accent` per category (muted, tuned for the pre-Bold ocean palette) is gone, replaced
// by blogCategories.ts' recalculated `tint`/`deep` pair, each `deep` independently checked at
// 4.5:1+ against bold-paper.
import type { GetStaticPaths } from "astro"
import { getCollection } from "astro:content"
import BaseLayout from "../../layouts/BaseLayout.astro"
import SectionIcon from "../../components/icons/SectionIcon.astro"
import Cta from "../../components/Cta.astro"
import { blogCategories, categoryIcon, categoryTint, categoryDeep } from "../../data/blogCategories"

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
  )

  const categoriesWithCounts = blogCategories.map((c) => ({
    ...c,
    count: posts.filter((p) => p.data.category === c.name).length,
  }))

  return paginate(posts, { pageSize: 9, props: { categoriesWithCounts, allPosts: posts } })
}) satisfies GetStaticPaths

const { page, categoriesWithCounts, allPosts } = Astro.props

const currentPageIds = new Set(page.data.map((p) => p.id))
const latestPost = allPosts[0]

const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })

const searchIndex = (post: (typeof allPosts)[number]) =>
  [post.data.title, post.data.description, post.data.category, ...post.data.tags].join(" ").toLowerCase()

const readTime = (post: (typeof allPosts)[number]) =>
  Math.max(1, Math.round((post.body ?? "").trim().split(/\s+/).length / 200))

// Numbered page links, not just prev/next, so jumping from page 4 back to page 1 (or
// anywhere else) is a single click instead of paging back one at a time. Small page
// counts (<=7, comfortably true at this post volume) show every number; beyond that,
// only the first, last, and a window around the current page show, with an ellipsis
// for the gap, the standard pattern for when the blog scales into many more pages.
function paginationRange(current: number, last: number): (number | "…")[] {
  if (last <= 7) return Array.from({ length: last }, (_, i) => i + 1)
  const delta = 1
  const middle: number[] = []
  for (let i = Math.max(2, current - delta); i <= Math.min(last - 1, current + delta); i++) middle.push(i)
  const range: (number | "…")[] = [1]
  if (middle[0] > 2) range.push("…")
  range.push(...middle)
  if (middle[middle.length - 1] < last - 1) range.push("…")
  range.push(last)
  return range
}
// #posts anchors every pagination link at the filter bar/grid instead of the hero, so clicking a
// page number or Newer/Older doesn't dump the reader back at the top of the page to re-scroll past
// the hero every time, direct feedback: "dont go to the top of the blog page, go to the filters."
// Native browser anchor-scroll on page load, no JS needed; #posts carries its own scroll-mt-20 (see
// the section below) so the sticky nav doesn't cover the filter bar once it lands.
const pageHref = (n: number) => (n === 1 ? "/blog/#posts" : `/blog/${n}/#posts`)
---

<BaseLayout
  title={page.currentPage === 1 ? "Blog | Flowbound" : `Blog | Page ${page.currentPage} | Flowbound`}
  description="Supply chain and inventory management insights for small and mid-sized businesses."
  path="/blog"
>
  <section id="top" class="relative overflow-hidden bg-bold-paper py-24 pt-28 font-hanken md:py-32 md:pt-36">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <span class="bold-orb" style="width:20rem;height:20rem;top:-7rem;right:-4rem;background:#8FE3D3;opacity:0.31;" />
      <span class="bold-orb" style="width:16rem;height:16rem;top:5rem;right:16rem;background:#C998CD;opacity:0.27;" />
    </div>

    <div class="container-fb relative">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-10">
        <div>
          <div data-reveal class="reveal-item mb-5 flex items-center gap-3">
            <SectionIcon name="document" class="h-6 w-6 text-bold-mint-deep" />
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">Blog</p>
          </div>
          <h1 data-reveal class="font-hanken reveal-item max-w-2xl text-[2.5rem] font-bold leading-[1.08] tracking-tighter text-bold-ink md:text-[3.2rem]" style="transition-delay: 60ms">
            Supply chain insights for <em class="font-instrument font-normal italic text-bold-mint-deep">small business</em> teams.
          </h1>
          <p data-reveal class="reveal-item mt-6 max-w-lg text-[1.05rem] font-normal leading-relaxed text-bold-ink/70" style="transition-delay: 120ms">
            Practical, plain-language write-ups on inventory, suppliers, and the decisions that eat up an
            operator's week. Written for people running the business, not for a procurement committee.
          </p>
          <div data-reveal class="reveal-item mt-9 flex flex-wrap items-center gap-4" style="transition-delay: 180ms">
            <a href="#posts" data-magnetic class="bold-btn bold-btn-primary bold-btn-md group">
              <span class="relative z-10">Read the latest</span>
              <span aria-hidden="true" class="relative z-10 transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
            </a>
            <a href="#cta" data-magnetic class="bold-btn bold-btn-secondary bold-btn-md group">
              <span class="relative z-10">Request a pilot</span>
              <span aria-hidden="true" class="relative z-10 transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
            </a>
          </div>
        </div>

        {latestPost && (
          <a
            href={`/blog/${latestPost.id}/`}
            data-reveal
            class="reveal-item bold-glass block rounded-2xl p-5 transition-transform duration-300 hover:-translate-y-0.5"
            style="transition-delay: 240ms"
          >
            <div class="mb-3.5 flex items-center justify-between font-mono text-xs uppercase tracking-[0.05em] text-bold-taupe">
              <span class="flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full bg-bold-mint-deep" aria-hidden="true" />
                Latest post
              </span>
              <span>{latestPost.data.category}</span>
            </div>
            <h3 class="font-hanken text-[1.1rem] font-semibold leading-snug text-bold-ink">
              {latestPost.data.title}
            </h3>
            <p class="mt-2 line-clamp-2 text-[0.85rem] leading-relaxed text-bold-ink/65">
              {latestPost.data.excerpt}
            </p>
            <div class="mt-4 flex items-center justify-between border-t border-bold-ink/10 pt-3 font-mono text-[0.65rem] uppercase tracking-wider text-bold-ink/40">
              <span>{formatDate(latestPost.data.publishDate)}</span>
              <span>{readTime(latestPost)} min read</span>
            </div>
          </a>
        )}
      </div>
    </div>
  </section>

  <section id="posts" class="relative scroll-mt-20 overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <span class="posts-ambient-blob"></span>
    </div>
    <div class="container-fb relative">
      <div class="mb-10 flex flex-col gap-5 border-b border-bold-ink/10 pb-8">
        <div class="relative w-full max-w-xs">
          <label class="sr-only" for="blog-search">Search posts</label>
          <input
            id="blog-search"
            type="text"
            placeholder="Search posts"
            data-blog-search
            class="w-full rounded-full border border-bold-ink/15 bg-bold-paper px-4 py-2.5 pr-10 text-sm text-bold-ink placeholder:text-bold-ink/40 focus:border-bold-mint-deep focus:outline-none"
          />
          <svg
            class="pointer-events-none absolute right-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-bold-ink/35"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.2-3.2" />
          </svg>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          {categoriesWithCounts.map((c) => (
            <button
              type="button"
              data-category-filter
              value={c.name}
              aria-pressed="false"
              class="category-pill inline-flex shrink-0 items-center gap-2 rounded-full border border-bold-ink/15 bg-bold-paper px-3.5 py-1.5 font-mono text-xs text-bold-ink/70 transition-colors duration-200 hover:border-bold-ink/35 hover:text-bold-ink"
              style={`--cat-deep: ${c.deep};`}
            >
              <span class="pill-dot h-1.5 w-1.5 shrink-0 rounded-full" style={`background: ${c.deep}`} />
              {c.name}
              <span class="pill-count text-bold-ink/35">{c.count}</span>
            </button>
          ))}
          <button
            type="button"
            data-blog-reset
            class="inline-flex shrink-0 items-center gap-1.5 font-mono text-xs uppercase tracking-wider text-bold-mint-deep hover:underline"
          >
            Reset
          </button>
        </div>
      </div>

      <p data-blog-results-count class="mb-8 font-mono text-xs uppercase tracking-wider text-bold-ink/40">
        {page.data.length} of {allPosts.length} posts
      </p>

      <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {allPosts.map((post, i) => {
            const isCurrentPage = currentPageIds.has(post.id)
            const tint = categoryTint(post.data.category)
            const deep = categoryDeep(post.data.category)
            return (
              <li
                data-post-card
                data-current-page={isCurrentPage ? "true" : "false"}
                data-category={post.data.category}
                data-search={searchIndex(post)}
                class={isCurrentPage ? "" : "hidden"}
              >
                <div data-reveal class="reveal-item h-full" style={`transition-delay: ${(i % 3) * 90}ms`}>
                  <a
                    href={`/blog/${post.id}/`}
                    class="bold-post-card group relative flex h-full flex-col rounded-2xl p-5"
                    style={`--cat-tint: ${tint}; --cat-deep: ${deep};`}
                  >
                    <SectionIcon name={categoryIcon(post.data.category)} class="bold-post-watermark" />
                    <span class="bold-post-label mb-3.5 inline-flex flex-col gap-1.5 font-mono text-[0.8rem] font-bold leading-none">
                      <span class="flex items-center gap-1.5">
                        <span class="h-1.5 w-1.5 shrink-0 rounded-full" style={`background: ${deep}`} />
                        {post.data.category}
                      </span>
                      <span class="bold-post-rule ml-[13px] h-0.5 w-5 rounded-full opacity-60" />
                    </span>
                    <h2 class="font-hanken text-[1.05rem] font-medium leading-snug text-bold-ink group-hover:text-bold-mint-deep">
                      {post.data.title}
                    </h2>
                    <p class="mt-2 line-clamp-2 flex-1 text-[0.85rem] leading-relaxed text-bold-ink/65">
                      {post.data.excerpt}
                    </p>
                    <div class="bold-post-foot mt-4 flex items-center gap-2 border-t pt-3 font-mono text-[0.65rem] uppercase tracking-wider text-bold-ink/40">
                      <span>{formatDate(post.data.publishDate)}</span>
                      <span aria-hidden="true">&middot;</span>
                      <svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.5 2" /></svg>
                      <span>{readTime(post)} min read</span>
                    </div>
                  </a>
                </div>
              </li>
            )
          })}
      </ul>

      <p data-blog-empty-state class="mt-14 hidden text-sm text-bold-ink/50">
        No posts match your filters.
      </p>

      {page.lastPage > 1 && (
        <div data-blog-pagination class="mt-14 flex flex-col items-center gap-5 border-t border-bold-ink/10 pt-8 sm:flex-row sm:justify-between">
          {page.url.prev ? (
            <a href={`${page.url.prev}#posts`} class="pagination-pill group inline-flex shrink-0 items-center gap-2 rounded-full border border-bold-ink/15 bg-bold-paper px-4 py-2 font-mono text-xs uppercase tracking-wider text-bold-ink/70 transition-all duration-200 hover:border-bold-mint-deep hover:text-bold-mint-deep">
              <span aria-hidden="true" class="transition-transform duration-200 group-hover:-translate-x-0.5">&larr;</span>
              Newer
            </a>
          ) : (
            <span class="inline-flex shrink-0 items-center gap-2 rounded-full border border-bold-ink/8 px-4 py-2 font-mono text-xs uppercase tracking-wider text-bold-ink/25">
              &larr; Newer
            </span>
          )}

          <div class="flex items-center gap-2">
            {paginationRange(page.currentPage, page.lastPage).map((p) =>
              p === "…" ? (
                <span class="px-1 font-mono text-xs text-bold-ink/35">&hellip;</span>
              ) : (
                <a
                  href={pageHref(p)}
                  aria-current={p === page.currentPage ? "page" : undefined}
                  class={`pagination-pill flex h-9 w-9 items-center justify-center rounded-full border font-mono text-xs transition-all duration-200 ${
                    p === page.currentPage
                      ? "border-bold-mint-deep bg-bold-mint-deep text-bold-paper"
                      : "border-bold-ink/15 text-bold-taupe hover:border-bold-mint-deep hover:text-bold-mint-deep"
                  }`}
                >
                  {p}
                </a>
              ),
            )}
          </div>

          {page.url.next ? (
            <a href={`${page.url.next}#posts`} class="pagination-pill group inline-flex shrink-0 items-center gap-2 rounded-full border border-bold-ink/15 bg-bold-paper px-4 py-2 font-mono text-xs uppercase tracking-wider text-bold-ink/70 transition-all duration-200 hover:border-bold-mint-deep hover:text-bold-mint-deep">
              Older
              <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-0.5">&rarr;</span>
            </a>
          ) : (
            <span class="inline-flex shrink-0 items-center gap-2 rounded-full border border-bold-ink/8 px-4 py-2 font-mono text-xs uppercase tracking-wider text-bold-ink/25">
              Older &rarr;
            </span>
          )}
        </div>
      )}
    </div>
  </section>

  <Cta />
</BaseLayout>

<script>
  import "../../scripts/blogFilter"
  import "../../scripts/scrollReveal"
  import "../../scripts/magneticButton"
</script>

<style>
  .posts-ambient-blob {
    position: absolute;
    top: -8%;
    right: -6%;
    width: 28vw;
    height: 28vw;
    max-width: 380px;
    max-height: 380px;
    border-radius: 9999px;
    filter: blur(80px);
    background: radial-gradient(circle, rgba(110, 156, 163, 0.16) 0%, transparent 70%);
  }
</style>
