---
// Hot Sauce rebuild, checklist item 4: the second capability-template page, following /reorder's
// approved shape (see CLAUDE.md "Checkpoint 3" and the Signal Primitives merge notes) rather than
// re-deriving it: grain+orb hero whose glass panel IS this page's assigned widget (Forecast
// Spark), "what it is" with an icon-drift watermark, "what it does" as one featured
// glass+gradient-ring tile plus a quiet ink-tint grid, "what it watches" as a plain signal list on
// a bold-depth-ink dark section, "how it works" as plain quiet tiles, and the luxurious
// .bold-faq-row/.bold-faq-panel accordion. All copy/schema content carried over unchanged from the
// prior ocean-palette build, it was already accurate to services.ts, only the visual system and
// the widget/glass-panel additions are new.
//
// The hero's glass panel went through one revision before this page was ever shown: the first
// draft reused the homepage's generic live-data-rows template verbatim (different copy, identical
// structure, same bug /reorder's hero shipped with), which reads as the same image as every other
// hero at a glance. Fixed by making the panel BE the Forecast Spark widget itself, not a list.
import BaseLayout from "../layouts/BaseLayout.astro"
import Cta from "../components/Cta.astro"
import SectionIcon from "../components/icons/SectionIcon.astro"
import Breadcrumbs from "../components/Breadcrumbs.astro"
import { buildBreadcrumbSchema } from "../lib/breadcrumbs"

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Services", path: "/services" },
  { name: "Demand Forecasting", path: "/demand-forecasting" },
]
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbItems, Astro.site!)

const capabilities = [
  {
    title: "Learns Your Sales Patterns",
    description:
      "Flowbound looks at your actual sales history and seasonality, not an industry average, to build a forecast that reflects how your specific catalog actually moves.",
  },
  {
    title: "Accounts for Lead Times",
    description:
      "Every forecast factors in how long it actually takes a supplier to deliver, so the reorder point accounts for the wait, not just the sales curve.",
  },
  {
    title: "Flags Bestsellers Before They Run Out",
    description:
      "The moment a SKU is trending toward a stockout, Flowbound tells you, with enough lead time to actually do something about it.",
  },
  {
    title: "Flags Dead Stock Early",
    description:
      "Slow-moving inventory gets flagged early too, so cash isn't sitting in a corner of the warehouse nobody's watching.",
  },
  {
    title: "Adjusts as Reality Changes",
    description:
      "A late shipment, a slow week, a surprise spike: the forecast recalculates continuously instead of waiting for a monthly review to catch up.",
  },
  {
    title: "Covers Every SKU, Not Just the Top Sellers",
    description:
      "The same model runs across your whole catalog, so the slow-moving, easy-to-forget SKUs get the same attention as your bestsellers.",
  },
]

const signals = [
  "Sales velocity by SKU",
  "Seasonality and trend patterns",
  "Supplier lead times",
  "Current on-hand stock",
  "Incoming purchase orders",
  "Promotional and sales calendar",
  "Return and cancellation rates",
  "Channel mix across storefronts",
]

const steps = [
  {
    n: "01",
    title: "It learns your baseline",
    body: "Flowbound ingests your sales history and seasonality patterns to build a baseline forecast for every SKU, not just your top movers.",
  },
  {
    n: "02",
    title: "It factors in lead time and stock on hand",
    body: "The forecast is checked against what's already on hand, what's incoming, and how long a reorder actually takes to arrive.",
  },
  {
    n: "03",
    title: "It tells you what to reorder, and when",
    body: "You get a straight recommendation on quantity and timing, no spreadsheet to build and no report to wait on.",
  },
]

const faqs = [
  {
    question: "What data does the forecast actually use?",
    answer:
      "Your own sales history, seasonality, and each supplier's lead time, not an industry average. That's what lets it reflect how your specific catalog actually moves.",
  },
  {
    question: "How often does the forecast update?",
    answer:
      "Continuously. A late shipment, a slow week, or a surprise spike gets factored in right away instead of waiting for a monthly review to catch up.",
  },
  {
    question: "Does it forecast every SKU, or just the top sellers?",
    answer:
      "Every SKU in your catalog gets the same model, so slow-moving stock gets flagged as early as a bestseller trending toward a stockout.",
  },
  {
    question: "How does this connect to actually placing an order?",
    answer:
      "The forecast feeds directly into reorder timing and quantity, once you're ready to automate that step too.",
  },
]

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
}

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Demand Forecasting",
  name: "Demand Forecasting",
  description:
    "Flowbound's demand forecasting service predicts what a small or mid-sized business will need to reorder and when, using sales history, seasonality, and supplier lead times.",
  provider: { "@type": "Organization", name: "Flowbound" },
  audience: {
    "@type": "Audience",
    audienceType: "Small and mid-sized businesses",
  },
}
---

<BaseLayout
  title="Demand Forecasting Software | Flowbound"
  description="Flowbound's demand forecasting uses your sales history, seasonality, and supplier lead times to tell you what to reorder and when, no spreadsheet required."
  path="/demand-forecasting"
  schema={[schema, faqSchema, breadcrumbSchema]}
>
  <section id="top" class="relative overflow-hidden bg-bold-paper py-24 pt-28 font-hanken md:py-32 md:pt-36">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <span class="bold-orb" style="width:20rem;height:20rem;top:-8rem;right:-5rem;background:#8FE3D3;opacity:0.32;" />
      <span class="bold-orb" style="width:16rem;height:16rem;top:6rem;right:17rem;background:#C998CD;opacity:0.28;" />
    </div>

    <div class="container-fb relative">
      <Breadcrumbs items={breadcrumbItems} />

      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-10">
        <div>
          <div data-reveal class="reveal-item mb-5 flex items-center gap-3">
            <SectionIcon name="crate" class="h-6 w-6 text-bold-mint-deep" />
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">Demand Forecasting</p>
          </div>
          <h1 data-reveal class="font-hanken reveal-item max-w-2xl text-[2.5rem] font-bold leading-[1.08] tracking-tighter text-bold-ink md:text-[3.2rem]" style="transition-delay: 60ms">
            Know what you'll need before you run out, or <em class="font-instrument font-normal italic text-bold-mint-deep">overbuy</em>.
          </h1>
          <p data-reveal class="reveal-item mt-6 max-w-lg text-[1.05rem] font-normal leading-relaxed text-bold-ink/70" style="transition-delay: 120ms">
            Flowbound looks at your sales history, seasonality, and supplier lead times to tell you what you'll
            actually need to reorder and when, so you're not caught flat-footed on a bestseller or sitting on
            dead stock.
          </p>
          <div data-reveal class="reveal-item mt-9 flex flex-wrap items-center gap-4" style="transition-delay: 180ms">
            <a
              href="#cta"
              data-magnetic
              class="bold-btn bold-btn-primary bold-btn-md group"
            >
              <span class="relative z-10">Request a pilot</span>
              <span aria-hidden="true" class="relative z-10 transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
            </a>
            <a
              href="#how"
              data-magnetic
              class="bold-btn bold-btn-secondary bold-btn-md group"
            >
              <span class="relative z-10">See how it works</span>
              <span aria-hidden="true" class="relative z-10 transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
            </a>
          </div>
        </div>

        <div data-reveal class="reveal-item bold-glass rounded-2xl p-5" style="transition-delay: 240ms">
          <div class="mb-3.5 flex items-center justify-between font-mono text-xs uppercase tracking-[0.05em] text-bold-taupe">
            <span class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-bold-mint-deep" aria-hidden="true" />
              Live &middot; SKU&ndash;2208
            </span>
            <span>Demand forecast</span>
          </div>
          <svg viewBox="0 0 220 80" class="w-full" aria-hidden="true">
            <path class="spark-history" d="M6,58 L36,48 L66,52 L96,32"></path>
            <path class="spark-projected" d="M96,32 L140,24 L180,14 L214,8"></path>
            <circle class="spark-comet" r="3.2"></circle>
          </svg>
          <div class="mt-1 flex items-end justify-between">
            <span class="text-[1.9rem] font-bold text-bold-ink">+18%</span>
            <span class="font-mono text-xs text-bold-taupe">Week 42, projected</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="what" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <span class="what-ambient-blob"></span>
    </div>
    <div class="container-fb relative">
      <div class="flex items-start justify-between gap-8">
        <div class="reveal-item max-w-xl" data-reveal>
          <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">What it is</p>
          <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
            A forecast built from your numbers, not an industry average.
          </h2>
          <p class="mt-5 text-[0.98rem] font-normal leading-relaxed text-bold-ink/70">
            Demand forecasting is usually the first thing a small or mid-sized team gives up on: it takes a
            spreadsheet, a consultant, or both, and it's stale the moment something changes. Flowbound builds
            the forecast directly from your sales history, seasonality, and supplier lead times, and keeps it
            current automatically, so you always know what's coming without asking anyone to run the numbers.
          </p>
        </div>
        <div class="relative hidden shrink-0 md:block" data-icon-drift>
          <span class="icon-pulse-ring absolute inset-0 rounded-full border border-bold-ink/15" aria-hidden="true"></span>
          <SectionIcon name="crate" class="icon-spin relative h-[7.5rem] w-[7.5rem] text-bold-ink/20" />
        </div>
      </div>
    </div>
  </section>

  <section id="capabilities" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">What it does</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
          Built to catch a stockout or a pile of dead stock before it happens.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-3.5">
        <div data-reveal class="reveal-item">
          <div data-tilt class="tilt-card bold-tile-feature bold-glass rounded-2xl p-7 md:p-8">
            <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-bold-ink font-mono text-[0.65rem] font-bold text-bold-paper">01</span>
            <h3 class="font-hanken mt-3 text-[1.15rem] font-semibold text-bold-ink">{capabilities[0].title}</h3>
            <p class="mt-2 max-w-2xl text-[0.92rem] leading-relaxed text-bold-ink/65">{capabilities[0].description}</p>
          </div>
        </div>
        <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2 md:grid-cols-3">
          {capabilities.slice(1).map((capability, i) => (
            <div
              data-reveal
              class="reveal-item h-full rounded-2xl border border-bold-ink/8 bg-bold-paper p-6 transition-colors duration-300 hover:border-bold-ink/25 hover:bg-bold-ink/[0.04]"
              style={`transition-delay: ${(i + 1) * 70}ms`}
            >
              <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-bold-ink font-mono text-[0.65rem] font-bold text-bold-paper">{String(i + 2).padStart(2, "0")}</span>
              <h3 class="font-hanken mt-3 text-[0.95rem] font-semibold text-bold-ink">{capability.title}</h3>
              <p class="mt-2 text-[0.85rem] leading-relaxed text-bold-ink/65">{capability.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="signals" class="bold-depth-ink relative overflow-hidden py-20 font-hanken md:py-28">
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-mint">What it watches</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-paper md:text-[2.2rem]">
          Every signal that actually moves a forecast, checked continuously.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-2">
        {signals.map((signal, i) => (
          <div
            data-reveal
            class="reveal-item flex items-start gap-3 border border-bold-paper/15 bg-bold-paper/5 px-5 py-4"
            style={`transition-delay: ${(i % 4) * 70}ms`}
          >
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-bold-mint" aria-hidden="true" />
            <span class="text-[0.98rem] leading-snug text-bold-paper/80">{signal}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="how" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <span class="how-ambient-blob"></span>
    </div>
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">How it works</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
          From sales history to a reorder you can trust.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-3">
        {steps.map((s, i) => (
          <div
            data-reveal
            class="reveal-item h-full rounded-2xl border border-bold-ink/10 bg-bold-paper p-7 transition-colors duration-300 hover:border-bold-ink/25 hover:bg-bold-ink/[0.04]"
            style={`transition-delay: ${i * 90}ms`}
          >
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-bold-ink font-mono text-xs font-bold text-bold-paper">{s.n}</span>
            <h3 class="font-hanken mt-3 text-[1.05rem] font-medium leading-snug text-bold-ink">{s.title}</h3>
            <p class="mt-3 text-[0.92rem] font-normal leading-relaxed text-bold-ink/65">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="faq" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">FAQ</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
          Straight answers about how the forecast actually works.
        </h2>
      </div>

      <div data-reveal class="reveal-item mt-12 overflow-hidden rounded-2xl border border-bold-ink/10 bg-bold-paper shadow-[0_24px_48px_-30px_rgba(46,22,48,0.25)]" data-faq-list style="transition-delay: 100ms">
        {faqs.map((faq, i) => (
          <>
            <button
              type="button"
              class={`bold-faq-row flex w-full items-center justify-between gap-6 px-7 py-6 text-left hover:bg-bold-ink/[0.025] ${i > 0 ? "border-t border-bold-ink/10" : ""}`}
              aria-expanded={i === 0 ? "true" : "false"}
              aria-controls={`faq-answer-${i}`}
            >
              <span class="text-[0.98rem] font-semibold text-bold-ink">{faq.question}</span>
              <span class="bold-faq-chevron-ring flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-bold-ink/10">
                <svg class="bold-faq-chevron h-4 w-4 text-bold-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </span>
            </button>
            <div id={`faq-answer-${i}`} class="bold-faq-panel" aria-hidden={i === 0 ? "false" : "true"}>
              <div class="px-7">
                <p class="max-w-2xl text-[0.92rem] font-normal leading-relaxed text-bold-ink/65">{faq.answer}</p>
              </div>
            </div>
          </>
        ))}
      </div>
    </div>
  </section>

  <Cta />
</BaseLayout>

<style>
  .what-ambient-blob {
    position: absolute;
    top: -10%;
    right: -6%;
    width: 28vw;
    height: 28vw;
    max-width: 380px;
    max-height: 380px;
    border-radius: 9999px;
    filter: blur(80px);
    background: radial-gradient(circle, rgba(110, 156, 163, 0.16) 0%, transparent 70%);
  }

  .how-ambient-blob {
    position: absolute;
    bottom: -15%;
    left: -6%;
    width: 28vw;
    height: 28vw;
    max-width: 380px;
    max-height: 380px;
    border-radius: 9999px;
    filter: blur(80px);
    background: radial-gradient(circle, rgba(110, 156, 163, 0.14) 0%, transparent 70%);
  }
</style>

<script>
  import "../scripts/scrollReveal"
  import "../scripts/sectionIconDrift"
  import "../scripts/faqAccordion"
  import "../scripts/cardTilt"
  import "../scripts/magneticButton"
</script>
