---
// Hot Sauce rebuild, checklist item 10: the first whole-service narrative page (see the
// "Data-driven pages vs. narrative pages" note in CLAUDE.md: this page's content is inline, not
// services.ts-driven, and it has no FAQ section in its prior ocean-palette build either, unlike
// the 7 capability pages). Follows the same visual grammar as the capability-page template
// (grain+orb hero whose glass panel IS this page's assigned widget, icon-drift watermark, featured
// glass+gradient-ring tile + quiet ink-tint grid, a bold-depth-ink dark section, plain quiet-tile
// grid), but keeps this page's own 5-section shape: hero, what it is, what it does, "a few things
// teams ask" (the dark section, sample questions instead of watched signals), how it works, CTA.
// No FAQ section was invented; none existed in the prior build.
import BaseLayout from "../layouts/BaseLayout.astro"
import Cta from "../components/Cta.astro"
import SectionIcon from "../components/icons/SectionIcon.astro"
import Breadcrumbs from "../components/Breadcrumbs.astro"
import { buildBreadcrumbSchema } from "../lib/breadcrumbs"

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Services", path: "/services" },
  { name: "Ask Flowbound", path: "/ask-flowbound" },
]
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbItems, Astro.site!)

// The hero's Decision Feed widget: two question/answer pairs settle in, a third question fades in
// last without an answer yet, so the feed reads as live and ongoing rather than a finished log.
const feedEntries = [
  { role: "Q", text: "Which supplier had the worst on-time rate?" },
  { role: "A", text: "Supplier B, 71% on-time, down from 89%." },
  { role: "Q", text: "Do we have enough stock for the next 30 days?" },
]

const capabilities = [
  {
    title: "Ask, and Get an Answer",
    description:
      "Type a question about inventory, a supplier, an order, or a price, and get a straight answer pulled from your live data. No dashboard to dig through and no report to wait on.",
  },
  {
    title: "Embedded, Not Separate",
    description:
      "The agent lives inside the web app your team already uses every day. There's no extra tool to log into and nothing new to learn.",
  },
  {
    title: "Knows Your Business",
    description:
      "It answers from your actual numbers: your suppliers, your SKUs, your orders, not a generic help doc. Every answer is specific to your operation.",
  },
  {
    title: "Explains Its Reasoning",
    description:
      "Every answer comes with the why attached: which numbers it pulled, which SKU or supplier it's about, and what changed since last time. Nothing it tells you is a black box.",
  },
  {
    title: "Available Anytime",
    description:
      "There's no calendar to check and no consultant's hourly rate to watch. Ask first thing in the morning, ask again at close, ask the same question twice in a day.",
  },
  {
    title: "One Agent, Every Service",
    description:
      "The same agent that answers a quick question about a shipment is the one tracking your suppliers, placing reorders, and watching for quality issues. One system, not five tools stitched together.",
  },
]

const sampleQuestions = [
  "What's my reorder point for SKU-4482 right now?",
  "Which supplier had the worst on-time rate last quarter?",
  "Why did the sell price on this item change last week?",
  "What's the status of order #10293?",
  "Do we have enough stock to cover the next 30 days?",
  "Which wholesale accounts are overdue for a check-in?",
  "How many units shipped from Supplier B this month?",
  "Has this customer had a damage claim before?",
]

const steps = [
  {
    n: "01",
    title: "Ask in plain language",
    body: "Type the question right where your team already works, inside the app. No new tool to log into and nothing to learn first.",
  },
  {
    n: "02",
    title: "The agent checks your live data",
    body: "It pulls straight from your actual inventory, orders, suppliers, and shipments, not a cached report or a summary from last week.",
  },
  {
    n: "03",
    title: "Get an answer with the reasoning attached",
    body: "Every response explains what it looked at and why, so your team can trust the answer instead of double-checking it.",
  },
]

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Ask Flowbound",
  name: "Ask Flowbound",
  description:
    "An on-demand supply chain consultant embedded in the Flowbound web app, answering questions and pulling live data the moment a team asks for it.",
  provider: { "@type": "Organization", name: "Flowbound" },
  audience: {
    "@type": "Audience",
    audienceType: "Small and mid-sized businesses",
  },
}
---

<BaseLayout
  title="Ask Flowbound | On-Demand Supply Chain Consultant"
  description="Ask Flowbound is a supply chain consultant built into your web app, answering questions from your live data. No dashboard, no consultant required."
  path="/ask-flowbound"
  schema={[schema, breadcrumbSchema]}
>
  <section id="top" class="relative overflow-hidden bg-bold-paper py-24 pt-28 font-hanken md:py-32 md:pt-36">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <span class="bold-orb" style="width:21rem;height:21rem;top:-5rem;right:-4rem;background:#8FE3D3;opacity:0.34;" />
      <span class="bold-orb" style="width:18rem;height:18rem;top:9rem;right:22rem;background:#C998CD;opacity:0.26;" />
    </div>

    <div class="container-fb relative">
      <Breadcrumbs items={breadcrumbItems} />

      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-10">
        <div>
          <div data-reveal class="reveal-item mb-5 flex items-center gap-3">
            <SectionIcon name="spark" class="h-6 w-6 text-bold-mint-deep" />
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">Ask Flowbound</p>
          </div>
          <h1 data-reveal class="font-hanken reveal-item max-w-2xl text-[2.5rem] font-bold leading-[1.08] tracking-tighter text-bold-ink md:text-[3.2rem]" style="transition-delay: 60ms">
            A supply chain consultant that lives in your app, not on someone's <em class="font-instrument font-normal italic text-bold-mint-deep">calendar</em>.
          </h1>
          <p data-reveal class="reveal-item mt-6 max-w-lg text-[1.05rem] font-normal leading-relaxed text-bold-ink/70" style="transition-delay: 120ms">
            Every Flowbound service runs through the same agent. Ask it about inventory, a supplier, an order,
            or a price, and get a straight answer pulled from your live data, no dashboard to dig through and
            no consultant to schedule.
          </p>
          <div data-reveal class="reveal-item mt-9 flex flex-wrap items-center gap-4" style="transition-delay: 180ms">
            <a
              href="#cta"
              data-magnetic
              class="bold-btn bold-btn-primary bold-btn-md group"
            >
              <span class="relative z-10">Request a pilot</span>
              <span aria-hidden="true" class="relative z-10 transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
            </a>
            <a
              href="#how"
              data-magnetic
              class="bold-btn bold-btn-secondary bold-btn-md group"
            >
              <span class="relative z-10">See how it works</span>
              <span aria-hidden="true" class="relative z-10 transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
            </a>
          </div>
        </div>

        <div data-reveal class="reveal-item bold-glass rounded-2xl p-5" style="transition-delay: 240ms">
          <div class="mb-3.5 flex items-center justify-between font-mono text-xs uppercase tracking-[0.05em] text-bold-taupe">
            <span class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-bold-mint-deep" aria-hidden="true" />
              Live &middot; Ask Flowbound
            </span>
            <span>Decision feed</span>
          </div>
          <div id="feedWidget" class="feed-widget" aria-hidden="true">
            {feedEntries.map((entry, i) => (
              <div class="feed-row" style={`--step: ${i}`}>
                <span class={`feed-dot ${entry.role === "A" ? "is-answer" : ""}`} />
                <span class="text-[0.9rem] leading-snug text-bold-ink/75">
                  <strong class={`mr-1 font-mono text-[0.68rem] ${entry.role === "A" ? "text-bold-mint-deep" : "text-bold-taupe"}`}>{entry.role}</strong>
                  {entry.text}
                </span>
              </div>
            ))}
          </div>
          <div class="mt-4 flex items-end justify-between">
            <span class="text-[0.95rem] font-bold text-bold-ink">3 questions today</span>
            <span id="feedBadge" class="rounded-full bg-bold-mint-deep px-2.5 py-0.5 font-mono text-xs font-bold text-bold-paper opacity-0 transition-opacity duration-300">Answered in 1.4s</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="what" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <span class="what-ambient-blob"></span>
    </div>
    <div class="container-fb relative">
      <div class="flex items-start justify-between gap-8">
        <div class="reveal-item max-w-xl" data-reveal>
          <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">What it is</p>
          <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
            The same agent behind every decision, now answering your questions directly.
          </h2>
          <p class="mt-5 text-[0.98rem] font-normal leading-relaxed text-bold-ink/70">
            Ask Flowbound isn't a chatbot bolted onto the product as an afterthought. It's the same engine
            that forecasts your inventory, watches your suppliers, places your reorders, and flags a quality
            problem before it becomes a pattern, just made directly available to your team. Whatever it
            already knows about your operation, you can ask it about, in plain language, the moment you need
            the answer.
          </p>
        </div>
        <div class="relative hidden shrink-0 md:block" data-icon-drift>
          <span class="icon-pulse-ring absolute inset-0 rounded-full border border-bold-ink/15" aria-hidden="true"></span>
          <SectionIcon name="spark" class="icon-spin relative h-[7.5rem] w-[7.5rem] text-bold-ink/20" />
        </div>
      </div>
    </div>
  </section>

  <section id="capabilities" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">What it does</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
          Built to be asked, not just looked at.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-3.5">
        <div data-reveal class="reveal-item">
          <div data-tilt class="tilt-card bold-tile-feature bold-glass rounded-2xl p-7 md:p-8">
            <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-bold-ink font-mono text-[0.65rem] font-bold text-bold-paper">01</span>
            <h3 class="font-hanken mt-3 text-[1.15rem] font-semibold text-bold-ink">{capabilities[0].title}</h3>
            <p class="mt-2 max-w-2xl text-[0.92rem] leading-relaxed text-bold-ink/65">{capabilities[0].description}</p>
          </div>
        </div>
        <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2 md:grid-cols-3">
          {capabilities.slice(1).map((capability, i) => (
            <div
              data-reveal
              class="reveal-item h-full rounded-2xl border border-bold-ink/8 bg-bold-paper p-6 transition-colors duration-300 hover:border-bold-ink/25 hover:bg-bold-ink/[0.04]"
              style={`transition-delay: ${(i + 1) * 70}ms`}
            >
              <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-bold-ink font-mono text-[0.65rem] font-bold text-bold-paper">{String(i + 2).padStart(2, "0")}</span>
              <h3 class="font-hanken mt-3 text-[0.95rem] font-semibold text-bold-ink">{capability.title}</h3>
              <p class="mt-2 text-[0.85rem] leading-relaxed text-bold-ink/65">{capability.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="examples" class="bold-depth-ink relative overflow-hidden py-20 font-hanken md:py-28">
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-mint">A few things teams ask</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-paper md:text-[2.2rem]">
          No special phrasing required. Just ask like you'd ask a person.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-2">
        {sampleQuestions.map((question, i) => (
          <div
            data-reveal
            class="reveal-item flex items-start gap-3 border border-bold-paper/15 bg-bold-paper/5 px-5 py-4"
            style={`transition-delay: ${(i % 4) * 70}ms`}
          >
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-bold-mint" aria-hidden="true" />
            <span class="text-[0.98rem] leading-snug text-bold-paper/80">{question}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="how" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <span class="how-ambient-blob"></span>
    </div>
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">How it works</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
          From a question to an answer you can trust.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-3">
        {steps.map((s, i) => (
          <div
            data-reveal
            class="reveal-item h-full rounded-2xl border border-bold-ink/10 bg-bold-paper p-7 transition-colors duration-300 hover:border-bold-ink/25 hover:bg-bold-ink/[0.04]"
            style={`transition-delay: ${i * 90}ms`}
          >
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-bold-ink font-mono text-xs font-bold text-bold-paper">{s.n}</span>
            <h3 class="font-hanken mt-3 text-[1.05rem] font-medium leading-snug text-bold-ink">{s.title}</h3>
            <p class="mt-3 text-[0.92rem] font-normal leading-relaxed text-bold-ink/65">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Cta />
</BaseLayout>

<style>
  .what-ambient-blob {
    position: absolute;
    top: -10%;
    right: -6%;
    width: 28vw;
    height: 28vw;
    max-width: 380px;
    max-height: 380px;
    border-radius: 9999px;
    filter: blur(80px);
    background: radial-gradient(circle, rgba(110, 156, 163, 0.16) 0%, transparent 70%);
  }

  .how-ambient-blob {
    position: absolute;
    bottom: -15%;
    left: -6%;
    width: 28vw;
    height: 28vw;
    max-width: 380px;
    max-height: 380px;
    border-radius: 9999px;
    filter: blur(80px);
    background: radial-gradient(circle, rgba(110, 156, 163, 0.14) 0%, transparent 70%);
  }
</style>

<script>
  import "../scripts/scrollReveal"
  import "../scripts/sectionIconDrift"
  import "../scripts/cardTilt"
  import "../scripts/magneticButton"
  import "../scripts/decisionFeed"
</script>
