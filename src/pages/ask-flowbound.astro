---
import BaseLayout from "../layouts/BaseLayout.astro"
import Cta from "../components/Cta.astro"
import AskFlowboundBackground from "../components/AskFlowboundBackground.astro"
import SectionIcon from "../components/icons/SectionIcon.astro"

const GLOW_SIZE = 420

const capabilities = [
  {
    title: "Ask, and Get an Answer",
    description:
      "Type a question about inventory, a supplier, an order, or a price, and get a straight answer pulled from your live data. No dashboard to dig through and no report to wait on.",
  },
  {
    title: "Embedded, Not Separate",
    description:
      "The agent lives inside the web app your team already uses every day. There's no extra tool to log into and nothing new to learn.",
  },
  {
    title: "Knows Your Business",
    description:
      "It answers from your actual numbers: your suppliers, your SKUs, your orders, not a generic help doc. Every answer is specific to your operation.",
  },
  {
    title: "Explains Its Reasoning",
    description:
      "Every answer comes with the why attached: which numbers it pulled, which SKU or supplier it's about, and what changed since last time. Nothing it tells you is a black box.",
  },
  {
    title: "Available Anytime",
    description:
      "There's no calendar to check and no consultant's hourly rate to watch. Ask first thing in the morning, ask again at close, ask the same question twice in a day.",
  },
  {
    title: "One Agent, Every Service",
    description:
      "The same agent that answers a quick question about a shipment is the one tracking your suppliers, placing reorders, and watching for quality issues. One system, not five tools stitched together.",
  },
]

const sampleQuestions = [
  "What's my reorder point for SKU-4482 right now?",
  "Which supplier had the worst on-time rate last quarter?",
  "Why did the sell price on this item change last week?",
  "What's the status of order #10293?",
  "Do we have enough stock to cover the next 30 days?",
  "Which wholesale accounts are overdue for a check-in?",
  "How many units shipped from Supplier B this month?",
  "Has this customer had a damage claim before?",
]

const steps = [
  {
    n: "01",
    title: "Ask in plain language",
    body: "Type the question right where your team already works, inside the app. No new tool to log into and nothing to learn first.",
  },
  {
    n: "02",
    title: "The agent checks your live data",
    body: "It pulls straight from your actual inventory, orders, suppliers, and shipments, not a cached report or a summary from last week.",
  },
  {
    n: "03",
    title: "Get an answer with the reasoning attached",
    body: "Every response explains what it looked at and why, so your team can trust the answer instead of double-checking it.",
  },
]

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Ask Flowbound",
  applicationCategory: "BusinessApplication",
  description:
    "An on-demand supply chain consultant embedded in the Flowbound web app, answering questions and pulling live data the moment a team asks for it.",
  audience: {
    "@type": "Audience",
    audienceType: "Small and mid-sized businesses",
  },
}
---

<BaseLayout
  title="Ask Flowbound | Flowbound"
  description="Ask Flowbound is the agent behind every Flowbound service: a supply chain consultant built into your web app that answers questions from your live data, no dashboard and no consultant required."
  path="/ask-flowbound"
  schema={schema}
>
  <section id="top" class="relative min-h-[560px] overflow-hidden bg-ocean-900 md:min-h-[680px]">
    <AskFlowboundBackground />
    <div class="absolute inset-0 bg-gradient-to-r from-ocean-900/90 from-0% via-ocean-900/55 via-55% to-ocean-900/10" />
    <div class="absolute inset-0 bg-gradient-to-t from-ocean-900 via-transparent to-transparent" />

    <div class="container-fb relative flex min-h-[560px] flex-col justify-center py-20 font-amulya md:min-h-[680px]">
      <div class="mb-5 flex items-center gap-3">
        <SectionIcon name="spark" class="h-6 w-6 text-ocean-100" />
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-ocean-100">Ask Flowbound</p>
      </div>
      <h1 class="max-w-2xl font-amulya text-[2.5rem] font-bold leading-[1.08] tracking-tight text-fb-white md:text-[3.2rem]">
        A supply chain consultant that lives in your app, not on someone's <span class="font-medium italic text-ocean-100">calendar</span>.
      </h1>
      <p class="mt-6 max-w-lg text-[1.05rem] font-light leading-relaxed text-fb-white/65">
        Every Flowbound service runs through the same agent. Ask it about inventory, a supplier, an order, or a
        price, and get a straight answer pulled from your live data, no dashboard to dig through and no
        consultant to schedule.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a
          href="#cta"
          class="group relative inline-flex items-center gap-2 overflow-hidden rounded-md bg-ocean-500 px-6 py-3.5 font-semibold text-fb-white transition-all duration-300 ease-out hover:-translate-y-0.5 hover:shadow-[0_14px_32px_-10px_rgba(74,111,165,0.55)]"
        >
          <span aria-hidden="true" class="absolute inset-0 origin-left scale-x-0 bg-ocean-900 transition-transform duration-500 ease-out group-hover:scale-x-100" />
          <span class="relative z-10">Request a pilot</span>
          <span aria-hidden="true" class="relative z-10 transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
        </a>
        <a
          href="#how"
          class="group relative inline-flex items-center gap-2 overflow-hidden rounded-md border border-fb-white/25 px-6 py-3.5 font-medium text-fb-white transition-all duration-300 ease-out hover:-translate-y-0.5 hover:border-fb-white/50"
        >
          <span aria-hidden="true" class="absolute inset-0 bg-fb-white/10 opacity-0 transition-opacity duration-300 ease-out group-hover:opacity-100" />
          <span class="relative z-10">See how it works</span>
          <span aria-hidden="true" class="relative z-10 transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <section id="what" class="border-b border-ocean-700/15 bg-ocean-100 bg-grain py-20 font-amulya md:py-28">
    <div class="container-fb">
      <div class="flex items-start justify-between gap-8">
        <div class="reveal-item max-w-xl" data-reveal>
          <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-ocean-950">What it is</p>
          <h2 class="font-amulya text-[1.9rem] font-semibold leading-tight tracking-tight text-ocean-950 md:text-[2.2rem]">
            The same agent behind every decision, now answering your questions directly.
          </h2>
          <p class="mt-5 text-[0.98rem] font-normal leading-relaxed text-ocean-950">
            Ask Flowbound isn't a chatbot bolted onto the product as an afterthought. It's the same engine that
            forecasts your inventory, watches your suppliers, places your reorders, and flags a quality problem
            before it becomes a pattern, just made directly available to your team. Whatever it already knows
            about your operation, you can ask it about, in plain language, the moment you need the answer.
          </p>
        </div>
        <div class="relative hidden shrink-0 md:block" data-icon-drift>
          <span class="icon-pulse-ring absolute inset-0 rounded-full border border-ocean-950/10" aria-hidden="true"></span>
          <SectionIcon name="spark" class="icon-spin relative h-[7.5rem] w-[7.5rem] text-ocean-950/[14%]" />
        </div>
      </div>
    </div>
  </section>

  <section id="capabilities" class="border-b border-ocean-700/15 bg-ocean-200 bg-grain py-20 font-amulya md:py-28">
    <div class="container-fb">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-ocean-950">What it does</p>
        <h2 class="font-amulya text-[1.9rem] font-semibold leading-tight tracking-tight text-ocean-950 md:text-[2.2rem]">
          Built to be asked, not just looked at.
        </h2>
      </div>

      <div
        data-glow-container
        data-glow-size={GLOW_SIZE}
        class="relative mt-14 grid grid-cols-1 gap-6 overflow-hidden md:grid-cols-3"
      >
        {capabilities.map((capability, i) => (
          <div data-reveal class="reveal-item h-full" style={`transition-delay: ${(i % 3) * 90}ms`}>
            <div
              data-tilt
              class="tilt-card group relative z-10 h-full overflow-hidden border border-ocean-700/20 bg-ocean-100 p-8 hover:border-ocean-700/45"
            >
              <span class="font-mono text-sm text-ocean-950">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="mt-3 font-amulya text-[1.15rem] font-medium leading-snug text-ocean-950">{capability.title}</h3>
              <p class="mt-3 text-[0.95rem] font-normal leading-relaxed text-ocean-950">{capability.description}</p>
              <div class="absolute inset-x-0 bottom-0 h-0.5 origin-center scale-x-0 bg-ocean-500 transition-transform duration-500 ease-out group-hover:scale-x-100" />
            </div>
          </div>
        ))}

        <div
          data-glow
          aria-hidden="true"
          class="glow-cursor z-20 rounded-full mix-blend-multiply"
          style={`width: ${GLOW_SIZE}px; height: ${GLOW_SIZE}px; background: radial-gradient(circle, rgba(74,111,165,0.15), transparent 70%);`}
        />
      </div>
    </div>
  </section>

  <section id="examples" class="border-b border-ocean-700/15 bg-ocean-900 py-20 font-amulya md:py-28">
    <div class="container-fb">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-ocean-100">A few things teams ask</p>
        <h2 class="font-amulya text-[1.9rem] font-semibold leading-tight tracking-tight text-fb-white md:text-[2.2rem]">
          No special phrasing required. Just ask like you'd ask a person.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-2">
        {sampleQuestions.map((question, i) => (
          <div
            data-reveal
            class="reveal-item flex items-start gap-3 border border-fb-white/15 bg-fb-white/5 px-5 py-4"
            style={`transition-delay: ${(i % 4) * 70}ms`}
          >
            <SectionIcon name="chat" class="mt-0.5 h-5 w-5 shrink-0 text-ocean-100" />
            <span class="text-[0.98rem] leading-snug text-fb-white/80">{question}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="how" class="border-b border-ocean-700/15 bg-ocean-100 py-20 font-amulya md:py-28">
    <div class="container-fb">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-ocean-950">How it works</p>
        <h2 class="font-amulya text-[1.9rem] font-semibold leading-tight tracking-tight text-ocean-950 md:text-[2.2rem]">
          From a question to an answer you can trust.
        </h2>
      </div>

      <div
        data-glow-container
        data-glow-size={GLOW_SIZE}
        class="relative mt-12 grid grid-cols-1 gap-6 overflow-hidden md:grid-cols-3"
      >
        {steps.map((s, i) => (
          <div data-reveal class="reveal-item h-full" style={`transition-delay: ${i * 90}ms`}>
            <div
              data-tilt
              class="tilt-card group relative z-10 h-full overflow-hidden border border-ocean-700/25 bg-ocean-200/60 p-8 hover:border-ocean-700/45"
            >
              <span class="font-mono text-sm text-ocean-950">{s.n}</span>
              <h3 class="relative z-30 mt-3 font-amulya text-[1.05rem] font-medium leading-snug text-ocean-950">{s.title}</h3>
              <p class="relative z-30 mt-3 text-[0.92rem] font-normal leading-relaxed text-ocean-950">{s.body}</p>
              <div class="absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-ocean-500 transition-transform duration-500 ease-out group-hover:scale-x-100" />
            </div>
          </div>
        ))}

        <div
          data-glow
          aria-hidden="true"
          class="glow-cursor z-20 rounded-full"
          style={`width: ${GLOW_SIZE}px; height: ${GLOW_SIZE}px; background: radial-gradient(circle, rgba(74,111,165,0.4) 0%, rgba(74,111,165,0.14) 45%, transparent 75%);`}
        />
      </div>
    </div>
  </section>

  <Cta />
</BaseLayout>

<script>
  import "../scripts/hoverGlow"
  import "../scripts/cardTilt"
  import "../scripts/scrollReveal"
  import "../scripts/sectionIconDrift"
</script>
