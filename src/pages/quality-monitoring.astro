---
// Hot Sauce rebuild, checklist item 12: the third and final whole-service narrative page (see
// the "Data-driven pages vs. narrative pages" note in CLAUDE.md). Unlike /ask-flowbound and
// /customer-service, this page's prior build used "what it watches" (signals, a dark bookend) as
// its examples section rather than "a few things X ask", so it keeps that shape: hero, what it
// is, what it does, what it watches, how it works. No FAQ (none existed before). Same visual
// grammar as every other converted page: grain+orb hero whose glass panel IS this page's assigned
// widget, icon-drift watermark, featured glass+gradient-ring tile + quiet ink-tint grid, one
// bold-depth-ink dark section, plain quiet-tile grid.
import BaseLayout from "../layouts/BaseLayout.astro"
import Cta from "../components/Cta.astro"
import SectionIcon from "../components/icons/SectionIcon.astro"
import Breadcrumbs from "../components/Breadcrumbs.astro"
import { buildBreadcrumbSchema } from "../lib/breadcrumbs"

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Services", path: "/services" },
  { name: "Quality Monitoring", path: "/quality-monitoring" },
]
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbItems, Astro.site!)

const capabilities = [
  {
    title: "Defect & Damage Patterns Flagged Automatically",
    description:
      "Flowbound flags damage and defect patterns as they show up in returns and inspections, instead of waiting for someone to notice the trend by hand.",
  },
  {
    title: "Supplier Quality Scorecards, Always Current",
    description:
      "Every supplier gets a running record of defect rates and on-time-in-full performance, so a quality conversation with a vendor comes with the numbers already attached.",
  },
  {
    title: "Inspection Results Logged and Checked Automatically",
    description:
      "Incoming inspection results get logged and checked automatically, and anything that fails gets flagged before it ever reaches your shelf.",
  },
  {
    title: "One Incident, Not a Pattern Nobody Noticed",
    description:
      "A single damaged shipment or a single bad batch gets caught while it's still one incident, not after it's shown up three more times.",
  },
  {
    title: "Returns and Complaints Read Together",
    description:
      "Flowbound watches returns, complaints, and inspection results as one connected picture, instead of three separate spreadsheets nobody cross-references.",
  },
  {
    title: "The Numbers Are There Before the Vendor Call",
    description:
      "When a quality conversation with a supplier comes up, the defect rate and on-time performance are already on record, not something someone has to pull together first.",
  },
]

const signals = [
  "Defect rates per SKU and per supplier",
  "Damage rates in returns and claims",
  "Incoming inspection pass and fail results",
  "Supplier on-time-in-full performance",
  "Repeat complaints on the same SKU or batch",
  "Return reason codes",
  "Batch or lot numbers tied to a quality issue",
  "Trend direction, not just a single incident",
]

const steps = [
  {
    n: "01",
    title: "It watches returns, complaints, and inspections together",
    body: "Every damage report, return reason, and inspection result gets tracked in one place, not three separate systems nobody cross-references.",
  },
  {
    n: "02",
    title: "It flags the pattern, not just the incident",
    body: "A single damaged unit is normal. Two or three with the same cause on the same SKU or supplier gets flagged before it becomes a trend.",
  },
  {
    n: "03",
    title: "You get the numbers, not just a warning",
    body: "Every flag comes with the defect rate, the supplier's track record, and the specific batch or order behind it, so the next step is obvious.",
  },
]

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Quality Monitoring",
  name: "Quality Monitoring",
  description:
    "Flowbound watches inspection results, returns, and supplier performance together, so a quality issue gets flagged while it's still one incident, not after it's cost you a repeat customer.",
  provider: { "@type": "Organization", name: "Flowbound" },
  audience: {
    "@type": "Audience",
    audienceType: "Small and mid-sized businesses",
  },
}
---

<BaseLayout
  title="Quality Monitoring Software | Flowbound"
  description="Flowbound watches inspection results, returns, and supplier performance together, flagging a quality issue as one incident, not after it costs a customer."
  path="/quality-monitoring"
  schema={[schema, breadcrumbSchema]}
>
  <section id="top" class="relative overflow-hidden bg-bold-paper py-24 pt-28 font-hanken md:py-32 md:pt-36">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <span class="bold-orb" style="width:20rem;height:20rem;top:-9rem;right:-5rem;background:#8FE3D3;opacity:0.32;" />
      <span class="bold-orb" style="width:17rem;height:17rem;top:6rem;right:19rem;background:#C998CD;opacity:0.28;" />
    </div>

    <div class="container-fb relative">
      <Breadcrumbs items={breadcrumbItems} />

      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-10">
        <div>
          <div data-reveal class="reveal-item mb-5 flex items-center gap-3">
            <SectionIcon name="shield-check" class="h-6 w-6 text-bold-mint-deep" />
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">Quality Monitoring</p>
          </div>
          <h1 data-reveal class="font-hanken reveal-item max-w-2xl text-[2.5rem] font-bold leading-[1.08] tracking-tighter text-bold-ink md:text-[3.2rem]" style="transition-delay: 60ms">
            Catch a quality problem while it's still <em class="font-instrument font-normal italic text-bold-mint-deep">one incident</em>.
          </h1>
          <p data-reveal class="reveal-item mt-6 max-w-lg text-[1.05rem] font-normal leading-relaxed text-bold-ink/70" style="transition-delay: 120ms">
            Flowbound watches inspection results, returns, and supplier performance together, so a quality
            issue gets flagged while it's still one incident, not after it's cost you a repeat customer.
          </p>
          <div data-reveal class="reveal-item mt-9 flex flex-wrap items-center gap-4" style="transition-delay: 180ms">
            <a
              href="#cta"
              data-magnetic
              class="bold-btn bold-btn-primary bold-btn-md group"
            >
              <span class="relative z-10">Request a pilot</span>
              <span aria-hidden="true" class="relative z-10 transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
            </a>
            <a
              href="#how"
              data-magnetic
              class="bold-btn bold-btn-secondary bold-btn-md group"
            >
              <span class="relative z-10">See how it works</span>
              <span aria-hidden="true" class="relative z-10 transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
            </a>
          </div>
        </div>

        <div data-reveal class="reveal-item bold-glass rounded-2xl p-5" style="transition-delay: 240ms">
          <div class="mb-4 flex items-center justify-between font-mono text-xs uppercase tracking-[0.05em] text-bold-taupe">
            <span class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-bold-mint-deep" aria-hidden="true" />
              Live &middot; Batch&ndash;0417
            </span>
            <span>Inspection line</span>
          </div>
          <div id="inspectionLineWidget" class="inspect-line" aria-hidden="true">
            <span class="inspect-track" />
            <span class="inspect-gate" />
            <span class="pointer-events-none absolute -top-2" style="left: calc(58% - 7px)">
              <SectionIcon name="shield-check" class="h-3.5 w-3.5 text-bold-ink/40" />
            </span>
            <span class="inspect-unit" />
            <span class="inspect-unit" />
            <span class="inspect-unit" />
            <span class="inspect-unit" />
            <span class="inspect-unit" />
          </div>
          <div class="mt-4 flex items-end justify-between">
            <span class="text-[0.95rem] font-bold text-bold-ink">5 units inspected</span>
            <span id="inspectionLineBadge" class="rounded-full bg-bold-taupe px-2.5 py-0.5 font-mono text-xs font-bold text-bold-paper opacity-0 transition-opacity duration-300">1 flagged</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="what" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <span class="what-ambient-blob"></span>
    </div>
    <div class="container-fb relative">
      <div class="flex items-start justify-between gap-8">
        <div class="reveal-item max-w-xl" data-reveal>
          <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">What it is</p>
          <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
            A damaged shipment is easy to miss buried in a spreadsheet. A pattern isn't, once you're watching.
          </h2>
          <p class="mt-5 text-[0.98rem] font-normal leading-relaxed text-bold-ink/70">
            Returns, complaints, and inspection results usually live in different places, which is exactly
            why a real quality problem can show up two or three times before anyone connects the dots.
            Flowbound watches all three together, so a defect pattern or a supplier slipping on quality gets
            flagged while it's still one incident, with the numbers already attached.
          </p>
        </div>
        <div class="relative hidden shrink-0 md:block" data-icon-drift>
          <span class="icon-pulse-ring absolute inset-0 rounded-full border border-bold-ink/15" aria-hidden="true"></span>
          <SectionIcon name="shield-check" class="icon-spin relative h-[7.5rem] w-[7.5rem] text-bold-ink/20" />
        </div>
      </div>
    </div>
  </section>

  <section id="capabilities" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">What it does</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
          Built to catch a pattern while it's still one incident.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-3.5">
        <div data-reveal class="reveal-item">
          <div data-tilt class="tilt-card bold-tile-feature bold-glass rounded-2xl p-7 md:p-8">
            <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-bold-ink font-mono text-[0.65rem] font-bold text-bold-paper">01</span>
            <h3 class="font-hanken mt-3 text-[1.15rem] font-semibold text-bold-ink">{capabilities[0].title}</h3>
            <p class="mt-2 max-w-2xl text-[0.92rem] leading-relaxed text-bold-ink/65">{capabilities[0].description}</p>
          </div>
        </div>
        <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2 md:grid-cols-3">
          {capabilities.slice(1).map((capability, i) => (
            <div
              data-reveal
              class="reveal-item h-full rounded-2xl border border-bold-ink/8 bg-bold-paper p-6 transition-colors duration-300 hover:border-bold-ink/25 hover:bg-bold-ink/[0.04]"
              style={`transition-delay: ${(i + 1) * 70}ms`}
            >
              <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-bold-ink font-mono text-[0.65rem] font-bold text-bold-paper">{String(i + 2).padStart(2, "0")}</span>
              <h3 class="font-hanken mt-3 text-[0.95rem] font-semibold text-bold-ink">{capability.title}</h3>
              <p class="mt-2 text-[0.85rem] leading-relaxed text-bold-ink/65">{capability.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="signals" class="bold-depth-ink relative overflow-hidden py-20 font-hanken md:py-28">
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-mint">What it watches</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-paper md:text-[2.2rem]">
          Every signal that turns one bad unit into a caught pattern.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-2">
        {signals.map((signal, i) => (
          <div
            data-reveal
            class="reveal-item flex items-start gap-3 border border-bold-paper/15 bg-bold-paper/5 px-5 py-4"
            style={`transition-delay: ${(i % 4) * 70}ms`}
          >
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-bold-mint" aria-hidden="true" />
            <span class="text-[0.98rem] leading-snug text-bold-paper/80">{signal}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="how" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <span class="how-ambient-blob"></span>
    </div>
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">How it works</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
          From a damaged unit to a flagged pattern, before it repeats.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-3">
        {steps.map((s, i) => (
          <div
            data-reveal
            class="reveal-item h-full rounded-2xl border border-bold-ink/10 bg-bold-paper p-7 transition-colors duration-300 hover:border-bold-ink/25 hover:bg-bold-ink/[0.04]"
            style={`transition-delay: ${i * 90}ms`}
          >
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-bold-ink font-mono text-xs font-bold text-bold-paper">{s.n}</span>
            <h3 class="font-hanken mt-3 text-[1.05rem] font-medium leading-snug text-bold-ink">{s.title}</h3>
            <p class="mt-3 text-[0.92rem] font-normal leading-relaxed text-bold-ink/65">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Cta />
</BaseLayout>

<style>
  .what-ambient-blob {
    position: absolute;
    top: -10%;
    right: -6%;
    width: 28vw;
    height: 28vw;
    max-width: 380px;
    max-height: 380px;
    border-radius: 9999px;
    filter: blur(80px);
    background: radial-gradient(circle, rgba(110, 156, 163, 0.16) 0%, transparent 70%);
  }

  .how-ambient-blob {
    position: absolute;
    bottom: -15%;
    left: -6%;
    width: 28vw;
    height: 28vw;
    max-width: 380px;
    max-height: 380px;
    border-radius: 9999px;
    filter: blur(80px);
    background: radial-gradient(circle, rgba(110, 156, 163, 0.14) 0%, transparent 70%);
  }
</style>

<script>
  import "../scripts/scrollReveal"
  import "../scripts/sectionIconDrift"
  import "../scripts/cardTilt"
  import "../scripts/magneticButton"
  import "../scripts/inspectionLine"
</script>
