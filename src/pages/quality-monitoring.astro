---
import BaseLayout from "../layouts/BaseLayout.astro"
import Cta from "../components/Cta.astro"
import QualityMonitoringBackground from "../components/QualityMonitoringBackground.astro"
import SectionIcon from "../components/icons/SectionIcon.astro"

const GLOW_SIZE = 420

const capabilities = [
  {
    title: "Defect & Damage Patterns Flagged Automatically",
    description:
      "Flowbound flags damage and defect patterns as they show up in returns and inspections, instead of waiting for someone to notice the trend by hand.",
  },
  {
    title: "Supplier Quality Scorecards, Always Current",
    description:
      "Every supplier gets a running record of defect rates and on-time-in-full performance, so a quality conversation with a vendor comes with the numbers already attached.",
  },
  {
    title: "Inspection Results Logged and Checked Automatically",
    description:
      "Incoming inspection results get logged and checked automatically, and anything that fails gets flagged before it ever reaches your shelf.",
  },
  {
    title: "One Incident, Not a Pattern Nobody Noticed",
    description:
      "A single damaged shipment or a single bad batch gets caught while it's still one incident, not after it's shown up three more times.",
  },
  {
    title: "Returns and Complaints Read Together",
    description:
      "Flowbound watches returns, complaints, and inspection results as one connected picture, instead of three separate spreadsheets nobody cross-references.",
  },
  {
    title: "The Numbers Are There Before the Vendor Call",
    description:
      "When a quality conversation with a supplier comes up, the defect rate and on-time performance are already on record, not something someone has to pull together first.",
  },
]

const signals = [
  "Defect rates per SKU and per supplier",
  "Damage rates in returns and claims",
  "Incoming inspection pass and fail results",
  "Supplier on-time-in-full performance",
  "Repeat complaints on the same SKU or batch",
  "Return reason codes",
  "Batch or lot numbers tied to a quality issue",
  "Trend direction, not just a single incident",
]

const steps = [
  {
    n: "01",
    title: "It watches returns, complaints, and inspections together",
    body: "Every damage report, return reason, and inspection result gets tracked in one place, not three separate systems nobody cross-references.",
  },
  {
    n: "02",
    title: "It flags the pattern, not just the incident",
    body: "A single damaged unit is normal. Two or three with the same cause on the same SKU or supplier gets flagged before it becomes a trend.",
  },
  {
    n: "03",
    title: "You get the numbers, not just a warning",
    body: "Every flag comes with the defect rate, the supplier's track record, and the specific batch or order behind it, so the next step is obvious.",
  },
]

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Quality Monitoring",
  applicationCategory: "BusinessApplication",
  description:
    "Flowbound watches inspection results, returns, and supplier performance together, so a quality issue gets flagged while it's still one incident, not after it's cost you a repeat customer.",
  audience: {
    "@type": "Audience",
    audienceType: "Small and mid-sized businesses",
  },
}
---

<BaseLayout
  title="Quality Monitoring | Flowbound"
  description="Flowbound watches inspection results, returns, and supplier performance together, so a quality issue gets flagged while it's still one incident, not after it's cost you a repeat customer."
  path="/quality-monitoring"
  schema={schema}
>
  <section class="relative min-h-[560px] overflow-hidden bg-fb-black md:min-h-[680px]">
    <QualityMonitoringBackground />
    <div class="absolute inset-0 bg-gradient-to-r from-fb-black/90 from-0% via-fb-black/55 via-55% to-fb-black/10" />
    <div class="absolute inset-0 bg-gradient-to-t from-fb-black via-transparent to-transparent" />

    <div class="container-fb relative flex min-h-[560px] flex-col justify-center py-20 md:min-h-[680px]">
      <div class="mb-5 flex items-center gap-3">
        <SectionIcon name="shield-check" class="h-6 w-6 text-fb-green-300" />
        <p class="eyebrow text-fb-green-300">Quality Monitoring</p>
      </div>
      <h1 class="max-w-2xl text-[2.5rem] font-semibold leading-[1.08] tracking-tight text-fb-white md:text-[3.2rem]">
        Catch a quality problem while it's still one incident.
      </h1>
      <p class="mt-6 max-w-lg text-[1.05rem] leading-relaxed text-fb-white/65">
        Flowbound watches inspection results, returns, and supplier performance together, so a quality issue
        gets flagged while it's still one incident, not after it's cost you a repeat customer.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a
          href="#cta"
          class="inline-flex items-center bg-fb-green-500 px-6 py-3.5 font-body font-normal text-fb-white transition-colors hover:bg-fb-green-400"
        >
          Request a pilot
        </a>
        <a
          href="#how"
          class="inline-flex items-center border border-fb-white/25 px-6 py-3.5 font-body font-normal text-fb-white transition-colors hover:border-fb-white/60"
        >
          See how it works
        </a>
      </div>
    </div>
  </section>

  <section id="what" class="border-b border-fb-black/10 bg-fb-paper bg-grain py-20 md:py-28">
    <div class="container-fb">
      <div class="flex items-start justify-between gap-8">
        <div class="max-w-xl">
          <p class="eyebrow mb-4">What it is</p>
          <h2 class="text-[1.9rem] font-semibold leading-tight tracking-tight text-fb-black md:text-[2.2rem]">
            A damaged shipment is easy to miss buried in a spreadsheet. A pattern isn't, once you're watching.
          </h2>
          <p class="mt-5 text-[0.98rem] leading-relaxed text-fb-black/65">
            Returns, complaints, and inspection results usually live in different places, which is exactly
            why a real quality problem can show up two or three times before anyone connects the dots.
            Flowbound watches all three together, so a defect pattern or a supplier slipping on quality gets
            flagged while it's still one incident, with the numbers already attached.
          </p>
        </div>
        <SectionIcon name="shield-check" class="hidden h-[7.5rem] w-[7.5rem] shrink-0 text-fb-green-500/[14%] md:block" />
      </div>
    </div>
  </section>

  <section id="capabilities" class="border-b border-fb-black/10 bg-fb-white bg-grain py-20 md:py-28">
    <div class="container-fb">
      <div class="max-w-xl">
        <p class="eyebrow mb-4">What it does</p>
        <h2 class="text-[1.9rem] font-semibold leading-tight tracking-tight text-fb-black md:text-[2.2rem]">
          Built to catch a pattern while it's still one incident.
        </h2>
      </div>

      <div
        data-glow-container
        data-glow-size={GLOW_SIZE}
        class="relative mt-14 grid grid-cols-1 gap-6 overflow-hidden md:grid-cols-3"
      >
        {capabilities.map((capability, i) => (
          <div class="group relative z-10 overflow-hidden border border-fb-black/10 bg-fb-white p-8 transition-all duration-500 ease-out hover:-translate-y-0.5 hover:border-fb-green-500/35 hover:bg-fb-green-50/50">
            <span class="font-mono text-sm text-fb-green-500">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="mt-3 text-[1.15rem] font-semibold leading-snug text-fb-black">{capability.title}</h3>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-fb-black/65">{capability.description}</p>
            <div class="absolute inset-x-0 bottom-0 h-0.5 origin-center scale-x-0 bg-fb-green-500 transition-transform duration-500 ease-out group-hover:scale-x-100" />
          </div>
        ))}

        <div
          data-glow
          aria-hidden="true"
          class="glow-cursor z-20 rounded-full mix-blend-multiply"
          style={`width: ${GLOW_SIZE}px; height: ${GLOW_SIZE}px; background: radial-gradient(circle, rgba(0,88,64,0.16), transparent 70%);`}
        />
      </div>
    </div>
  </section>

  <section id="signals" class="border-b border-fb-black/10 bg-fb-black py-20 md:py-28">
    <div class="container-fb">
      <div class="max-w-xl">
        <p class="eyebrow text-fb-green-300 mb-4">What it watches</p>
        <h2 class="text-[1.9rem] font-semibold leading-tight tracking-tight text-fb-white md:text-[2.2rem]">
          Every signal that turns one bad unit into a caught pattern.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-2">
        {signals.map((signal) => (
          <div class="flex items-start gap-3 border border-fb-white/15 bg-fb-white/5 px-5 py-4">
            <SectionIcon name="shield-check" class="mt-0.5 h-5 w-5 shrink-0 text-fb-green-400" />
            <span class="text-[0.98rem] leading-snug text-fb-white/80">{signal}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="how" class="border-b border-fb-black/10 bg-fb-white py-20 md:py-28">
    <div class="container-fb">
      <div class="max-w-xl">
        <p class="eyebrow mb-4">How it works</p>
        <h2 class="text-[1.9rem] font-semibold leading-tight tracking-tight text-fb-black md:text-[2.2rem]">
          From a damaged unit to a flagged pattern, before it repeats.
        </h2>
      </div>

      <div
        data-glow-container
        data-glow-size={GLOW_SIZE}
        class="relative mt-12 grid grid-cols-1 gap-6 overflow-hidden md:grid-cols-3"
      >
        {steps.map((s) => (
          <div class="group relative z-10 overflow-hidden border border-fb-green-400/30 bg-fb-green-50 p-8 transition-all duration-500 ease-out hover:-translate-y-0.5 hover:border-fb-green-500/40">
            <span class="font-mono text-sm text-fb-green-500">{s.n}</span>
            <h3 class="relative z-30 mt-3 text-[1.05rem] font-semibold leading-snug text-fb-black">{s.title}</h3>
            <p class="relative z-30 mt-3 text-[0.92rem] leading-relaxed text-fb-black">{s.body}</p>
            <div class="absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-fb-green-500 transition-transform duration-500 ease-out group-hover:scale-x-100" />
          </div>
        ))}

        <div
          data-glow
          aria-hidden="true"
          class="glow-cursor z-20 rounded-full mix-blend-screen"
          style={`width: ${GLOW_SIZE}px; height: ${GLOW_SIZE}px; background: radial-gradient(circle, rgba(255,255,255,0.55), transparent 70%);`}
        />
      </div>
    </div>
  </section>

  <Cta />
</BaseLayout>

<script>
  import "../scripts/hoverGlow"
</script>
