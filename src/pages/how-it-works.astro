---
// Hot Sauce rebuild, checklist item 13: the first of three remaining one-off pages, following
// the approved "Signal Primitives II" concept lab (see CLAUDE.md). First draft kept the page's
// old bespoke dark canvas hero ("Scroll-Driven Assembly," recolored to Bold), reasoning that its
// scroll-tied comet through four checkpoints already mirrored this page's own four-step
// structure. Flagged directly: the page read as inconsistent with every other converted page, and
// the hero didn't have the right widget either. Fixed by switching to the exact same light
// grain+orb + bold-glass hero pattern every other page uses, with a new widget, Step Trace, built
// for the glass panel (HowItWorksBackground.astro/howItWorksHero.ts are left on disk unused,
// same precedent as every other retired *Background.astro file, not deleted). The approved Plate
// Clear widget still replaces the static "what comes off your plate" checklist.
import BaseLayout from "../layouts/BaseLayout.astro"
import Cta from "../components/Cta.astro"
import SectionIcon from "../components/icons/SectionIcon.astro"

const steps = [
  {
    n: "01",
    title: "Connect your systems",
    body:
      "Point Flowbound at your ERP, spreadsheets, or supplier feeds, whatever you're already using to run the business. There's no migration and no new system of record to maintain. Flowbound reads what's already there.",
  },
  {
    n: "02",
    title: "The engine reads the signal",
    body:
      "Inventory levels, lead times, open orders, and demand history get reconciled continuously, not once a month when someone finally opens the spreadsheet. By the time something needs a call, Flowbound already has the full picture.",
  },
  {
    n: "03",
    title: "You get a decision, not a dashboard",
    body:
      "Reorder 400 units from Supplier B, expedite shipment #4471, or hold the PO to Supplier A. Every call comes with the reasoning attached: which numbers it pulled, why this option and not another, so you're never just taking its word for it.",
  },
  {
    n: "04",
    title: "Ask it anything",
    body:
      "The same engine that made the call answers your team's questions about it, in plain language, pulling from the same live data behind the decision. No separate report to request and no consultant to schedule.",
  },
]

const offYourPlate = [
  "Reconciling inventory across a spreadsheet and your ERP by hand",
  "Chasing a supplier for a lead time update",
  "Guessing when to reorder before it's already too late",
  "Re-running the math every time a cost or demand shifts",
  "Explaining a decision after the fact instead of having the reasoning upfront",
  "Checking five different tools to answer one customer question",
  "Waiting on a consultant to tell you what your own data already knows",
]

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "How Flowbound Works",
  name: "How Flowbound Works",
  description:
    "Flowbound connects to the systems you already use, reads inventory, lead time, and demand signals continuously, and turns them into a decision with the reasoning attached, answerable in plain language whenever your team has a question.",
  provider: { "@type": "Organization", name: "Flowbound" },
  audience: {
    "@type": "Audience",
    audienceType: "Small and mid-sized businesses",
  },
}
---

<BaseLayout
  title="How Flowbound Works | Supply Chain Automation Explained"
  description="Four steps between your data and a decision you can act on: connect your systems, the engine reads the signal, you get the reasoning, then ask anything."
  path="/how-it-works"
  schema={schema}
>
  <section id="top" class="relative overflow-hidden bg-bold-paper py-24 pt-28 font-hanken md:py-32 md:pt-36">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <span class="bold-orb" style="width:18rem;height:18rem;top:-6rem;right:-2rem;background:#8FE3D3;opacity:0.28;" />
      <span class="bold-orb" style="width:15rem;height:15rem;top:3rem;right:14rem;background:#C998CD;opacity:0.26;" />
    </div>

    <div class="container-fb relative">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-10">
        <div>
          <div data-reveal class="reveal-item mb-5 flex items-center gap-3">
            <SectionIcon name="gear" class="h-6 w-6 text-bold-mint-deep" />
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">How it works</p>
          </div>
          <h1 data-reveal class="font-hanken reveal-item max-w-2xl text-[2.5rem] font-bold leading-[1.08] tracking-tighter text-bold-ink md:text-[3.2rem]" style="transition-delay: 60ms">
            Four steps between your data and a decision you can <em class="font-instrument font-normal italic text-bold-mint-deep">act on</em>.
          </h1>
          <p data-reveal class="reveal-item mt-6 max-w-lg text-[1.05rem] font-normal leading-relaxed text-bold-ink/70" style="transition-delay: 120ms">
            Flowbound doesn't ask you to rip out your ERP or learn a new system. Connect what you already
            have, and the engine takes it from there: reading the signal, making the call, and explaining
            why, every time.
          </p>
          <div data-reveal class="reveal-item mt-9 flex flex-wrap items-center gap-4" style="transition-delay: 180ms">
            <a
              href="#cta"
              data-magnetic
              class="bold-btn bold-btn-primary bold-btn-md group"
            >
              <span class="relative z-10">Request a pilot</span>
              <span aria-hidden="true" class="relative z-10 transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
            </a>
            <a
              href="#steps"
              data-magnetic
              class="bold-btn bold-btn-secondary bold-btn-md group"
            >
              <span class="relative z-10">See the four steps</span>
              <span aria-hidden="true" class="relative z-10 transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
            </a>
          </div>
        </div>

        <div data-reveal class="reveal-item bold-glass rounded-2xl p-5" style="transition-delay: 240ms">
          <div class="mb-4 flex items-center justify-between font-mono text-xs uppercase tracking-[0.05em] text-bold-taupe">
            <span class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-bold-mint-deep" aria-hidden="true" />
              Live &middot; Order&ndash;7729
            </span>
            <span>Step trace</span>
          </div>
          <div id="stepTraceWidget" class="trace-widget" aria-hidden="true">
            <svg viewBox="0 0 220 60" class="w-full">
              <line class="trace-track" x1="18" y1="30" x2="202" y2="30"></line>
              <circle class="trace-node" style="--step: 0" cx="18" cy="30" r="9"></circle>
              <circle class="trace-node" style="--step: 1" cx="79" cy="30" r="9"></circle>
              <circle class="trace-node" style="--step: 2" cx="141" cy="30" r="9"></circle>
              <circle class="trace-node" style="--step: 3" cx="202" cy="30" r="9"></circle>
              <circle id="stepTraceComet" class="trace-comet" r="4"></circle>
            </svg>
            <div class="mt-1 grid grid-cols-4 text-center">
              <span class="font-mono text-[0.6rem] uppercase tracking-[0.04em] text-bold-taupe">Connect</span>
              <span class="font-mono text-[0.6rem] uppercase tracking-[0.04em] text-bold-taupe">Signal</span>
              <span class="font-mono text-[0.6rem] uppercase tracking-[0.04em] text-bold-taupe">Decide</span>
              <span class="font-mono text-[0.6rem] uppercase tracking-[0.04em] text-bold-taupe">Ask</span>
            </div>
          </div>
          <div class="mt-4 flex items-end justify-between">
            <span class="text-[1rem] font-bold text-bold-ink">Reorder 400 units<span class="ml-1.5 text-[0.85rem] font-normal text-bold-ink/50">&middot; Supplier B</span></span>
            <span id="stepTraceBadge" class="rounded-full bg-bold-mint-deep px-2.5 py-0.5 font-mono text-xs font-bold text-bold-paper opacity-0 transition-opacity duration-300">Decision ready</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="what" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <span class="what-ambient-blob"></span>
    </div>
    <div class="container-fb relative">
      <div class="flex items-start justify-between gap-8">
        <div class="reveal-item max-w-xl" data-reveal>
          <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">What it is</p>
          <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
            Set up once. It runs continuously after that.
          </h2>
          <p class="mt-5 text-[0.98rem] font-normal leading-relaxed text-bold-ink/70">
            Most tools ask you to check in: open a dashboard, run a report, remember to look before
            something goes wrong. Flowbound works the other way. Once it's connected to your systems, it
            watches continuously and comes to you the moment something actually needs a call, instead of
            waiting for you to go looking for it.
          </p>
        </div>
        <div class="relative hidden shrink-0 md:block" data-icon-drift>
          <span class="icon-pulse-ring absolute inset-0 rounded-full border border-bold-ink/15" aria-hidden="true"></span>
          <SectionIcon name="gear" class="icon-spin relative h-[7.5rem] w-[7.5rem] text-bold-ink/20" />
        </div>
      </div>
    </div>
  </section>

  <section id="steps" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">The four steps</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
          From raw signal to a decision you can act on.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2">
        {steps.map((s, i) => (
          <div
            data-reveal
            class="reveal-item h-full rounded-2xl border border-bold-ink/10 bg-bold-paper p-7 transition-colors duration-300 hover:border-bold-ink/25 hover:bg-bold-ink/[0.04]"
            style={`transition-delay: ${(i % 2) * 90}ms`}
          >
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-bold-ink font-mono text-xs font-bold text-bold-paper">{s.n}</span>
            <h3 class="font-hanken mt-3 text-[1.05rem] font-medium leading-snug text-bold-ink">{s.title}</h3>
            <p class="mt-3 text-[0.92rem] font-normal leading-relaxed text-bold-ink/65">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="off-your-plate" class="bold-depth-ink relative overflow-hidden py-20 font-hanken md:py-28">
    <div class="container-fb relative">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-mint">What comes off your plate</p>
        <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-paper md:text-[2.2rem]">
          The busywork this replaces, not just the dashboard.
        </h2>
      </div>

      <div data-reveal class="reveal-item mt-12" style="transition-delay: 80ms">
        <div id="plateList" class="grid grid-cols-1 gap-4 md:grid-cols-2">
          {offYourPlate.map((item, i) => (
            <div class="plate-row flex items-center gap-3 border border-bold-paper/15 bg-bold-paper/5 px-5 py-4" style={`--step: ${i}`}>
              <span class="plate-check">
                <svg viewBox="0 0 24 24" fill="none" stroke="#EFF7F2" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m5 13 4 4L19 7" />
                </svg>
              </span>
              <span class="plate-text text-[0.98rem] leading-snug text-bold-paper/80">{item}</span>
            </div>
          ))}
        </div>
        <div class="mt-5 flex items-center justify-between">
          <span id="plateTally" class="font-mono text-sm text-bold-paper/60">0 of {offYourPlate.length} automated</span>
          <button
            type="button"
            id="plateBadge"
            title="Replay"
            aria-label="Replay the automation time-lapse"
            class="plate-badge inline-flex items-center gap-1.5 rounded-full bg-bold-mint-deep px-2.5 py-0.5 font-mono text-xs font-bold text-bold-paper opacity-0 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-bold-mint"
            style="pointer-events: none;"
          >
            <svg class="plate-badge-icon h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12a9 9 0 1 1-2.64-6.36" />
              <path d="M21 3v6h-6" />
            </svg>
            <span>All clear</span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <Cta />
</BaseLayout>

<style>
  .what-ambient-blob {
    position: absolute;
    top: -10%;
    right: -6%;
    width: 28vw;
    height: 28vw;
    max-width: 380px;
    max-height: 380px;
    border-radius: 9999px;
    filter: blur(80px);
    background: radial-gradient(circle, rgba(110, 156, 163, 0.16) 0%, transparent 70%);
  }
</style>

<script>
  import "../scripts/scrollReveal"
  import "../scripts/sectionIconDrift"
  import "../scripts/magneticButton"
  import "../scripts/plateClear"
  import "../scripts/stepTrace"
</script>
