---
import BaseLayout from "../layouts/BaseLayout.astro"
import Cta from "../components/Cta.astro"
import CustomerServiceBackground from "../components/CustomerServiceBackground.astro"
import SectionIcon from "../components/icons/SectionIcon.astro"

const GLOW_SIZE = 420

const capabilities = [
  {
    title: "Order Status & Tracking, Pulled From Live Data",
    description:
      "Customers get a real answer on where their order is and when it'll arrive, pulled straight from live shipment data instead of a guess or a canned reply.",
  },
  {
    title: "Returns & Claims Checked Against the Real Order",
    description:
      "Flowbound checks a return or damage claim against the actual order and shipment record and routes it correctly, so your team isn't chasing down details before they can even start helping.",
  },
  {
    title: "Customer Inquiries Answered in Plain Language",
    description:
      "The same agent that runs your supply chain answers customer questions directly, using your real data, so your team only steps in for the calls that actually need a person.",
  },
  {
    title: "Hands Off When It Actually Matters",
    description:
      "A judgment call, a frustrated customer, an exception to the usual policy: Flowbound routes those straight to your team instead of guessing at an answer it shouldn't give.",
  },
  {
    title: "No Canned Replies",
    description:
      "Every answer comes from your live order, shipment, and inventory data, not a script written for the average case that doesn't quite fit this customer's order.",
  },
  {
    title: "Fewer Repeat Questions For Your Team",
    description:
      "The questions that used to eat an afternoon, where's my order, what happened to my shipment, can I return this, get answered without your team ever touching the ticket.",
  },
]

const sampleQuestions = [
  "Where's my order? It said it would arrive Tuesday.",
  "Can I return this if it doesn't fit?",
  "Why hasn't my shipment moved in three days?",
  "Is this item still in stock in my size?",
  "My order arrived damaged, what do I do?",
  "Can you combine my two open orders into one shipment?",
  "When will my backordered item ship?",
  "Do you have a record of my last order?",
]

const steps = [
  {
    n: "01",
    title: "The customer asks in plain language",
    body: "No ticket form to fill out and no menu to navigate. The customer asks the way they'd ask a person, right where they already are.",
  },
  {
    n: "02",
    title: "Flowbound checks the real order and shipment record",
    body: "The answer comes from live data, the actual order, the actual shipment, the actual return policy, not a guess or a template.",
  },
  {
    n: "03",
    title: "It answers directly, or hands off when it should",
    body: "Most questions get answered on the spot. The ones that need a real judgment call go straight to your team with the context already attached.",
  },
]

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Customer Service",
  applicationCategory: "BusinessApplication",
  description:
    "Flowbound puts your live order, shipment, and inventory data behind a chat agent that answers customers directly, and hands off to your team only when a real judgment call is needed.",
  audience: {
    "@type": "Audience",
    audienceType: "Small and mid-sized businesses",
  },
}
---

<BaseLayout
  title="Customer Service | Flowbound"
  description="Flowbound puts your live order, shipment, and inventory data behind a chat agent that answers customers directly, and hands off to your team only when a real judgment call is needed."
  path="/customer-service"
  schema={schema}
>
  <section class="relative min-h-[560px] overflow-hidden bg-fb-black md:min-h-[680px]">
    <CustomerServiceBackground />
    <div class="absolute inset-0 bg-gradient-to-r from-fb-black/90 from-0% via-fb-black/55 via-55% to-fb-black/10" />
    <div class="absolute inset-0 bg-gradient-to-t from-fb-black via-transparent to-transparent" />

    <div class="container-fb relative flex min-h-[560px] flex-col justify-center py-20 md:min-h-[680px]">
      <div class="mb-5 flex items-center gap-3">
        <SectionIcon name="chat" class="h-6 w-6 text-fb-green-300" />
        <p class="eyebrow text-fb-green-300">Customer Service</p>
      </div>
      <h1 class="max-w-2xl text-[2.5rem] font-semibold leading-[1.08] tracking-tight text-fb-white md:text-[3.2rem]">
        The "where's my order" question, answered before it reaches your team.
      </h1>
      <p class="mt-6 max-w-lg text-[1.05rem] leading-relaxed text-fb-white/65">
        Flowbound puts your live order, shipment, and inventory data behind a chat agent that answers
        customers directly, and hands off to your team only when a real judgment call is needed.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a
          href="#cta"
          class="inline-flex items-center bg-fb-green-500 px-6 py-3.5 font-body font-normal text-fb-white transition-colors hover:bg-fb-green-400"
        >
          Request a pilot
        </a>
        <a
          href="#how"
          class="inline-flex items-center border border-fb-white/25 px-6 py-3.5 font-body font-normal text-fb-white transition-colors hover:border-fb-white/60"
        >
          See how it works
        </a>
      </div>
    </div>
  </section>

  <section id="what" class="border-b border-fb-black/10 bg-fb-paper bg-grain py-20 md:py-28">
    <div class="container-fb">
      <div class="flex items-start justify-between gap-8">
        <div class="max-w-xl">
          <p class="eyebrow mb-4">What it is</p>
          <h2 class="text-[1.9rem] font-semibold leading-tight tracking-tight text-fb-black md:text-[2.2rem]">
            Every "where's my order" question is really a supply chain question.
          </h2>
          <p class="mt-5 text-[0.98rem] leading-relaxed text-fb-black/65">
            Most small teams end up answering the same handful of customer questions over and over by hand,
            and every one of those answers already lives somewhere in your operational data. Flowbound puts
            that live order, shipment, and inventory data behind a chat agent that answers customers
            directly, in plain language, and hands off to your team only when a question actually needs a
            person's judgment.
          </p>
        </div>
        <SectionIcon name="chat" class="hidden h-[7.5rem] w-[7.5rem] shrink-0 text-fb-green-500/[14%] md:block" />
      </div>
    </div>
  </section>

  <section id="capabilities" class="border-b border-fb-black/10 bg-fb-white bg-grain py-20 md:py-28">
    <div class="container-fb">
      <div class="max-w-xl">
        <p class="eyebrow mb-4">What it does</p>
        <h2 class="text-[1.9rem] font-semibold leading-tight tracking-tight text-fb-black md:text-[2.2rem]">
          Built so your team only sees the questions that need them.
        </h2>
      </div>

      <div
        data-glow-container
        data-glow-size={GLOW_SIZE}
        class="relative mt-14 grid grid-cols-1 gap-6 overflow-hidden md:grid-cols-3"
      >
        {capabilities.map((capability, i) => (
          <div class="group relative z-10 overflow-hidden border border-fb-black/10 bg-fb-white p-8 transition-all duration-500 ease-out hover:-translate-y-0.5 hover:border-fb-green-500/35 hover:bg-fb-green-50/50">
            <span class="font-mono text-sm text-fb-green-500">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="mt-3 text-[1.15rem] font-semibold leading-snug text-fb-black">{capability.title}</h3>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-fb-black/65">{capability.description}</p>
            <div class="absolute inset-x-0 bottom-0 h-0.5 origin-center scale-x-0 bg-fb-green-500 transition-transform duration-500 ease-out group-hover:scale-x-100" />
          </div>
        ))}

        <div
          data-glow
          aria-hidden="true"
          class="glow-cursor z-20 rounded-full mix-blend-multiply"
          style={`width: ${GLOW_SIZE}px; height: ${GLOW_SIZE}px; background: radial-gradient(circle, rgba(0,88,64,0.16), transparent 70%);`}
        />
      </div>
    </div>
  </section>

  <section id="examples" class="border-b border-fb-black/10 bg-fb-black py-20 md:py-28">
    <div class="container-fb">
      <div class="max-w-xl">
        <p class="eyebrow text-fb-green-300 mb-4">A few things customers ask</p>
        <h2 class="text-[1.9rem] font-semibold leading-tight tracking-tight text-fb-white md:text-[2.2rem]">
          No special phrasing required. Just the way they'd ask a person.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-2">
        {sampleQuestions.map((question) => (
          <div class="flex items-start gap-3 border border-fb-white/15 bg-fb-white/5 px-5 py-4">
            <SectionIcon name="chat" class="mt-0.5 h-5 w-5 shrink-0 text-fb-green-400" />
            <span class="text-[0.98rem] leading-snug text-fb-white/80">{question}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="how" class="border-b border-fb-black/10 bg-fb-white py-20 md:py-28">
    <div class="container-fb">
      <div class="max-w-xl">
        <p class="eyebrow mb-4">How it works</p>
        <h2 class="text-[1.9rem] font-semibold leading-tight tracking-tight text-fb-black md:text-[2.2rem]">
          From a customer's question to an answer they can trust.
        </h2>
      </div>

      <div
        data-glow-container
        data-glow-size={GLOW_SIZE}
        class="relative mt-12 grid grid-cols-1 gap-6 overflow-hidden md:grid-cols-3"
      >
        {steps.map((s) => (
          <div class="group relative z-10 overflow-hidden border border-fb-green-400/30 bg-fb-green-50 p-8 transition-all duration-500 ease-out hover:-translate-y-0.5 hover:border-fb-green-500/40">
            <span class="font-mono text-sm text-fb-green-500">{s.n}</span>
            <h3 class="relative z-30 mt-3 text-[1.05rem] font-semibold leading-snug text-fb-black">{s.title}</h3>
            <p class="relative z-30 mt-3 text-[0.92rem] leading-relaxed text-fb-black">{s.body}</p>
            <div class="absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-fb-green-500 transition-transform duration-500 ease-out group-hover:scale-x-100" />
          </div>
        ))}

        <div
          data-glow
          aria-hidden="true"
          class="glow-cursor z-20 rounded-full mix-blend-screen"
          style={`width: ${GLOW_SIZE}px; height: ${GLOW_SIZE}px; background: radial-gradient(circle, rgba(255,255,255,0.55), transparent 70%);`}
        />
      </div>
    </div>
  </section>

  <Cta />
</BaseLayout>

<script>
  import "../scripts/hoverGlow"
</script>
