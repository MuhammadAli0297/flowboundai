---
import BaseLayout from "../layouts/BaseLayout.astro"
import Cta from "../components/Cta.astro"
import ProductBackground from "../components/ProductBackground.astro"
import SectionIcon from "../components/icons/SectionIcon.astro"

const GLOW_SIZE = 420

const pillars = [
  {
    tag: "Core",
    title: "Decision Engine",
    body:
      "Every signal that matters, watched around the clock, in one place. Flowbound tracks your inventory levels, supplier lead times, and open purchase orders continuously, and tells you what to do next: reorder, hold, or reroute, before a stockout or an overbuy catches you off guard. This is the part that runs whether or not anyone's looking at a dashboard.",
  },
  {
    tag: "Reasoning",
    title: "Consulting Wrapper",
    body:
      "Every recommendation comes with the reasoning attached, not just the answer. Which numbers it pulled, why this SKU and not another, what changes if you wait a week: the explanation you used to pay a consultant good money for is just there, in plain language, every time.",
  },
  {
    tag: "Interface",
    title: "Ask Flowbound",
    body:
      "The same engine and the same reasoning, available the moment you have a question. Ask why a reorder happened, what a lead time slip would mean for next month, or which supplier is falling behind, and get a straight answer pulled from your live data instead of a help doc or a scheduled call.",
  },
  {
    tag: "Workspace",
    title: "Web App",
    body:
      "Everything above lives in one web app, whitelisted to your team the moment your trial starts. Agent status at a glance, a reorder queue you approve with a click, and Ask Flowbound sitting right alongside it, no separate login and nothing to stitch together yourself.",
  },
]

const steps = [
  {
    n: "01",
    title: "It watches everything, all the time",
    body: "The Decision Engine tracks inventory, lead times, and open orders continuously, and flags the moment something actually needs a call.",
  },
  {
    n: "02",
    title: "It explains the call before you ever ask",
    body: "The Consulting Wrapper attaches the reasoning to every recommendation, and Ask Flowbound is right there if you want to dig into it further.",
  },
  {
    n: "03",
    title: "You act on it in the web app",
    body: "Every recommendation lands in the web app your team is already whitelisted into, ready to approve, edit, or ignore.",
  },
]

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Flowbound Product",
  applicationCategory: "BusinessApplication",
  description:
    "Flowbound is one supply chain decision engine reached four ways: the Decision Engine that watches your operation, the Consulting Wrapper that explains every call, Ask Flowbound for on-demand questions, and the whitelisted web app where your team acts on it.",
  audience: {
    "@type": "Audience",
    audienceType: "Small and mid-sized businesses",
  },
}
---

<BaseLayout
  title="Product | Flowbound"
  description="Flowbound is one supply chain decision engine reached four ways: the Decision Engine that watches your operation, the Consulting Wrapper that explains every call, Ask Flowbound for on-demand questions, and the whitelisted web app where your team acts on it."
  path="/product"
  schema={schema}
>
  <section id="top" class="relative min-h-screen-nav overflow-hidden bg-ocean-900">
    <div class="hero-bg-fade absolute inset-0">
      <ProductBackground />
      <div class="absolute inset-0 bg-gradient-to-r from-ocean-900/90 from-0% via-ocean-900/55 via-55% to-ocean-900/10" />
      <div class="absolute inset-0 bg-gradient-to-t from-ocean-900 via-transparent to-transparent" />
    </div>

    <div class="hero-text-zoom container-fb relative flex min-h-screen-nav flex-col justify-start pb-20 pt-28 font-amulya md:pt-36">
      <div class="mb-5 flex items-center gap-3">
        <SectionIcon name="compass" class="h-6 w-6 text-ocean-100" />
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-ocean-100">Product</p>
      </div>
      <h1 class="max-w-2xl font-amulya text-[2.5rem] font-bold leading-[1.08] tracking-tight text-fb-white md:text-[3.2rem]">
        One decision engine. <span class="font-medium italic text-ocean-100">Four</span> ways to put it to work.
      </h1>
      <p class="mt-6 max-w-lg text-[1.05rem] font-light leading-relaxed text-fb-white/65">
        Decision Engine, Consulting Wrapper, Ask Flowbound, and the web app aren't four separate products
        bolted together. They're one system, reached four ways. Here's how they actually fit together.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a
          href="#cta"
          class="group relative inline-flex items-center gap-2 overflow-hidden rounded-md bg-ocean-500 px-6 py-3.5 font-semibold text-fb-white transition-all duration-300 ease-out hover:-translate-y-0.5 hover:shadow-[0_14px_32px_-10px_rgba(74,111,165,0.55)]"
        >
          <span aria-hidden="true" class="absolute inset-0 origin-left scale-x-0 bg-ocean-900 transition-transform duration-500 ease-out group-hover:scale-x-100" />
          <span class="relative z-10">Request a pilot</span>
          <span aria-hidden="true" class="relative z-10 transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
        </a>
        <a
          href="#how"
          class="group relative inline-flex items-center gap-2 overflow-hidden rounded-md border border-fb-white/25 px-6 py-3.5 font-medium text-fb-white transition-all duration-300 ease-out hover:-translate-y-0.5 hover:border-fb-white/50"
        >
          <span aria-hidden="true" class="absolute inset-0 bg-fb-white/10 opacity-0 transition-opacity duration-300 ease-out group-hover:opacity-100" />
          <span class="relative z-10">See how it works</span>
          <span aria-hidden="true" class="relative z-10 transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <section id="what" class="border-b border-ocean-700/15 bg-ocean-100 bg-grain py-20 font-amulya md:py-28">
    <div class="container-fb">
      <div class="flex items-start justify-between gap-8">
        <div class="reveal-item max-w-xl" data-reveal>
          <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-ocean-950">What it is</p>
          <h2 class="font-amulya text-[1.9rem] font-semibold leading-tight tracking-tight text-ocean-950 md:text-[2.2rem]">
            One engine, working underneath everything else you see.
          </h2>
          <p class="mt-5 text-[0.98rem] font-normal leading-relaxed text-ocean-950">
            It's easy to mistake Flowbound for a handful of separate tools: a dashboard here, a chatbot
            there, a reorder queue somewhere else. Underneath, it's one decision engine watching your
            operation, one reasoning layer explaining what it sees, and two ways to reach it, by asking a
            direct question or by working in the web app your team already lives in. Four ways in, one
            system underneath.
          </p>
        </div>
        <div class="relative hidden shrink-0 md:block" data-icon-drift>
          <span class="icon-pulse-ring absolute inset-0 rounded-full border border-ocean-950/10" aria-hidden="true"></span>
          <SectionIcon name="compass" class="icon-spin relative h-[7.5rem] w-[7.5rem] text-ocean-950/[14%]" />
        </div>
      </div>
    </div>
  </section>

  <section id="pillars" class="border-b border-ocean-700/15 bg-ocean-200 bg-grain py-20 font-amulya md:py-28">
    <div class="container-fb">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-ocean-950">The four pillars</p>
        <h2 class="font-amulya text-[1.9rem] font-semibold leading-tight tracking-tight text-ocean-950 md:text-[2.2rem]">
          Built as one system, not four separate tools.
        </h2>
      </div>

      <div
        data-glow-container
        data-glow-size={GLOW_SIZE}
        class="relative mt-14 grid grid-cols-1 gap-6 overflow-hidden md:grid-cols-2"
      >
        {pillars.map((pillar, i) => (
          <div data-reveal class="reveal-item h-full" style={`transition-delay: ${i * 90}ms`}>
            <div
              data-tilt
              class="tilt-card group relative z-10 h-full overflow-hidden border border-ocean-700/20 bg-ocean-100 p-8 hover:border-ocean-700/45"
            >
              <span class="font-mono text-sm text-ocean-950">{String(i + 1).padStart(2, "0")}</span>
              <span class="ml-3 font-mono text-[0.7rem] uppercase tracking-[0.15em] text-ocean-950">{pillar.tag}</span>
              <h3 class="mt-3 font-amulya text-[1.15rem] font-medium leading-snug text-ocean-950">{pillar.title}</h3>
              <p class="mt-3 text-[0.95rem] font-normal leading-relaxed text-ocean-950">{pillar.body}</p>
              <div class="absolute inset-x-0 bottom-0 h-0.5 origin-center scale-x-0 bg-ocean-500 transition-transform duration-500 ease-out group-hover:scale-x-100" />
            </div>
          </div>
        ))}

        <div
          data-glow
          aria-hidden="true"
          class="glow-cursor z-20 rounded-full mix-blend-multiply"
          style={`width: ${GLOW_SIZE}px; height: ${GLOW_SIZE}px; background: radial-gradient(circle, rgba(74,111,165,0.15), transparent 70%);`}
        />
      </div>
    </div>
  </section>

  <section id="how" class="border-b border-ocean-700/15 bg-ocean-900 py-20 font-amulya md:py-28">
    <div class="container-fb">
      <div class="reveal-item max-w-xl" data-reveal>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-ocean-100">How it works</p>
        <h2 class="font-amulya text-[1.9rem] font-semibold leading-tight tracking-tight text-fb-white md:text-[2.2rem]">
          From a signal in your data to an action your team took.
        </h2>
      </div>

      <div
        data-glow-container
        data-glow-size={GLOW_SIZE}
        class="relative mt-12 grid grid-cols-1 gap-6 overflow-hidden md:grid-cols-3"
      >
        {steps.map((s, i) => (
          <div data-reveal class="reveal-item h-full" style={`transition-delay: ${i * 90}ms`}>
            <div
              data-tilt
              class="tilt-card group relative z-10 h-full overflow-hidden border border-fb-white/15 bg-fb-white/5 p-8 hover:border-ocean-100/40 hover:bg-fb-white/10"
            >
              <span class="font-mono text-sm text-ocean-100">{s.n}</span>
              <h3 class="relative z-30 mt-3 font-amulya text-[1.05rem] font-medium leading-snug text-fb-white">{s.title}</h3>
              <p class="relative z-30 mt-3 text-[0.92rem] font-normal leading-relaxed text-fb-white/60">{s.body}</p>
              <div class="absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-ocean-100 transition-transform duration-500 ease-out group-hover:scale-x-100" />
            </div>
          </div>
        ))}

        <div
          data-glow
          aria-hidden="true"
          class="glow-cursor z-20 rounded-full"
          style={`width: ${GLOW_SIZE}px; height: ${GLOW_SIZE}px; background: radial-gradient(circle, rgba(74,111,165,0.4) 0%, rgba(74,111,165,0.14) 45%, transparent 75%);`}
        />
      </div>
    </div>
  </section>

  <Cta />
</BaseLayout>

<style>
  .hero-bg-fade {
    opacity: calc(1 - var(--hero-scroll, 0) * 1.2);
    will-change: opacity;
  }

  .hero-text-zoom {
    transform: scale(calc(1 + var(--hero-scroll, 0) * 0.55));
    opacity: calc(1 - var(--hero-scroll, 0) * 1.3);
    transform-origin: left center;
    will-change: transform, opacity;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg-fade,
    .hero-text-zoom {
      transform: none;
      opacity: 1;
    }
  }
</style>

<script>
  import "../scripts/hoverGlow"
  import "../scripts/cardTilt"
  import "../scripts/scrollReveal"
  import "../scripts/heroScroll"
  import "../scripts/sectionIconDrift"
</script>
