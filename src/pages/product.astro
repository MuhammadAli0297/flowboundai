---
import BaseLayout from "../layouts/BaseLayout.astro"
import Cta from "../components/Cta.astro"
import ProductBackground from "../components/ProductBackground.astro"
import SectionIcon from "../components/icons/SectionIcon.astro"

const GLOW_SIZE = 420

const pillars = [
  {
    tag: "Core",
    title: "Decision Engine",
    body:
      "Every signal that matters, watched around the clock, in one place. Flowbound tracks your inventory levels, supplier lead times, and open purchase orders continuously, and tells you what to do next: reorder, hold, or reroute, before a stockout or an overbuy catches you off guard. This is the part that runs whether or not anyone's looking at a dashboard.",
  },
  {
    tag: "Reasoning",
    title: "Consulting Wrapper",
    body:
      "Every recommendation comes with the reasoning attached, not just the answer. Which numbers it pulled, why this SKU and not another, what changes if you wait a week: the explanation you used to pay a consultant good money for is just there, in plain language, every time.",
  },
  {
    tag: "Interface",
    title: "Ask Flowbound",
    body:
      "The same engine and the same reasoning, available the moment you have a question. Ask why a reorder happened, what a lead time slip would mean for next month, or which supplier is falling behind, and get a straight answer pulled from your live data instead of a help doc or a scheduled call.",
  },
  {
    tag: "Workspace",
    title: "Web App",
    body:
      "Everything above lives in one web app, whitelisted to your team the moment your trial starts. Agent status at a glance, a reorder queue you approve with a click, and Ask Flowbound sitting right alongside it, no separate login and nothing to stitch together yourself.",
  },
]

const steps = [
  {
    n: "01",
    title: "It watches everything, all the time",
    body: "The Decision Engine tracks inventory, lead times, and open orders continuously, and flags the moment something actually needs a call.",
  },
  {
    n: "02",
    title: "It explains the call before you ever ask",
    body: "The Consulting Wrapper attaches the reasoning to every recommendation, and Ask Flowbound is right there if you want to dig into it further.",
  },
  {
    n: "03",
    title: "You act on it in the web app",
    body: "Every recommendation lands in the web app your team is already whitelisted into, ready to approve, edit, or ignore.",
  },
]

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Flowbound Product",
  applicationCategory: "BusinessApplication",
  description:
    "Flowbound is one supply chain decision engine reached four ways: the Decision Engine that watches your operation, the Consulting Wrapper that explains every call, Ask Flowbound for on-demand questions, and the whitelisted web app where your team acts on it.",
  audience: {
    "@type": "Audience",
    audienceType: "Small and mid-sized businesses",
  },
}
---

<BaseLayout
  title="Product | Flowbound"
  description="Flowbound is one supply chain decision engine reached four ways: the Decision Engine that watches your operation, the Consulting Wrapper that explains every call, Ask Flowbound for on-demand questions, and the whitelisted web app where your team acts on it."
  path="/product"
  schema={schema}
>
  <section class="relative min-h-[560px] overflow-hidden bg-fb-black md:min-h-[680px]">
    <ProductBackground />
    <div class="absolute inset-0 bg-gradient-to-r from-fb-black/90 from-0% via-fb-black/55 via-55% to-fb-black/10" />
    <div class="absolute inset-0 bg-gradient-to-t from-fb-black via-transparent to-transparent" />

    <div class="container-fb relative flex min-h-[560px] flex-col justify-center py-20 md:min-h-[680px]">
      <div class="mb-5 flex items-center gap-3">
        <SectionIcon name="compass" class="h-6 w-6 text-fb-green-300" />
        <p class="eyebrow text-fb-green-300">Product</p>
      </div>
      <h1 class="max-w-2xl text-[2.5rem] font-semibold leading-[1.08] tracking-tight text-fb-white md:text-[3.2rem]">
        One decision engine. Four ways to put it to work.
      </h1>
      <p class="mt-6 max-w-lg text-[1.05rem] leading-relaxed text-fb-white/65">
        Decision Engine, Consulting Wrapper, Ask Flowbound, and the web app aren't four separate products
        bolted together. They're one system, reached four ways. Here's how they actually fit together.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a
          href="#cta"
          class="inline-flex items-center bg-fb-green-500 px-6 py-3.5 font-body font-normal text-fb-white transition-colors hover:bg-fb-green-400"
        >
          Request a pilot
        </a>
        <a
          href="#how"
          class="inline-flex items-center border border-fb-white/25 px-6 py-3.5 font-body font-normal text-fb-white transition-colors hover:border-fb-white/60"
        >
          See how it works
        </a>
      </div>
    </div>
  </section>

  <section id="what" class="border-b border-fb-black/10 bg-fb-paper bg-grain py-20 md:py-28">
    <div class="container-fb">
      <div class="flex items-start justify-between gap-8">
        <div class="max-w-xl">
          <p class="eyebrow mb-4">What it is</p>
          <h2 class="text-[1.9rem] font-semibold leading-tight tracking-tight text-fb-black md:text-[2.2rem]">
            One engine, working underneath everything else you see.
          </h2>
          <p class="mt-5 text-[0.98rem] leading-relaxed text-fb-black/65">
            It's easy to mistake Flowbound for a handful of separate tools: a dashboard here, a chatbot
            there, a reorder queue somewhere else. Underneath, it's one decision engine watching your
            operation, one reasoning layer explaining what it sees, and two ways to reach it, by asking a
            direct question or by working in the web app your team already lives in. Four ways in, one
            system underneath.
          </p>
        </div>
        <SectionIcon name="compass" class="hidden h-[7.5rem] w-[7.5rem] shrink-0 text-fb-green-500/[14%] md:block" />
      </div>
    </div>
  </section>

  <section id="pillars" class="border-b border-fb-black/10 bg-fb-white bg-grain py-20 md:py-28">
    <div class="container-fb">
      <div class="max-w-xl">
        <p class="eyebrow mb-4">The four pillars</p>
        <h2 class="text-[1.9rem] font-semibold leading-tight tracking-tight text-fb-black md:text-[2.2rem]">
          Built as one system, not four separate tools.
        </h2>
      </div>

      <div
        data-glow-container
        data-glow-size={GLOW_SIZE}
        class="relative mt-14 grid grid-cols-1 gap-6 overflow-hidden md:grid-cols-2"
      >
        {pillars.map((pillar, i) => (
          <div class="group relative z-10 overflow-hidden border border-fb-black/10 bg-fb-white p-8 transition-all duration-500 ease-out hover:-translate-y-0.5 hover:border-fb-green-500/35 hover:bg-fb-green-50/50">
            <span class="font-mono text-sm text-fb-green-500">{String(i + 1).padStart(2, "0")}</span>
            <span class="ml-3 font-mono text-[0.7rem] uppercase tracking-[0.15em] text-fb-green-500">{pillar.tag}</span>
            <h3 class="mt-3 text-[1.15rem] font-semibold leading-snug text-fb-black">{pillar.title}</h3>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-fb-black/65">{pillar.body}</p>
            <div class="absolute inset-x-0 bottom-0 h-0.5 origin-center scale-x-0 bg-fb-green-500 transition-transform duration-500 ease-out group-hover:scale-x-100" />
          </div>
        ))}

        <div
          data-glow
          aria-hidden="true"
          class="glow-cursor z-20 rounded-full mix-blend-multiply"
          style={`width: ${GLOW_SIZE}px; height: ${GLOW_SIZE}px; background: radial-gradient(circle, rgba(0,88,64,0.16), transparent 70%);`}
        />
      </div>
    </div>
  </section>

  <section id="how" class="border-b border-fb-black/10 bg-fb-black py-20 md:py-28">
    <div class="container-fb">
      <div class="max-w-xl">
        <p class="eyebrow text-fb-green-300 mb-4">How it works</p>
        <h2 class="text-[1.9rem] font-semibold leading-tight tracking-tight text-fb-white md:text-[2.2rem]">
          From a signal in your data to an action your team took.
        </h2>
      </div>

      <div
        data-glow-container
        data-glow-size={GLOW_SIZE}
        class="relative mt-12 grid grid-cols-1 gap-6 overflow-hidden md:grid-cols-3"
      >
        {steps.map((s) => (
          <div class="group relative z-10 overflow-hidden border border-fb-white/15 bg-fb-white/5 p-8 transition-all duration-500 ease-out hover:-translate-y-0.5 hover:border-fb-green-400/40 hover:bg-fb-white/10">
            <span class="font-mono text-sm text-fb-green-400">{s.n}</span>
            <h3 class="relative z-30 mt-3 text-[1.05rem] font-semibold leading-snug text-fb-white">{s.title}</h3>
            <p class="relative z-30 mt-3 text-[0.92rem] leading-relaxed text-fb-white/60">{s.body}</p>
            <div class="absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-fb-green-400 transition-transform duration-500 ease-out group-hover:scale-x-100" />
          </div>
        ))}

        <div
          data-glow
          aria-hidden="true"
          class="glow-cursor z-20 rounded-full"
          style={`width: ${GLOW_SIZE}px; height: ${GLOW_SIZE}px; background: radial-gradient(circle, rgba(70,139,121,0.4) 0%, rgba(70,139,121,0.14) 45%, transparent 75%);`}
        />
      </div>
    </div>
  </section>

  <Cta />
</BaseLayout>

<script>
  import "../scripts/hoverGlow"
</script>
