---
/**
 * Generated card thumbnail for a blog post: no photography or per-post image
 * assets to source or maintain as the blog scales, just the post's category
 * icon on the same dark, ocean-glow "vibe" as the hero background, so every
 * card reads as one system no matter how many posts get added later.
 */
import SectionIcon from "./icons/SectionIcon.astro"
import { categoryIcon } from "../data/blogCategories"

interface Props {
  category: string
  class?: string
}

const { category, class: className = "" } = Astro.props
---

<div class={`relative flex items-center justify-center overflow-hidden bg-ocean-900 ${className}`} aria-hidden="true">
  <div
    class="absolute inset-0"
    style="background: radial-gradient(circle at 50% 45%, rgba(74,111,165,0.4), transparent 65%);"
  />
  <div class="absolute h-16 w-16 rounded-full border border-ocean-100/25" />
  <SectionIcon name={categoryIcon(category)} class="relative h-9 w-9 text-ocean-100" />
</div>
