---
// Blog hero background: "Insight Stream", ocean-palette, canvas 2D (not SMIL, see
// src/scripts/blogHero.ts). A fixed `document` hub near the right edge sends comet-trail pulses
// outward to a spread of small open-book "reader" nodes, the only hero on the site where signal
// flows out of the hub rather than converging into it. Everything the script draws is clipped to
// the right portion of the canvas so the animation can never cross under the hero copy, and the
// node field spans the full height of that strip rather than clustering in the middle.
---

<div class="hero-canvas-wrap absolute inset-0 overflow-hidden" aria-hidden="true">
  <div class="hero-base-gradient absolute inset-0"></div>
  <canvas id="blog-hero" class="absolute inset-0 h-full w-full"></canvas>
  <div class="absolute inset-0 bg-grain opacity-20 mix-blend-overlay"></div>
</div>

<style>
  .hero-base-gradient {
    background:
      radial-gradient(85% 65% at 80% 45%, rgba(22, 96, 136, 0.34), transparent 60%),
      radial-gradient(65% 55% at 94% 85%, rgba(79, 109, 122, 0.24), transparent 60%),
      #104866;
  }
</style>

<script>
  import "../scripts/blogHero"
</script>
