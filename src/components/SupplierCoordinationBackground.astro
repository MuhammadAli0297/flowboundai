---
// Supplier Coordination hero background: "Supplier Pulse", ocean-palette, canvas 2D (see
// src/scripts/supplierCoordinationHero.ts). A fixed network hub sits among several supplier
// nodes that mostly just breathe calmly; one, a different one each cycle, escalates and sends a
// comet-trail signal into the hub before settling back down. The hub does not rotate.
---

<div class="hero-canvas-wrap absolute inset-0 overflow-hidden" aria-hidden="true">
  <div class="hero-base-gradient absolute inset-0"></div>
  <canvas id="supplier-coordination-hero" class="absolute inset-0 h-full w-full"></canvas>
  <div class="absolute inset-0 bg-grain opacity-20 mix-blend-overlay"></div>
</div>

<style>
  .hero-base-gradient {
    background:
      radial-gradient(85% 70% at 68% 50%, rgba(74, 111, 165, 0.26), transparent 60%),
      radial-gradient(70% 60% at 98% 85%, rgba(79, 109, 122, 0.22), transparent 60%),
      #104866;
  }
</style>

<script>
  import "../scripts/supplierCoordinationHero"
</script>
