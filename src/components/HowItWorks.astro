---
// Hot Sauce rebuild: "an annotated line diagram, not four cards" (approved mockup still 04). A
// thin horizontal line with small dotted leaders to floating mono labels, alternating above and
// below so nothing collides, instead of the old four-card grid.
//
// Signal Primitives merge: the connecting line and each node used to just fade in once with the
// section's own data-reveal. It's now genuinely scroll-linked (howItWorksDiagram.ts), the "Scroll"
// primitive approved in the lab: the line fills in with real scroll position and each node lights
// up as the fill reaches it, reversing cleanly on scroll back up. The old hardcoded "03 Decide is
// already active" state is gone, every node now reflects the same live progress.
const steps = [
  { n: "01", title: "Connect", body: "Point Flowbound at your ERP, spreadsheets, or supplier feeds. No migration, no new system of record.", x: 8, above: false },
  { n: "02", title: "Read the signal", body: "Inventory, lead times, open orders, and demand history reconciled continuously, not once a month.", x: 36, above: true },
  { n: "03", title: "Decide", body: "A reorder, a hold, or a reroute, with the reasoning attached, not just a dashboard.", x: 64, above: false },
  { n: "04", title: "Ask anything", body: "The same engine answers your team's questions in plain language, from the same live data.", x: 92, above: true },
]
---

<section id="how-it-works" class="relative overflow-hidden border-t border-bold-ink/8 bg-bold-paper py-20 font-hanken md:py-28">
  <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
  <!-- One muted ambient wash, same low-opacity teal recipe as Mission's blob: plain paper + grain
       alone read flat (direct feedback), but the bright bold-mist tint tried first read too
       saturated/out of place next to the rest of the muted palette. Teal at ~16% is the middle
       ground, atmosphere without a color statement. -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <span class="diagram-ambient-blob"></span>
  </div>
  <div class="container-fb relative">
    <div data-reveal class="reveal-item max-w-xl">
      <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">How it works</p>
      <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
        From raw signal to a decision you can act on.
      </h2>
    </div>

    <!-- Desktop: the annotated line diagram. Mobile: a simple stacked list (the leader/label
         geometry below assumes real horizontal room to alternate above/below without collision,
         which a narrow viewport doesn't have). -->
    <div data-reveal class="diagram-track reveal-item relative mt-28 hidden md:block md:h-[11rem]">
      <div class="absolute inset-x-[4%] top-1/2 h-[1.5px] bg-bold-ink/15" aria-hidden="true" />
      <div data-diagram-line class="absolute inset-x-[4%] top-1/2 h-[1.5px] origin-left bg-bold-mint-deep" aria-hidden="true" />
      {steps.map((s) => (
        <div class="absolute top-1/2" style={`left: ${s.x}%;`} data-diagram-node={s.x}>
          <span
            data-diagram-dot
            class="absolute left-1/2 top-1/2 h-3.5 w-3.5 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-bold-ink bg-bold-mist/30"
            aria-hidden="true"
          />
          <span
            class={`absolute left-1/2 w-px border-l border-dashed border-bold-ink/35 ${s.above ? "bottom-[calc(50%+0.4rem)] h-9" : "top-[calc(50%+0.4rem)] h-9"}`}
            aria-hidden="true"
          />
          <div
            class={`absolute w-40 ${s.above ? "bottom-[calc(50%+2.9rem)]" : "top-[calc(50%+2.9rem)]"}`}
            style={`left: ${s.x > 70 ? "auto" : "50%"}; right: ${s.x > 70 ? "0" : "auto"}; transform: ${s.x > 70 ? "none" : "translateX(-12%)"};`}
          >
            <span data-diagram-label class="block font-mono text-[0.78rem] font-bold text-bold-ink">{s.n} {s.title}</span>
            <span class="mt-1 block font-mono text-[0.72rem] leading-snug text-bold-ink/55">{s.body}</span>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-10 grid grid-cols-1 gap-5 md:hidden">
      {steps.map((s) => (
        <div data-reveal class="reveal-item border-l-2 border-bold-ink/15 pl-4" style={`transition-delay: ${steps.indexOf(s) * 80}ms`}>
          <span class="font-mono text-[0.78rem] font-bold text-bold-ink">{s.n} {s.title}</span>
          <p class="mt-1.5 text-[0.9rem] leading-relaxed text-bold-ink/65">{s.body}</p>
        </div>
      ))}
    </div>

    <div data-reveal class="reveal-item mt-14 flex justify-center md:mt-28" style="transition-delay: 420ms">
      <a href="/how-it-works/" data-magnetic class="bold-btn bold-btn-ink bold-btn-lg group">
        <span>See how it works in depth</span>
        <span aria-hidden="true" class="transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
      </a>
    </div>
  </div>
</section>

<style>
  .diagram-ambient-blob {
    position: absolute;
    top: -15%;
    right: -5%;
    width: 30vw;
    height: 30vw;
    max-width: 420px;
    max-height: 420px;
    border-radius: 9999px;
    filter: blur(80px);
    background: radial-gradient(circle, rgba(110, 156, 163, 0.16) 0%, transparent 70%);
    animation: diagram-ambient-drift 24s ease-in-out infinite;
  }

  @keyframes diagram-ambient-drift {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-3vw, 3vh); }
  }

  @media (prefers-reduced-motion: reduce) {
    .diagram-ambient-blob {
      animation: none;
    }
  }
</style>

<script>
  import "../scripts/scrollReveal"
  import "../scripts/howItWorksDiagram"
  import "../scripts/magneticButton"
</script>
