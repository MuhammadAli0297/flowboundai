---
import SectionIcon from "./icons/SectionIcon.astro"

const steps = [
  {
    n: "01",
    title: "Connect your systems",
    body: "Point Flowbound at your ERP, spreadsheets, or supplier feeds. No migration, no new system of record.",
  },
  {
    n: "02",
    title: "The engine reads the signal",
    body: "Inventory levels, lead times, open orders, and demand history get reconciled continuously, not once a month.",
  },
  {
    n: "03",
    title: "You get a decision, not a dashboard",
    body: "Reorder 400 units from Supplier B, expedite shipment #4471, or hold the PO to Supplier A. Every call comes with the reasoning attached.",
  },
  {
    n: "04",
    title: "Ask it anything",
    body: "The same engine answers your team's questions in plain language, pulling from the same live data behind the decision.",
  },
]

const GLOW_SIZE = 420

// Node x-positions (percent) line up with the four step cards in the md:grid-cols-4 layout; the
// path itself is just a gentle wave threading through them, echoing the hero's wave motif.
const nodeX = [12.5, 37.5, 62.5, 87.5]
---

<section id="how-it-works" class="border-b border-ocean-700/15 bg-ocean-200 py-20 font-amulya md:py-28">
  <div class="container-fb">
    <div class="reveal-item max-w-xl" data-reveal>
      <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-ocean-950">How it works</p>
      <h2 class="font-amulya text-[1.9rem] font-semibold leading-tight tracking-tight text-ocean-950 md:text-[2.2rem]">
        From raw signal to a decision you can act on.
      </h2>
    </div>

    <!-- the flow line lives in its own strip above the grid, not behind the cards: a grid's
         column gaps run the full row height, so a line placed behind the cards showed through
         in every gap between them. Drawn in via stroke-dashoffset once it scrolls into view.
         Nodes and their drip-connectors are plain HTML, not SVG circles, because the wave needs
         to stretch full-bleed and a squashed <circle> in a non-uniformly scaled viewBox renders
         as an oval; HTML dots sidestep that and stay true circles at any width.
         The viewBox is 1000x40, chosen to sit close to the strip's real rendered pixel size
         (roughly 700-1400px wide by 40px tall) rather than the tiny abstract 100x6 units tried
         first: that earlier version needed such extreme non-uniform scaling (~11x horizontal,
         ~6.7x vertical) that vector-effect="non-scaling-stroke" and stroke-dasharray stopped
         agreeing on what a "unit" was, and the line rendered as broken fragments instead of one
         continuous stroke. Staying near real pixel proportions keeps the stretch mild and the
         stroke math sane, so non-scaling-stroke isn't needed at all. -->
    <div data-reveal class="flow-line relative mt-8 hidden h-[4.75rem] md:block">
      <svg
        class="absolute inset-x-0 top-0 h-10 w-full"
        viewBox="0 0 1000 40"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          class="flow-line-path"
          d="M125,20 C250,10 250,10 375,20 C500,30 500,30 625,20 C750,10 750,10 875,20"
          fill="none"
          stroke="#4A6FA5"
          stroke-width="1.5"
          stroke-linecap="round"
        />
      </svg>
      {nodeX.map((x, i) => {
        const delay = 0.35 + i * 0.3
        return (
          <>
            {/* delay is inline, not nth-of-type, because connector and node spans interleave in
                the DOM (Astro flattens the fragment), so they don't get clean per-tag indices */}
            <span
              class="flow-line-connector absolute top-5"
              style={`left: ${x}%; transition-delay: ${(delay + 0.1).toFixed(2)}s;`}
              aria-hidden="true"
            />
            <span
              class="flow-line-node absolute top-5 rounded-full bg-ocean-500"
              style={`left: ${x}%; transition-delay: ${delay}s; animation-delay: ${delay}s;`}
              aria-hidden="true"
            />
          </>
        )
      })}
    </div>

    <div data-glow-container data-glow-size={GLOW_SIZE} class="relative mt-12 grid grid-cols-1 gap-6 overflow-hidden md:mt-0 md:grid-cols-4">
      {steps.map((s, i) => (
        <div data-reveal class="reveal-item relative h-full" style={`transition-delay: ${i * 90}ms`}>
          <div
            data-tilt
            class="tilt-card group relative z-10 h-full overflow-hidden border border-ocean-700/20 bg-ocean-100 p-8 hover:border-ocean-700/45"
          >
            <span class="font-mono text-sm text-ocean-950">{s.n}</span>
            <h3 class="relative z-30 mt-3 font-amulya text-[1.05rem] font-medium leading-snug text-ocean-950">{s.title}</h3>
            <p class="relative z-30 mt-3 text-[0.92rem] font-normal leading-relaxed text-ocean-950">{s.body}</p>
            <div class="absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-ocean-500 transition-transform duration-500 ease-out group-hover:scale-x-100" />
          </div>
        </div>
      ))}

      <!-- rendered last so it paints on top of the cards; multiply blend darkens
           the light card surface toward blue under the cursor -->
      <div
        data-glow
        aria-hidden="true"
        class="glow-cursor z-20 rounded-full mix-blend-multiply"
        style={`width: ${GLOW_SIZE}px; height: ${GLOW_SIZE}px; background: radial-gradient(circle, rgba(74,111,165,0.15), transparent 70%);`}
      />
    </div>

    <div class="reveal-item mt-12 flex justify-center" data-reveal style="transition-delay: 380ms">
      <a
        href="/how-it-works"
        class="group relative inline-flex min-w-[19rem] items-center justify-center gap-3 overflow-hidden rounded-full bg-ocean-700 px-10 py-4 font-amulya font-semibold text-fb-white transition-all duration-300 ease-out hover:-translate-y-0.5 hover:gap-4 hover:shadow-[0_12px_30px_-10px_rgba(79,109,122,0.45)]"
      >
        <span aria-hidden="true" class="absolute inset-0 origin-left scale-x-0 bg-ocean-600 transition-transform duration-500 ease-out group-hover:scale-x-100" />
        <SectionIcon name="gear" class="relative z-10 h-5 w-5 shrink-0 text-fb-white transition-transform duration-500 ease-out group-hover:rotate-45" />
        <span class="relative z-10">See how it works in depth</span>
        <span aria-hidden="true" class="relative z-10 transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
      </a>
    </div>
  </div>
</section>

<style>
  .flow-line-path {
    stroke-dasharray: 800;
    stroke-dashoffset: 800;
    opacity: 0.7;
    transition: stroke-dashoffset 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.15s;
  }

  .flow-line.is-revealed .flow-line-path {
    stroke-dashoffset: 0;
  }

  /* real circles, not SVG <circle> elements: the wave above is stretched non-uniformly to fill
     the strip's width, which would squash a circle into an oval. Centered on its (left, top)
     point with a static translate so the pulse keyframes below can layer a scale on top of it
     without clobbering that centering (a transform is one property, so both have to live in the
     same declaration). */
  .flow-line-node {
    width: 0.5rem;
    height: 0.5rem;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 0.4s ease-out;
  }

  @keyframes flow-line-pulse {
    0%, 100% {
      opacity: 0.65;
      transform: translate(-50%, -50%) scale(1);
    }
    50% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.5);
    }
  }

  /* the fade-in is a transition (so it respects the staggered delay set inline per node); once
     visible, an infinite animation takes over the pulse. The animation only starts once
     .is-revealed is applied, so it never fights the transition for control before that. */
  .flow-line.is-revealed .flow-line-node {
    opacity: 0.65;
    animation: flow-line-pulse 2.6s ease-in-out infinite;
  }

  /* the drip that ties each node down into its card: a thin gradient line, hidden behind a
     scaleY(0) until reveal, then it grows downward (transform-origin: top) right after its node
     fades in, so the signal visibly lands in the tile instead of floating above it. */
  .flow-line-connector {
    width: 1px;
    height: 3.5rem;
    background: linear-gradient(to bottom, rgba(74, 111, 165, 0.55), transparent);
    transform: translateX(-50%) scaleY(0);
    transform-origin: top;
    opacity: 0;
    transition: opacity 0.5s ease-out, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .flow-line.is-revealed .flow-line-connector {
    opacity: 1;
    transform: translateX(-50%) scaleY(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .flow-line-path {
      stroke-dashoffset: 0;
      transition: none;
    }
    .flow-line-node,
    .flow-line.is-revealed .flow-line-node {
      opacity: 0.65;
      transition: none;
      animation: none;
    }
    .flow-line-connector,
    .flow-line.is-revealed .flow-line-connector {
      opacity: 1;
      transform: translateX(-50%) scaleY(1);
      transition: none;
    }
  }
</style>

<script>
  import "../scripts/hoverGlow"
  import "../scripts/cardTilt"
  import "../scripts/scrollReveal"
</script>
