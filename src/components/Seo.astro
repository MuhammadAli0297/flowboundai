---
interface Props {
  title: string
  description: string
  path?: string
  ogImage?: string
  schema?: Record<string, unknown> | Record<string, unknown>[]
  noindex?: boolean
}

const {
  title,
  description,
  path = Astro.url.pathname,
  ogImage = "/og-image.png",
  schema,
  noindex = false,
} = Astro.props

const canonicalPath = path.endsWith("/") ? path : `${path}/`
const canonical = new URL(canonicalPath, Astro.site).toString()
const ogImageUrl = new URL(ogImage, Astro.site).toString()

// Rendered on every page unconditionally so the whole site shares one Organization/WebSite entity
// instead of leaving Google to infer "Flowbound the company" from scattered per-page fragments. No
// `sameAs` until real social profiles exist, don't add placeholder links. No `SearchAction` either:
// the blog's search box (blogFilter.ts) is client-side only and never reflects its query in the
// URL, so a sitelinks searchbox claim would describe a capability that doesn't actually work.
const baseSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Flowbound",
    url: Astro.site,
    logo: new URL("/logo-mark-ocean.svg", Astro.site).toString(),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Flowbound",
    url: Astro.site,
  },
]
const schemaList = [...baseSchema, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])]
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Flowbound" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:url" content={canonical} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

{schemaList.map((item) => <script type="application/ld+json" is:inline set:html={JSON.stringify(item)} />)}
