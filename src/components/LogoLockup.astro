---
import LogoMark from "./LogoMark.astro"

interface Props {
  dark?: boolean
}

const { dark = false } = Astro.props
---

<div class="flex items-center gap-2.5">
  <LogoMark size={30} palette="bold" ring={dark} id={dark ? "footer-mark" : "nav-mark"} />
  <span class:list={["font-hanken text-[1.15rem] font-bold tracking-tight", dark ? "text-bold-paper" : "text-bold-ink"]}>
    Flowbound<span class:list={["font-medium", dark ? "text-bold-mist" : "text-bold-ink"]}>.ai</span>
  </span>
</div>
