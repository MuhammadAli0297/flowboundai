---
// Ask Flowbound hero background: "Signal Field", ocean-palette, canvas 2D (not SMIL, not WebGL,
// see src/scripts/askFlowboundHero.ts). A spark hub near the right edge sends and receives
// comet-trail pulses to/from a scattered field of drifting data nodes, with slow sonar-style
// ripple rings breathing outward from the hub. Everything the script draws is clipped to the
// right portion of the canvas so the animation can never cross under the hero copy, and the node
// field spans the full height of that strip rather than clustering in the middle.
---

<div class="hero-canvas-wrap absolute inset-0 overflow-hidden" aria-hidden="true">
  <div class="hero-base-gradient absolute inset-0"></div>
  <canvas id="ask-flowbound-hero" class="absolute inset-0 h-full w-full"></canvas>
  <div class="absolute inset-0 bg-grain opacity-20 mix-blend-overlay"></div>
</div>

<style>
  .hero-base-gradient {
    background:
      radial-gradient(90% 70% at 82% 40%, rgba(74, 111, 165, 0.28), transparent 60%),
      radial-gradient(70% 60% at 95% 85%, rgba(79, 109, 122, 0.24), transparent 60%),
      #104866;
  }
</style>

<script>
  import "../scripts/askFlowboundHero"
</script>
