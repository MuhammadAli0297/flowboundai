---
/**
 * Full-bleed ambient hero background for the Reorder page. Same dark,
 * glowing, green-on-black "vibe" as the other hero backgrounds, but a
 * distinct composition: the bolt icon sits fixed as the hub, a stock gauge
 * on the left drains toward a dashed reorder-point line and fires a pulse
 * into the hub the moment it crosses, and the hub fires straight back out
 * to two purchase-order nodes that flash to life in response.
 */
const hubX = 1200
const hubY = 460

const gaugeX = 860
const gaugeY = 460
const gaugeTop = -40
const gaugeBottom = 40
const thresholdY = -4

const orders = [
  { x: 1460, y: 320, delay: 0 },
  { x: 1470, y: 610, delay: 1.8 },
]

const gaugePath = `M${gaugeX},${gaugeY} L${hubX},${hubY}`

// The "bolt" icon path (SectionIcon), recentred on (0,0) so it can be used as the fixed hub.
const boltPath = "M2,-20 L-10,2 L-2,2 L-6,20 L10,-4 L0,-4 Z"
---

<svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 h-full w-full" aria-hidden="true">
  <defs>
    <radialGradient id="ro-hub-glow-outer" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#468B79" stop-opacity="0.36" />
      <stop offset="55%" stop-color="#468B79" stop-opacity="0.16" />
      <stop offset="100%" stop-color="#468B79" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="ro-hub-glow-inner" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#8FD0B8" stop-opacity="0.45" />
      <stop offset="100%" stop-color="#468B79" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="ro-gauge-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#468B79" stop-opacity="0.4" />
      <stop offset="100%" stop-color="#468B79" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="ro-order-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#8FD0B8" stop-opacity="0.55" />
      <stop offset="100%" stop-color="#468B79" stop-opacity="0" />
    </radialGradient>
  </defs>

  <circle cx={hubX} cy={hubY} r="620" fill="url(#ro-hub-glow-outer)" />
  <circle cx={hubX} cy={hubY} r="280" fill="url(#ro-hub-glow-inner)" />

  <path d={gaugePath} fill="none" stroke="#1F4438" stroke-width="1.5" stroke-opacity="0.5" />
  <circle r="4.5" fill="#C7E3DA">
    <animateMotion dur="6s" repeatCount="indefinite" path={gaugePath} keyPoints="0;0;1;1" keyTimes="0;0.55;0.72;1" calcMode="linear" />
    <animate attributeName="opacity" values="0;0;1;1;0;0" keyTimes="0;0.55;0.62;0.72;0.8;1" dur="6s" repeatCount="indefinite" />
  </circle>

  <circle cx={gaugeX} cy={gaugeY} r="60" fill="url(#ro-gauge-glow)" />
  <g transform={`translate(${gaugeX} ${gaugeY})`}>
    <rect x="-16" y={gaugeTop} width="32" height={gaugeBottom - gaugeTop} rx="4" fill="#0C1F19" stroke="#2C6E58" stroke-width="1.5" stroke-opacity="0.85" />
    <rect x="-16" width="32" rx="4" fill="#468B79" fill-opacity="0.55">
      <animate attributeName="y" values={`${gaugeTop};${gaugeTop};26;${gaugeTop};${gaugeTop}`} keyTimes="0;0.5;0.68;0.72;1" dur="6s" repeatCount="indefinite" />
      <animate attributeName="height" values={`${gaugeBottom - gaugeTop};${gaugeBottom - gaugeTop};14;${gaugeBottom - gaugeTop};${gaugeBottom - gaugeTop}`} keyTimes="0;0.5;0.68;0.72;1" dur="6s" repeatCount="indefinite" />
    </rect>
    <line x1="-20" y1={thresholdY} x2="20" y2={thresholdY} stroke="#8FD0B8" stroke-width="1.5" stroke-dasharray="3 3" stroke-opacity="0.8" />
  </g>

  {orders.map((o) => (
    <g>
      <path d={`M${hubX},${hubY} L${o.x},${o.y}`} fill="none" stroke="#1F4438" stroke-width="1.5" stroke-opacity="0.45" class="fb-dash-flow" />
      <circle cx={o.x} cy={o.y} r="30" fill="url(#ro-order-glow)" />
      <g transform={`translate(${o.x} ${o.y})`}>
        <g class="fb-float" style={`animation-delay: ${o.delay * 0.4}s`}>
          <rect x="-12" y="-10" width="24" height="20" rx="4" fill="#003828" stroke="#8FD0B8" stroke-width="1.6" stroke-opacity="0.95" />
          <path d="M-5,0 L-1,5 L6,-5" fill="none" stroke="#C7E3DA" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      </g>
    </g>
  ))}

  <circle
    cx={hubX}
    cy={hubY}
    r="92"
    fill="none"
    stroke="#8FD0B8"
    stroke-opacity="0.5"
    class="fb-core-pulse-ring"
    style={`transform-origin: ${hubX}px ${hubY}px`}
  />

  <g transform={`translate(${hubX} ${hubY})`} class="fb-core-breathe">
    <path d={boltPath} transform="scale(3.1)" fill="#003828" stroke="#8FD0B8" stroke-width="1.4" stroke-linejoin="round" />
  </g>
</svg>
