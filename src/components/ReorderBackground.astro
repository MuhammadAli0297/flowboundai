---
// Reorder hero background: "Threshold Drop", ocean-palette, canvas 2D (see
// src/scripts/reorderHero.ts). A vertical stock gauge drains toward a dashed reorder-point line;
// the instant it crosses, a flash fires a bolt-shaped streak into the fixed hub, which immediately
// fires back out to three purchase-order nodes lighting up in sequence, before the gauge resets
// and drains again. The hub does not rotate.
---

<div class="hero-canvas-wrap absolute inset-0 overflow-hidden" aria-hidden="true">
  <div class="hero-base-gradient absolute inset-0"></div>
  <canvas id="reorder-hero" class="absolute inset-0 h-full w-full"></canvas>
  <div class="absolute inset-0 bg-grain opacity-20 mix-blend-overlay"></div>
</div>

<style>
  .hero-base-gradient {
    background:
      radial-gradient(85% 70% at 78% 50%, rgba(74, 111, 165, 0.26), transparent 60%),
      radial-gradient(70% 60% at 62% 85%, rgba(79, 109, 122, 0.22), transparent 60%),
      #104866;
  }
</style>

<script>
  import "../scripts/reorderHero"
</script>
