---
// Hot Sauce rebuild: the "bento capability grid" from the approved mockup (still 03). One tile
// gets real weight (with an actual sparkline, not a decorative icon) while five smaller ones sit
// around it, the asymmetric module-grid pattern instead of a uniform card row. Content mirrors the
// same five capabilities the mockup used, pulled from src/data/services.ts so the claims stay
// accurate to what each capability page actually says.
//
// Signal Primitives merge: the flat per-tile tone colors (bg-bold-mist / bg-bold-paper alternating)
// are gone, replaced by the two tile treatments approved in the Signal Primitives lab. The lead
// tile gets the featured glass + ink-to-mint gradient ring treatment (.bold-tile-feature, reserved
// for the one tile worth remembering, paired with cardTilt.ts via [data-tilt]); the five small
// tiles switch to the ink-tint + numbered-badge treatment /reorder already established
// (border-bold-ink/8 bg-bold-paper, hover:bg-bold-ink/[0.04], a small solid bg-bold-ink circle
// badge), closing a consistency gap between the homepage and the one capability page already built
// this way, rather than inventing a third pattern.
const tiles = [
  {
    big: true,
    title: "Demand Forecasting",
    body: "Per-SKU, per-season demand curves instead of one flat average, so a slow mover never gets ordered like a bestseller.",
    icon: "M3 17l5-6 4 3 5-8 4 5",
    sparkline: "M0 36 L40 30 L80 34 L120 20 L160 24 L200 10 L240 16 L300 4",
  },
  {
    title: "Inventory Tracking",
    body: "Live on-hand counts, never yesterday's numbers.",
    icon: "M3.5 8l8.5-5 8.5 5M3.5 8v11h17V8",
  },
  {
    title: "Reorder",
    body: "Thresholds that move with real demand.",
    icon: "M4 19V8l8-4 8 4v11M4 19h16M12 19v-7",
  },
  {
    title: "Pricing",
    body: "Repricing as cost signals shift.",
    icon: "M20 12l-7 7-9-9V4h6l10 10z",
  },
  {
    title: "Supplier Coordination",
    body: "One view of every supplier's terms.",
    icon: "M12 4a2.4 2.4 0 1 0 0 4.8 2.4 2.4 0 0 0 0-4.8ZM6 14.6a2.4 2.4 0 1 0 0 4.8 2.4 2.4 0 0 0 0-4.8ZM18 14.6a2.4 2.4 0 1 0 0 4.8 2.4 2.4 0 0 0 0-4.8Z",
  },
]
---

<section id="product" class="relative overflow-hidden bg-bold-paper py-20 font-hanken md:py-28">
  <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <span class="product-ambient-blob"></span>
  </div>
  <div class="container-fb relative">
    <div data-reveal class="reveal-item max-w-xl">
      <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-bold-taupe">What runs underneath</p>
      <h2 class="font-hanken text-[1.9rem] font-semibold leading-tight tracking-tighter text-bold-ink md:text-[2.2rem]">
        One engine, the whole floor.
      </h2>
    </div>

    <div class="mt-12 grid grid-cols-2 auto-rows-[12.5rem] gap-3.5 md:grid-cols-4 md:auto-rows-[9.5rem]">
      {tiles.map((t, i) => (
        <div
          data-reveal
          class={`reveal-item ${t.big ? "col-span-2 row-span-2" : ""}`}
          style={`transition-delay: ${i * 70}ms`}
        >
          {t.big ? (
            <div data-tilt class="tilt-card bold-tile-feature bold-glass relative h-full overflow-hidden rounded-2xl p-5 md:p-6">
              <div class="flex items-center justify-between">
                <svg class="h-5 w-5 text-bold-mint-deep" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={t.icon} />
                </svg>
                <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-bold-ink font-mono text-[0.65rem] font-bold text-bold-paper">01</span>
              </div>
              <h3 class="font-hanken mt-3 text-[1.15rem] font-semibold text-bold-ink md:mt-4">{t.title}</h3>
              <p class="mt-1.5 max-w-[22rem] text-[0.88rem] leading-relaxed text-bold-ink/65">{t.body}</p>
              {t.sparkline && (
                <svg class="absolute inset-x-5 bottom-5 h-11 md:inset-x-6 md:bottom-6" viewBox="0 0 300 46" preserveAspectRatio="none" aria-hidden="true">
                  <path d={t.sparkline} fill="none" stroke="#1A7A64" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
            </div>
          ) : (
            <div class="h-full rounded-2xl border border-bold-ink/8 bg-bold-paper p-5 transition-colors duration-300 hover:border-bold-ink/25 hover:bg-bold-ink/[0.04] md:p-6">
              <div class="flex items-center justify-between">
                <svg class="h-5 w-5 text-bold-mint-deep" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={t.icon} />
                </svg>
                <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-bold-ink font-mono text-[0.65rem] font-bold text-bold-paper">{String(i + 1).padStart(2, "0")}</span>
              </div>
              <h3 class="font-hanken mt-3 text-[0.95rem] font-semibold text-bold-ink">{t.title}</h3>
              <p class="mt-1.5 text-[0.82rem] leading-relaxed text-bold-ink/65">{t.body}</p>
            </div>
          )}
        </div>
      ))}
    </div>

    <div data-reveal class="reveal-item mt-12 flex justify-center" style="transition-delay: 420ms">
      <a href="/product/" data-magnetic class="bold-btn bold-btn-ink bold-btn-lg group">
        <span>See the full product</span>
        <span aria-hidden="true" class="transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
      </a>
    </div>
  </div>
</section>

<style>
  .product-ambient-blob {
    position: absolute;
    top: -10%;
    left: -8%;
    width: 30vw;
    height: 30vw;
    max-width: 420px;
    max-height: 420px;
    border-radius: 9999px;
    filter: blur(80px);
    background: radial-gradient(circle, rgba(110, 156, 163, 0.16) 0%, transparent 70%);
    animation: product-ambient-drift 24s ease-in-out infinite;
  }

  @keyframes product-ambient-drift {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(3vw, 3vh); }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-ambient-blob {
      animation: none;
    }
  }
</style>

<script>
  import "../scripts/scrollReveal"
  import "../scripts/cardTilt"
  import "../scripts/magneticButton"
</script>
