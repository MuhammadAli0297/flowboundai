---
// Hot Sauce rebuild (see CLAUDE.md): the homepage hero drops the three.js WebGL wave
// (HeroBackground.astro / heroWave.ts, left on disk unused, same precedent as FlowBackground.astro)
// for the approved "Bold" mockup's grain+orb hero: a light paper surface, two blurred color orbs,
// a faint grain layer, and a real-looking glass panel standing in for the product instead of
// abstract particle art. Matches the approved design artifact's still 01 almost exactly.
const liveRows = [
  { label: "On-hand", value: "142 units" },
  { label: "Reorder point", value: "160 units" },
  { label: "Lead time", value: "9 days" },
]
---

<section id="top" class="relative overflow-hidden bg-bold-paper py-28 pt-32 font-hanken md:pb-28 md:pt-40">
  <div class="pointer-events-none absolute inset-0 bg-grain" aria-hidden="true" />
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <span class="bold-orb" style="width:26rem;height:26rem;top:-9rem;right:-4rem;background:#8FE3D3;opacity:0.3;" />
    <span class="bold-orb" style="width:19rem;height:19rem;top:3rem;right:17rem;background:#C998CD;opacity:0.27;" />
  </div>

  <div class="container-fb relative">
    <p
      data-reveal
      class="reveal-item mb-7 inline-flex items-center gap-2 rounded-full border border-bold-ink/10 bg-bold-paper/70 px-3.5 py-1.5 font-mono text-xs text-bold-ink/80"
    >
      <span class="relative flex h-1.5 w-1.5 shrink-0" aria-hidden="true">
        <span class="absolute inset-0 rounded-full bg-bold-mint-deep/40 blur-[3px]" />
        <span class="relative h-1.5 w-1.5 rounded-full bg-bold-mint-deep" />
      </span>
      Now onboarding pilot partners
    </p>

    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-10">
      <div>
        <h1 data-reveal class="font-hanken reveal-item max-w-xl text-[2.4rem] font-bold leading-[1.05] tracking-tighter text-bold-ink md:text-[3.5rem]">
          Run a tight supply chain without an <em class="font-instrument font-normal italic text-bold-mint-deep">SAP consultant</em>.
        </h1>
        <p data-reveal class="reveal-item mt-5 max-w-md text-[1.02rem] font-normal leading-relaxed text-bold-ink/70" style="transition-delay: 90ms">
          AI-powered inventory decisions in minutes, not months. No SI required, no nine-month rollout.
        </p>
        <div data-reveal class="reveal-item mt-8 flex flex-wrap items-center gap-4" style="transition-delay: 180ms">
          <a href="/#cta" data-magnetic class="bold-btn bold-btn-primary bold-btn-md group">
            <span>Start free pilot</span>
            <span aria-hidden="true" class="transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
          </a>
          <a href="/#how-it-works" data-magnetic class="bold-btn bold-btn-secondary bold-btn-md group">
            <span>See how it works</span>
            <span aria-hidden="true" class="transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
          </a>
        </div>
      </div>

      <div data-reveal class="reveal-item bold-glass rounded-2xl p-5" style="transition-delay: 240ms">
        <div class="mb-3.5 flex items-center gap-2 font-mono text-xs uppercase tracking-[0.05em] text-bold-taupe">
          <span class="h-1.5 w-1.5 rounded-full bg-bold-mint-deep" aria-hidden="true" />
          Live &middot; SKU&ndash;0847
        </div>
        {liveRows.map((row, i) => (
          <div class={`flex items-center justify-between py-2 font-mono text-[0.84rem] text-bold-ink ${i > 0 ? "border-t border-bold-ink/10" : ""}`}>
            <span class="text-bold-ink/65">{row.label}</span>
            <span class="font-medium">{row.value}</span>
          </div>
        ))}
        <div class="flex items-center justify-between border-t border-bold-ink/10 py-2 font-mono text-[0.84rem] text-bold-ink">
          <span class="text-bold-ink/65">Status</span>
          <span class="rounded-full bg-bold-mint-deep px-2.5 py-0.5 text-xs font-bold text-bold-paper">Triggered</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import "../scripts/scrollReveal"
  import "../scripts/magneticButton"
</script>
