---
// Customer Service hero background: "Inbox Flow", ocean-palette, canvas 2D (see
// src/scripts/customerServiceHero.ts). A steady stream of message bubbles travels toward the
// fixed chat hub; most bounce back answered with a checkmark flash, one in four reroutes to a
// separate handoff node instead. The hub does not rotate.
---

<div class="hero-canvas-wrap absolute inset-0 overflow-hidden" aria-hidden="true">
  <div class="hero-base-gradient absolute inset-0"></div>
  <canvas id="customer-service-hero" class="absolute inset-0 h-full w-full"></canvas>
  <div class="absolute inset-0 bg-grain opacity-20 mix-blend-overlay"></div>
</div>

<style>
  .hero-base-gradient {
    background:
      radial-gradient(85% 70% at 74% 42%, rgba(74, 111, 165, 0.26), transparent 60%),
      radial-gradient(70% 60% at 96% 78%, rgba(79, 109, 122, 0.22), transparent 60%),
      #104866;
  }
</style>

<script>
  import "../scripts/customerServiceHero"
</script>
