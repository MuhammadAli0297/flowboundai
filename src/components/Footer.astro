---
import LogoLockup from "./LogoLockup.astro"
import { footerLinks } from "../data/nav"
---

<footer class="bg-ocean-900 py-14 font-amulya text-fb-white/70">
  <div class="container-fb flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
    <div class="max-w-xs">
      <LogoLockup dark />
      <p class="mt-4 text-sm font-light leading-relaxed text-fb-white/45">
        Supply chain decisions, explained in plain language, for small and mid-sized teams who don't have an SAP
        budget.
      </p>
    </div>

    <div class="grid grid-cols-2 gap-x-12 gap-y-8 sm:grid-cols-3">
      <div>
        <p class="font-mono text-xs uppercase tracking-wider text-fb-white/35">Product</p>
        <ul class="mt-3 space-y-2 text-sm font-normal">
          {footerLinks.product.map((l) => (
            <li><a href={l.href} class="transition-colors hover:text-fb-white">{l.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="font-mono text-xs uppercase tracking-wider text-fb-white/35">Company</p>
        <ul class="mt-3 space-y-2 text-sm font-normal">
          {footerLinks.company.map((l) => (
            <li><a href={l.href} class="transition-colors hover:text-fb-white">{l.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="font-mono text-xs uppercase tracking-wider text-fb-white/35">Contact</p>
        <ul class="mt-3 space-y-2 text-sm font-normal">
          <li><a href="mailto:hello@flowbound.ai" class="transition-colors hover:text-fb-white">hello@flowbound.ai</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="container-fb mt-12 border-t border-fb-white/10 pt-6 text-xs font-light text-fb-white/35">
    © {new Date().getFullYear()} Flowbound. All rights reserved.
  </div>
</footer>
