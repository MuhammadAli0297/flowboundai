---
/**
 * Full-bleed ambient hero background for the How It Works page. Same dark,
 * glowing, green-on-black "vibe" as the other hero backgrounds, but a
 * distinct composition: a single rotating gear sits as the hub, with four
 * satellite nodes for the four steps (connect, read the signal, decide,
 * ask) flowing into it, standing in for the whole process turning as one
 * mechanism rather than four disconnected stages.
 */
const hubX = 1180
const hubY = 460

// Same computed cog outline as the "gear" SectionIcon (proper flat-toothed teeth, not spokes on a ring),
// recentred on (0,0) so it can be scaled up for the hub. See SectionIcon.astro for how gearOutline works.
const polar = (cx: number, cy: number, r: number, deg: number): [number, number] => {
  const rad = (deg * Math.PI) / 180
  return [cx + r * Math.cos(rad), cy + r * Math.sin(rad)]
}

const gearOutline = (cx: number, cy: number, teeth: number, outerR: number, innerR: number, toothHalfDeg: number) => {
  const step = 360 / teeth
  const points: [number, number][] = []
  for (let i = 0; i < teeth; i++) {
    const center = i * step
    const valleyCenter = center + step / 2
    points.push(
      polar(cx, cy, outerR, center - toothHalfDeg),
      polar(cx, cy, outerR, center + toothHalfDeg),
      polar(cx, cy, innerR, valleyCenter - toothHalfDeg),
      polar(cx, cy, innerR, valleyCenter + toothHalfDeg)
    )
  }
  return `M${points.map(([x, y]) => `${x.toFixed(2)},${y.toFixed(2)}`).join(" L")} Z`
}

const gearPath0 = gearOutline(0, 0, 8, 17, 13, 7)
const gearHoleR = 5.5

const steps = [
  { x: 850, y: 250, delay: 0, kind: "connect" },
  { x: 830, y: 660, delay: 1.2, kind: "signal" },
  { x: 1520, y: 230, delay: 0.6, kind: "decision" },
  { x: 1560, y: 660, delay: 1.8, kind: "ask" },
]

const curveIn = (x: number, y: number) =>
  `M${x},${y} Q${(x + hubX) / 2},${(y + hubY) / 2 - 30} ${hubX},${hubY}`
---

<svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 h-full w-full" aria-hidden="true">
  <defs>
    <radialGradient id="hw-hub-glow-outer" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#468B79" stop-opacity="0.38" />
      <stop offset="55%" stop-color="#468B79" stop-opacity="0.17" />
      <stop offset="100%" stop-color="#468B79" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="hw-hub-glow-inner" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#8FD0B8" stop-opacity="0.45" />
      <stop offset="100%" stop-color="#468B79" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="hw-node-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#468B79" stop-opacity="0.4" />
      <stop offset="100%" stop-color="#468B79" stop-opacity="0" />
    </radialGradient>
  </defs>

  <circle cx={hubX} cy={hubY} r="640" fill="url(#hw-hub-glow-outer)" />
  <circle cx={hubX} cy={hubY} r="300" fill="url(#hw-hub-glow-inner)" />

  {steps.map((s) => (
    <g>
      <path d={curveIn(s.x, s.y)} fill="none" stroke="#1F4438" stroke-width="1.5" stroke-opacity="0.5" />

      <circle r="4" fill="#8FD0B8">
        <animateMotion dur="4.2s" repeatCount="indefinite" begin={`${s.delay}s`} path={curveIn(s.x, s.y)} />
        <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.08;0.85;1" dur="4.2s" repeatCount="indefinite" begin={`${s.delay}s`} />
      </circle>

      <circle cx={s.x} cy={s.y} r="26" fill="url(#hw-node-glow)" />
    </g>
  ))}

  <!-- Connect your systems: two overlapping rings, a link mark -->
  <g transform={`translate(${steps[0].x} ${steps[0].y})`}>
    <g class="fb-float" style={`animation-delay: ${steps[0].delay * 0.4}s`}>
      <circle cx="-4" cy="0" r="6" fill="none" stroke="#8FD0B8" stroke-width="1.6" />
      <circle cx="4" cy="0" r="6" fill="none" stroke="#8FD0B8" stroke-width="1.6" />
    </g>
  </g>

  <!-- The engine reads the signal: a small waveform -->
  <g transform={`translate(${steps[1].x} ${steps[1].y})`}>
    <g class="fb-float" style={`animation-delay: ${steps[1].delay * 0.4}s`}>
      <rect x="-11" y="-8" width="22" height="16" rx="3" fill="#0C1F19" stroke="#66AE95" stroke-width="1.5" stroke-opacity="0.9" />
      <path d="M-7,0 L-3,0 L-1,-4 L1,4 L3,0 L7,0" fill="none" stroke="#8FD0B8" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
    </g>
  </g>

  <!-- You get a decision: a checked box -->
  <g transform={`translate(${steps[2].x} ${steps[2].y})`}>
    <g class="fb-float" style={`animation-delay: ${steps[2].delay * 0.4}s`}>
      <rect x="-10" y="-8" width="20" height="16" rx="3" fill="#0C1F19" stroke="#66AE95" stroke-width="1.5" stroke-opacity="0.9" />
      <path d="M-4,0 L-1,4 L5,-4" fill="none" stroke="#8FD0B8" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </g>
  </g>

  <!-- Ask it anything: a chat bubble -->
  <g transform={`translate(${steps[3].x} ${steps[3].y})`}>
    <g class="fb-float" style={`animation-delay: ${steps[3].delay * 0.4}s`}>
      <rect x="-10" y="-8" width="20" height="14" rx="4" fill="#0C1F19" stroke="#66AE95" stroke-width="1.5" stroke-opacity="0.9" />
      <circle cx="-4" cy="-1" r="1.2" fill="#8FD0B8" />
      <circle cx="0" cy="-1" r="1.2" fill="#8FD0B8" />
      <circle cx="4" cy="-1" r="1.2" fill="#8FD0B8" />
    </g>
  </g>

  <circle
    cx={hubX}
    cy={hubY}
    r="100"
    fill="none"
    stroke="#8FD0B8"
    stroke-opacity="0.5"
    class="fb-core-pulse-ring"
    style={`transform-origin: ${hubX}px ${hubY}px`}
  />

  <!-- the gear, rotating clockwise as the hub -->
  <g transform={`translate(${hubX} ${hubY})`} class="fb-core-breathe">
    <g>
      <animateTransform attributeName="transform" type="rotate" from="0 0 0" to="360 0 0" dur="22s" repeatCount="indefinite" />
      <path d={gearPath0} transform="scale(3.1)" fill="#003828" stroke="#8FD0B8" stroke-width="1.4" stroke-linejoin="round" />
      <circle r={gearHoleR} transform="scale(3.1)" fill="none" stroke="#8FD0B8" stroke-width="1.2" />
    </g>
  </g>
</svg>
