---
/**
 * Full-bleed ambient hero background for the Shipping Optimization page.
 * Same dark, glowing, green-on-black "vibe" as the other hero backgrounds,
 * but a distinct composition: the crate (inventory) icon is the hub, four
 * candidate lanes fan out to carrier nodes, and one lane is clearly the
 * winner (brighter, a package actually moving along it, a checked node)
 * while the rest sit dimmer and dashed, mid-comparison.
 */
const hubX = 1180
const hubY = 460

const lanes = [
  { x: 1420, y: 250, chosen: false, delay: 0 },
  { x: 1500, y: 430, chosen: true, delay: 0 },
  { x: 1440, y: 600, chosen: false, delay: 1.2 },
  { x: 1340, y: 690, chosen: false, delay: 2.4 },
]

const lanePath = (x: number, y: number) => `M${hubX},${hubY} L${x},${y}`

// The "crate" icon path (SectionIcon), recentred on (0,0) so it can be used as the hub.
const cratePath = "M0,-18 L16,-9 L16,9 L0,18 L-16,9 L-16,-9 Z"
const crateInner = "M0,0 L0,-18 M0,0 L16,9 M0,0 L-16,9"
---

<svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 h-full w-full" aria-hidden="true">
  <defs>
    <radialGradient id="so-hub-glow-outer" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#468B79" stop-opacity="0.36" />
      <stop offset="55%" stop-color="#468B79" stop-opacity="0.16" />
      <stop offset="100%" stop-color="#468B79" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="so-hub-glow-inner" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#8FD0B8" stop-opacity="0.45" />
      <stop offset="100%" stop-color="#468B79" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="so-node-glow-dim" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#468B79" stop-opacity="0.3" />
      <stop offset="100%" stop-color="#468B79" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="so-node-glow-chosen" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#8FD0B8" stop-opacity="0.6" />
      <stop offset="100%" stop-color="#468B79" stop-opacity="0" />
    </radialGradient>
  </defs>

  <circle cx={hubX} cy={hubY} r="620" fill="url(#so-hub-glow-outer)" />
  <circle cx={hubX} cy={hubY} r="280" fill="url(#so-hub-glow-inner)" />

  {lanes.filter((l) => !l.chosen).map((l) => (
    <g>
      <path d={lanePath(l.x, l.y)} fill="none" stroke="#1F4438" stroke-width="1.5" stroke-opacity="0.45" class="fb-dash-flow" />
      <circle cx={l.x} cy={l.y} r="22" fill="url(#so-node-glow-dim)" />
      <g transform={`translate(${l.x} ${l.y})`}>
        <g class="fb-float" style={`animation-delay: ${l.delay * 0.4}s`}>
          <rect x="-9" y="-8" width="18" height="16" rx="3" fill="#0C1F19" stroke="#2C6E58" stroke-width="1.5" stroke-opacity="0.75" />
          <path d="M-9,-1 L9,-1" stroke="#468B79" stroke-width="1.1" stroke-opacity="0.7" />
        </g>
      </g>
    </g>
  ))}

  {lanes.filter((l) => l.chosen).map((l) => (
    <g>
      <path d={lanePath(l.x, l.y)} fill="none" stroke="#8FD0B8" stroke-width="2" stroke-opacity="0.6" />

      <circle r="4.5" fill="#C7E3DA">
        <animateMotion dur="2.4s" repeatCount="indefinite" path={lanePath(l.x, l.y)} />
        <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.1;0.85;1" dur="2.4s" repeatCount="indefinite" />
      </circle>

      <circle cx={l.x} cy={l.y} r="34" fill="url(#so-node-glow-chosen)" />
      <g transform={`translate(${l.x} ${l.y})`}>
        <g class="fb-float">
          <rect x="-12" y="-10" width="24" height="20" rx="4" fill="#003828" stroke="#8FD0B8" stroke-width="1.6" stroke-opacity="0.95" />
          <path d="M-5,0 L-1,5 L6,-5" fill="none" stroke="#C7E3DA" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      </g>
    </g>
  ))}

  <circle
    cx={hubX}
    cy={hubY}
    r="92"
    fill="none"
    stroke="#8FD0B8"
    stroke-opacity="0.5"
    class="fb-core-pulse-ring"
    style={`transform-origin: ${hubX}px ${hubY}px`}
  />

  <g transform={`translate(${hubX} ${hubY})`} class="fb-core-breathe">
    <path d={cratePath} transform="scale(3.1)" fill="#003828" stroke="#8FD0B8" stroke-width="1.4" stroke-linejoin="round" />
    <path d={crateInner} transform="scale(3.1)" fill="none" stroke="#8FD0B8" stroke-width="1.1" stroke-opacity="0.85" />
  </g>
</svg>
