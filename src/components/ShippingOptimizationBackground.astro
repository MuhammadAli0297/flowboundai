---
// Shipping Optimization hero background: "Lane Race", ocean-palette, canvas 2D (see
// src/scripts/shippingOptimizationHero.ts). A fixed crate hub sends a comet-trail dot down each
// of five candidate lanes every race cycle; four slow, fade, and stop partway (compared and
// discarded), one runs the full distance and lights up its destination on arrival, a different
// lane winning each cycle. The hub does not rotate.
---

<div class="hero-canvas-wrap absolute inset-0 overflow-hidden" aria-hidden="true">
  <div class="hero-base-gradient absolute inset-0"></div>
  <canvas id="shipping-optimization-hero" class="absolute inset-0 h-full w-full"></canvas>
  <div class="absolute inset-0 bg-grain opacity-20 mix-blend-overlay"></div>
</div>

<style>
  .hero-base-gradient {
    background:
      radial-gradient(85% 70% at 66% 50%, rgba(74, 111, 165, 0.26), transparent 60%),
      radial-gradient(70% 60% at 98% 15%, rgba(79, 109, 122, 0.22), transparent 60%),
      #104866;
  }
</style>

<script>
  import "../scripts/shippingOptimizationHero"
</script>
