---
// Inventory Tracking hero background: "Live Scan", ocean-palette, canvas 2D (see
// src/scripts/inventoryTrackingHero.ts). A fixed crate hub anchors a slowly rotating radar sweep;
// a scattered grid of status cells flares and reveals on-hand/incoming/committed as the sweep
// passes each one, then fades back to an idle glow until the next pass. The hub does not rotate.
---

<div class="hero-canvas-wrap absolute inset-0 overflow-hidden" aria-hidden="true">
  <div class="hero-base-gradient absolute inset-0"></div>
  <canvas id="inventory-tracking-hero" class="absolute inset-0 h-full w-full"></canvas>
  <div class="absolute inset-0 bg-grain opacity-20 mix-blend-overlay"></div>
</div>

<style>
  .hero-base-gradient {
    background:
      radial-gradient(85% 70% at 74% 50%, rgba(74, 111, 165, 0.26), transparent 60%),
      radial-gradient(70% 60% at 98% 85%, rgba(79, 109, 122, 0.22), transparent 60%),
      #104866;
  }
</style>

<script>
  import "../scripts/inventoryTrackingHero"
</script>
