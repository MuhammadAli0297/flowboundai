---
/**
 * Full-bleed ambient hero background for the Inventory Tracking page. Same
 * dark, glowing, green-on-black "vibe" as the other hero backgrounds, but a
 * distinct composition: the crate (inventory) icon sits fixed as the hub,
 * a radar sweep rotates around it to read as "live scanning," and three
 * status nodes (on hand, incoming, reserved) orbit at their own radius and
 * speed, rather than the hub itself rotating or emitting a single signal.
 */
const hubX = 1200
const hubY = 440

const orbits = [
  { radius: 140, duration: 10, startAngle: 30 },
  { radius: 220, duration: 16, startAngle: 170 },
  { radius: 300, duration: 24, startAngle: 300 },
]

// Radar sweep wedge, a ~24deg slice pointing along +x, rotated continuously.
const sweepRadius = 300
const sweepAngle = 24
const sweepEnd = {
  x: sweepRadius * Math.cos((-sweepAngle * Math.PI) / 180),
  y: sweepRadius * Math.sin((-sweepAngle * Math.PI) / 180),
}

// The "crate" icon path (SectionIcon), recentred on (0,0) for use as the fixed hub.
const cratePath = "M0,-18 L16,-9 L16,9 L0,18 L-16,9 L-16,-9 Z"
const crateInner = "M0,0 L0,-18 M0,0 L16,9 M0,0 L-16,9"
---

<svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 h-full w-full" aria-hidden="true">
  <defs>
    <radialGradient id="it-hub-glow-outer" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#468B79" stop-opacity="0.34" />
      <stop offset="55%" stop-color="#468B79" stop-opacity="0.15" />
      <stop offset="100%" stop-color="#468B79" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="it-hub-glow-inner" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#8FD0B8" stop-opacity="0.4" />
      <stop offset="100%" stop-color="#468B79" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="it-node-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#468B79" stop-opacity="0.55" />
      <stop offset="100%" stop-color="#468B79" stop-opacity="0" />
    </radialGradient>
  </defs>

  <circle cx={hubX} cy={hubY} r="600" fill="url(#it-hub-glow-outer)" />
  <circle cx={hubX} cy={hubY} r="260" fill="url(#it-hub-glow-inner)" />

  {orbits.map((o) => (
    <circle
      cx={hubX}
      cy={hubY}
      r={o.radius}
      fill="none"
      stroke="#1F4438"
      stroke-width="1"
      stroke-dasharray="2 7"
      stroke-opacity="0.6"
    />
  ))}

  <g transform={`translate(${hubX} ${hubY})`}>
    <path
      d={`M0,0 L${sweepRadius},0 A${sweepRadius},${sweepRadius} 0 0,0 ${sweepEnd.x},${sweepEnd.y} Z`}
      fill="#468B79"
      fill-opacity="0.14"
    >
      <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur="7s" repeatCount="indefinite" />
    </path>
    <line x1="0" y1="0" x2={sweepRadius} y2="0" stroke="#8FD0B8" stroke-width="1.5" stroke-opacity="0.45">
      <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur="7s" repeatCount="indefinite" />
    </line>
  </g>

  {orbits.map((o) => (
    <g>
      <animateTransform
        attributeName="transform"
        type="rotate"
        from={`${o.startAngle} ${hubX} ${hubY}`}
        to={`${o.startAngle + 360} ${hubX} ${hubY}`}
        dur={`${o.duration}s`}
        repeatCount="indefinite"
      />
      <line x1={hubX} y1={hubY} x2={hubX + o.radius} y2={hubY} stroke="#2C6E58" stroke-width="1.5" stroke-opacity="0.4" />
      <circle cx={hubX + o.radius} cy={hubY} r="24" fill="url(#it-node-glow)" />
      <circle cx={hubX + o.radius} cy={hubY} r="12" fill="#0C1F19" stroke="#66AE95" stroke-width="1.5" stroke-opacity="0.9" />
      <circle cx={hubX + o.radius} cy={hubY} r="4" fill="#8FD0B8">
        <animate attributeName="opacity" values="0.5;1;0.5" dur="2.6s" repeatCount="indefinite" />
      </circle>
    </g>
  ))}

  <circle
    cx={hubX}
    cy={hubY}
    r="92"
    fill="none"
    stroke="#8FD0B8"
    stroke-opacity="0.5"
    class="fb-core-pulse-ring"
    style={`transform-origin: ${hubX}px ${hubY}px`}
  />

  <g transform={`translate(${hubX} ${hubY})`} class="fb-core-breathe">
    <path d={cratePath} transform="scale(3.1)" fill="#003828" stroke="#8FD0B8" stroke-width="1.4" stroke-linejoin="round" />
    <path d={crateInner} transform="scale(3.1)" fill="none" stroke="#8FD0B8" stroke-width="1.1" stroke-opacity="0.85" />
    <circle r="8" fill="#C7E3DA" />
  </g>
</svg>
