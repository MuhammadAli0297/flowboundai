---
import LogoLockup from "./LogoLockup.astro"
import { navLinks, servicesMenu } from "../data/nav"
import { services } from "../data/services"

const menuServices = servicesMenu.map((entry) => ({
  ...entry,
  service: services.find((s) => s.slug === entry.slug)!,
}))

// Hot Sauce rebuild (see CLAUDE.md): Nav moves off ocean/Amulya onto the bold palette and Hanken
// Grotesk. Link text stays bold-ink at full opacity always, never bold-mint-deep, because that
// color is too dark relative to paper for a pleasant hover tint at this weight — it shows up as a
// hover underline instead (a decorative affordance, not the only way the link is identifiable, so
// it doesn't need to clear text-contrast thresholds the way a color change would).
// font-medium here, font-normal on panelLinkClass below: the flyout's contents read a step lighter
// than the top-level items that open them, continuing the weight-contrast habit Amulya's variable
// axis started, Hanken Grotesk's variable axis (400-800) does the same job here.
const linkClass = "font-hanken text-[0.9rem] font-medium text-bold-ink border-b-2 border-transparent pb-1 transition-colors hover:border-bold-mint-deep"
// Leaf panels (no further nested flyout) can safely clip to their rounded corners.
const panelClass = "w-64 overflow-hidden rounded-2xl border border-bold-ink/10 bg-bold-paper shadow-xl"
// The top-level panel hosts nested flyouts that fly out past its own box, so it can't use
// overflow-hidden (that would clip the flyouts). Round only the first/last row instead.
const outerPanelClass = "w-64 rounded-2xl border border-bold-ink/10 bg-bold-paper shadow-xl"
const panelLinkClass = "font-hanken block px-4 py-3 text-[0.88rem] font-normal text-bold-ink transition-colors hover:bg-bold-mist/50"
// Mobile menu: the same weight/hover language as the desktop flyout above (panelLinkClass-ish),
// just full-width rows instead of a floating panel, since it's a dropdown under the header rather
// than a hover flyout.
const mobileLinkClass = "font-hanken block rounded-lg px-3 py-3 text-[0.95rem] font-medium text-bold-ink transition-colors hover:bg-bold-mist/50"
---

<header class="sticky top-0 z-50 border-b border-bold-ink/10 bg-bold-paper/90 font-hanken backdrop-blur">
  <div class="container-fb flex h-16 items-center">
    <a href="/" class="shrink-0">
      <LogoLockup />
    </a>
    <div class="ml-auto flex items-center">
      <nav class="hidden items-center gap-6 md:flex lg:gap-8">
        {navLinks.map((l) =>
          l.label === "Services" ? (
            <div class="group/services relative">
              <a href={l.href} class={`${linkClass} flex items-center gap-1`}>
                Services
                <svg
                  class="h-3 w-3 shrink-0 transition-transform duration-150 group-hover/services:-rotate-180 group-focus-within/services:-rotate-180"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </a>
              <div class="invisible absolute left-1/2 top-full -translate-x-1/2 pt-3 opacity-0 transition-all duration-150 group-hover/services:visible group-hover/services:opacity-100 group-focus-within/services:visible group-focus-within/services:opacity-100">
                <div class={outerPanelClass}>
                  <a href="/ask-flowbound/" class={`${panelLinkClass} rounded-t-2xl`}>Ask Flowbound</a>
                  {menuServices.map(({ service, expand }, i) => {
                    const isLast = i === menuServices.length - 1
                    const roundedLast = isLast ? "rounded-b-2xl" : ""
                    return expand ? (
                      <div class="group/item relative">
                        <a href={`/services/#${service.slug}`} class={`${panelLinkClass} flex items-center justify-between ${roundedLast}`}>
                          {service.name}
                          <span class="font-mono text-xs text-bold-ink/30">&rsaquo;</span>
                        </a>
                        <div class="invisible absolute left-full top-0 pl-2 opacity-0 transition-all duration-150 group-hover/item:visible group-hover/item:opacity-100 group-focus-within/item:visible group-focus-within/item:opacity-100">
                          <div class={panelClass}>
                            {service.capabilities.map((capability) => (
                              <a href={capability.href ?? `/services/#${service.slug}`} class={panelLinkClass}>{capability.title}</a>
                            ))}
                          </div>
                        </div>
                      </div>
                    ) : (
                      <a href={service.href ?? `/services/#${service.slug}`} class={`${panelLinkClass} ${roundedLast}`}>{service.name}</a>
                    )
                  })}
                </div>
              </div>
            </div>
          ) : (
            <a href={l.href} class={linkClass}>
              {l.label}
            </a>
          )
        )}
      </nav>
      <a
        href="/#cta"
        class="bold-btn bold-btn-primary bold-btn-sm group ml-6 hidden shrink-0 font-hanken transition-transform duration-300 ease-out hover:-translate-y-0.5 sm:inline-flex lg:ml-10"
      >
        <span>Request a pilot</span>
        <span aria-hidden="true" class="hidden transition-transform duration-300 ease-out group-hover:translate-x-1 sm:inline">&rarr;</span>
      </a>
      <button
        type="button"
        class="group relative ml-3 flex h-9 w-9 shrink-0 items-center justify-center md:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Toggle menu"
        data-mobile-menu-toggle
      >
        <span aria-hidden="true" class="absolute left-1/2 top-1/2 h-0.5 w-6 -translate-x-1/2 -translate-y-[7px] rounded-full bg-bold-ink transition-transform duration-300 ease-out group-aria-expanded:translate-y-0 group-aria-expanded:rotate-45"></span>
        <span aria-hidden="true" class="absolute left-1/2 top-1/2 h-0.5 w-6 -translate-x-1/2 -translate-y-1/2 rounded-full bg-bold-ink transition-opacity duration-200 ease-out group-aria-expanded:opacity-0"></span>
        <span aria-hidden="true" class="absolute left-1/2 top-1/2 h-0.5 w-6 -translate-x-1/2 translate-y-[6px] rounded-full bg-bold-ink transition-transform duration-300 ease-out group-aria-expanded:translate-y-0 group-aria-expanded:-rotate-45"></span>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="invisible absolute inset-x-0 top-full max-h-[calc(100dvh-4rem)] -translate-y-2 overflow-y-auto border-b border-bold-ink/10 bg-bold-paper opacity-0 shadow-lg transition-all duration-200 ease-out data-[state=open]:visible data-[state=open]:translate-y-0 data-[state=open]:opacity-100 md:hidden"
    data-mobile-menu
    data-state="closed"
  >
    <nav class="flex flex-col gap-1 px-6 py-4">
      {navLinks.map((l) =>
        l.label === "Services" ? (
          <div>
            <button
              type="button"
              class={`${mobileLinkClass} group flex w-full items-center justify-between`}
              aria-controls="mobile-services-panel"
              aria-expanded="false"
              data-accordion-toggle
            >
              Services
              <svg
                aria-hidden="true"
                class="h-3.5 w-3.5 shrink-0 transition-transform duration-200 group-aria-expanded:-rotate-180"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </button>
            <div
              id="mobile-services-panel"
              class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-200 ease-out data-[state=open]:grid-rows-[1fr]"
              data-accordion-panel
              data-state="closed"
            >
              <div class="overflow-hidden">
                <a href="/ask-flowbound/" class={`${mobileLinkClass} pl-6 text-[0.88rem] font-normal`}>Ask Flowbound</a>
                {menuServices.map(({ service, expand }) =>
                  expand ? (
                    <div>
                      <button
                        type="button"
                        class={`${mobileLinkClass} group flex w-full items-center justify-between pl-6 text-[0.88rem] font-normal`}
                        aria-controls={`mobile-service-${service.slug}-panel`}
                        aria-expanded="false"
                        data-accordion-toggle
                      >
                        {service.name}
                        <svg
                          aria-hidden="true"
                          class="h-3 w-3 shrink-0 transition-transform duration-200 group-aria-expanded:-rotate-180"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="m6 9 6 6 6-6" />
                        </svg>
                      </button>
                      <div
                        id={`mobile-service-${service.slug}-panel`}
                        class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-200 ease-out data-[state=open]:grid-rows-[1fr]"
                        data-accordion-panel
                        data-state="closed"
                      >
                        <div class="overflow-hidden">
                          {service.capabilities.map((capability) => (
                            <a
                              href={capability.href ?? `/services/#${service.slug}`}
                              class={`${mobileLinkClass} pl-9 text-[0.82rem] font-normal text-bold-ink/75`}
                            >
                              {capability.title}
                            </a>
                          ))}
                        </div>
                      </div>
                    </div>
                  ) : (
                    <a href={service.href ?? `/services/#${service.slug}`} class={`${mobileLinkClass} pl-6 text-[0.88rem] font-normal`}>
                      {service.name}
                    </a>
                  )
                )}
              </div>
            </div>
          </div>
        ) : (
          <a href={l.href} class={mobileLinkClass}>
            {l.label}
          </a>
        )
      )}
    </nav>
    <div class="border-t border-bold-ink/10 px-6 py-4">
      <a href="/#cta" class="bold-btn bold-btn-primary bold-btn-md group w-full font-hanken">
        <span>Request a pilot</span>
      </a>
    </div>
  </div>
</header>

<script>
  import "../scripts/mobileMenu"
</script>
