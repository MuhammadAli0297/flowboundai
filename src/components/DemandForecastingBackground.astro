---
// Demand Forecasting hero background: "Forecast Horizon", ocean-palette, canvas 2D (see
// src/scripts/demandForecastingHero.ts). A row of history bars settles into a fixed crate hub,
// the pivot where sales history turns into a projected curve climbing into the empty space,
// trailed by a soft confidence cone. One bar flares (a bestseller), another dims and flattens
// (dead stock), so the page's two watch-for cases read as bar behavior. The hub does not rotate.
---

<div class="hero-canvas-wrap absolute inset-0 overflow-hidden" aria-hidden="true">
  <div class="hero-base-gradient absolute inset-0"></div>
  <canvas id="demand-forecasting-hero" class="absolute inset-0 h-full w-full"></canvas>
  <div class="absolute inset-0 bg-grain opacity-20 mix-blend-overlay"></div>
</div>

<style>
  .hero-base-gradient {
    background:
      radial-gradient(90% 70% at 80% 60%, rgba(74, 111, 165, 0.26), transparent 60%),
      radial-gradient(70% 60% at 95% 15%, rgba(79, 109, 122, 0.22), transparent 60%),
      #104866;
  }
</style>

<script>
  import "../scripts/demandForecastingHero"
</script>
