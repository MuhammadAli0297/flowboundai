---
/**
 * Full-bleed ambient hero background for the Demand Forecasting page. Same
 * dark, glowing, green-on-black "vibe" as the other hero backgrounds, but a
 * distinct composition: the crate (inventory) icon is the hub, historical
 * sales signals drift in from the left, and a forecast line climbs out to
 * the upper right toward a projected point.
 */
const hubX = 1180
const hubY = 470

const historyNodes = [
  { x: 850, y: 340, delay: 0 },
  { x: 830, y: 540, delay: 1.4 },
  { x: 960, y: 660, delay: 2.8 },
]

const curveIn = (x: number, y: number) =>
  `M${x},${y} Q${(x + hubX) / 2},${(y + hubY) / 2 - 40} ${hubX},${hubY}`

// Forecast line climbing up and to the right from the hub to a projected point.
const forecastX = 1430
const forecastY = 250
const forecastPath = `M${hubX},${hubY} Q${(hubX + forecastX) / 2 + 60},${(hubY + forecastY) / 2} ${forecastX},${forecastY}`

// The "crate" icon path (SectionIcon), recentred on (0,0) so it can be scaled and rotated as the hub.
const cratePath = "M0,-18 L16,-9 L16,9 L0,18 L-16,9 L-16,-9 Z"
const crateInner = "M0,0 L0,-18 M0,0 L16,9 M0,0 L-16,9"
---

<svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 h-full w-full" aria-hidden="true">
  <defs>
    <radialGradient id="df-hub-glow-outer" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#468B79" stop-opacity="0.36" />
      <stop offset="55%" stop-color="#468B79" stop-opacity="0.16" />
      <stop offset="100%" stop-color="#468B79" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="df-hub-glow-inner" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#8FD0B8" stop-opacity="0.45" />
      <stop offset="100%" stop-color="#468B79" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="df-node-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#468B79" stop-opacity="0.5" />
      <stop offset="100%" stop-color="#468B79" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="df-forecast-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#8FD0B8" stop-opacity="0.55" />
      <stop offset="100%" stop-color="#468B79" stop-opacity="0" />
    </radialGradient>
  </defs>

  <circle cx={hubX} cy={hubY} r="620" fill="url(#df-hub-glow-outer)" />
  <circle cx={hubX} cy={hubY} r="280" fill="url(#df-hub-glow-inner)" />

  {historyNodes.map((n) => (
    <g>
      <path d={curveIn(n.x, n.y)} fill="none" stroke="#1F4438" stroke-width="1.5" stroke-opacity="0.5" />

      <circle r="3.5" fill="#66AE95">
        <animateMotion dur="3.4s" repeatCount="indefinite" begin={`${n.delay}s`} path={curveIn(n.x, n.y)} />
        <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.1;0.8;1" dur="3.4s" repeatCount="indefinite" begin={`${n.delay}s`} />
      </circle>

      <circle cx={n.x} cy={n.y} r="26" fill="url(#df-node-glow)" />
      <g transform={`translate(${n.x} ${n.y})`}>
        <g class="fb-float" style={`animation-delay: ${n.delay * 0.4}s`}>
          <rect x="-10" y="-9" width="20" height="18" rx="3" fill="#0C1F19" stroke="#66AE95" stroke-width="1.5" stroke-opacity="0.9" />
          <path d="M-10,-1 L10,-1 M-5,4 L5,4" stroke="#8FD0B8" stroke-width="1.2" />
        </g>
      </g>
    </g>
  ))}

  <path d={forecastPath} fill="none" stroke="#2C6E58" stroke-width="1.5" stroke-opacity="0.55" class="fb-dash-flow" />
  <circle r="4" fill="#C7E3DA">
    <animateMotion dur="2.8s" repeatCount="indefinite" path={forecastPath} />
    <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.1;0.8;1" dur="2.8s" repeatCount="indefinite" />
  </circle>
  <circle cx={forecastX} cy={forecastY} r="32" fill="url(#df-forecast-glow)" />
  <g transform={`translate(${forecastX} ${forecastY})`}>
    <g class="fb-float">
      <path d="M-11,7 L-3,-4 L4,2 L11,-9" fill="none" stroke="#8FD0B8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M5,-9 L11,-9 L11,-3" fill="none" stroke="#8FD0B8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </g>
  </g>

  <circle
    cx={hubX}
    cy={hubY}
    r="92"
    fill="none"
    stroke="#8FD0B8"
    stroke-opacity="0.5"
    class="fb-core-pulse-ring"
    style={`transform-origin: ${hubX}px ${hubY}px`}
  />

  <g transform={`translate(${hubX} ${hubY})`} class="fb-core-breathe">
    <g>
      <animateTransform attributeName="transform" type="rotate" from="0 0 0" to="360 0 0" dur="60s" repeatCount="indefinite" />
      <path d={cratePath} transform="scale(3.1)" fill="#003828" stroke="#8FD0B8" stroke-width="1.4" stroke-linejoin="round" />
      <path d={crateInner} transform="scale(3.1)" fill="none" stroke="#8FD0B8" stroke-width="1.1" stroke-opacity="0.85" />
    </g>
  </g>
</svg>
