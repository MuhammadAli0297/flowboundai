---
// Product-page hero background: real WebGL (three.js) via src/scripts/productHeroWave.ts, the
// "Convergent Signals" composition. Four particle streams drift in from the corners and merge
// into one glowing hub to the right of the headline, standing in for the page's actual thesis:
// four ways in, one engine underneath. Same three.js-scoped-to-one-script discipline as the
// homepage hero (see HeroBackground.astro); only / and /product ever ship the chunk.
---

<div class="hero-canvas-wrap absolute inset-0 overflow-hidden" aria-hidden="true">
  <div class="hero-base-gradient absolute inset-0"></div>
  <span class="hero-hub-glow"></span>
  <canvas id="product-hero-wave" class="absolute inset-0 h-full w-full"></canvas>
  <div class="absolute inset-0 bg-grain opacity-20 mix-blend-overlay"></div>
</div>

<style>
  .hero-base-gradient {
    background:
      radial-gradient(110% 85% at 12% 12%, rgba(74, 111, 165, 0.3), transparent 60%),
      radial-gradient(90% 70% at 80% 95%, rgba(79, 109, 122, 0.3), transparent 60%),
      #104866;
  }

  /* soft breathing glow positioned where the WebGL streams converge, roughly two-thirds across
     the frame, so the "hub" reads as one coherent light source rather than just particle density */
  .hero-hub-glow {
    position: absolute;
    top: 42%;
    left: 68%;
    width: 26rem;
    height: 26rem;
    transform: translate(-50%, -50%);
    border-radius: 9999px;
    background: radial-gradient(circle, rgba(219, 233, 238, 0.28) 0%, rgba(74, 111, 165, 0.16) 45%, transparent 72%);
    filter: blur(4px);
    animation: hero-hub-breathe 6s ease-in-out infinite;
  }

  @keyframes hero-hub-breathe {
    0%, 100% {
      opacity: 0.7;
      transform: translate(-50%, -50%) scale(1);
    }
    50% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-hub-glow {
      animation: none;
    }
  }
</style>

<script>
  import "../scripts/productHeroWave"
</script>
