---
export type SectionIconName =
  | "spark"
  | "crate"
  | "network"
  | "bolt"
  | "chat"
  | "shield-check"
  | "compass"
  | "gear"
  | "document"

interface Props {
  name: SectionIconName
  class?: string
}

const { name, class: className = "" } = Astro.props

// The "gear" icon is computed rather than hand-drawn: a proper flat-toothed cog silhouette (not just
// spokes on a ring), plus small connector nodes radiating off it, echoing "the engine, wired into
// everything else." Shared by the small icon here and the hero's rotating hub in HowItWorksBackground.astro.
const polar = (cx: number, cy: number, r: number, deg: number): [number, number] => {
  const rad = (deg * Math.PI) / 180
  return [cx + r * Math.cos(rad), cy + r * Math.sin(rad)]
}

const gearOutline = (cx: number, cy: number, teeth: number, outerR: number, innerR: number, toothHalfDeg: number) => {
  const step = 360 / teeth
  const points: [number, number][] = []
  for (let i = 0; i < teeth; i++) {
    const center = i * step
    const valleyCenter = center + step / 2
    points.push(
      polar(cx, cy, outerR, center - toothHalfDeg),
      polar(cx, cy, outerR, center + toothHalfDeg),
      polar(cx, cy, innerR, valleyCenter - toothHalfDeg),
      polar(cx, cy, innerR, valleyCenter + toothHalfDeg)
    )
  }
  return `M${points.map(([x, y]) => `${x.toFixed(2)},${y.toFixed(2)}`).join(" L")} Z`
}

const gearNodeAngles = [0, 45, 90, 135, 180, 225, 270, 315]
const gearPath = gearOutline(24, 24, 8, 17, 13, 7)
---

<svg viewBox="0 0 48 48" fill="none" class={className} aria-hidden="true">
  {name === "spark" && (
    <path
      d="M24,4 L28,20 L44,24 L28,28 L24,44 L20,28 L4,24 L20,20 Z"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"
    />
  )}

  {name === "crate" && (
    <g stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round">
      <path d="M24,6 L40,15 L40,33 L24,42 L8,33 L8,15 Z" />
      <path d="M24,24 L24,6 M24,24 L40,33 M24,24 L8,33" />
    </g>
  )}

  {name === "network" && (
    <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <path d="M12,34 L36,34 M12,34 L24,10 M36,34 L24,10" />
      <circle cx="12" cy="34" r="4" />
      <circle cx="36" cy="34" r="4" />
      <circle cx="24" cy="10" r="4" />
    </g>
  )}

  {name === "bolt" && (
    <path
      d="M26,4 L14,26 L22,26 L18,44 L34,20 L24,20 Z"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"
    />
  )}

  {name === "chat" && (
    <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect x="6" y="8" width="36" height="24" rx="6" />
      <path d="M14,32 L10,40 L20,32" />
      <circle cx="18" cy="20" r="1.6" fill="currentColor" stroke="none" />
      <circle cx="24" cy="20" r="1.6" fill="currentColor" stroke="none" />
      <circle cx="30" cy="20" r="1.6" fill="currentColor" stroke="none" />
    </g>
  )}

  {name === "shield-check" && (
    <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M24,4 L40,10 L40,22 C40,34 32,42 24,44 C16,42 8,34 8,22 L8,10 Z" />
      <path d="M17,24 L22,29 L32,18" />
    </g>
  )}

  {name === "compass" && (
    <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <circle cx="24" cy="24" r="13" />
      <path d="M24,4 L24,11 M24,37 L24,44 M4,24 L11,24 M37,24 L44,24" />
    </g>
  )}

  {name === "document" && (
    <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14,4 L29,4 L36,11 L36,44 L14,44 Z" />
      <path d="M29,4 L29,11 L36,11" />
      <path d="M19,20 L31,20 M19,27 L31,27 M19,34 L26,34" />
    </g>
  )}

  {name === "gear" && (
    <g stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round">
      <path d={gearPath} />
      <circle cx="24" cy="24" r="5.5" />
      {gearNodeAngles.map((angle) => {
        const [ix, iy] = polar(24, 24, 18, angle)
        const [ox, oy] = polar(24, 24, 21.5, angle)
        return (
          <g>
            <line x1={ix} y1={iy} x2={ox} y2={oy} />
            <circle cx={ox} cy={oy} r="1.6" />
          </g>
        )
      })}
    </g>
  )}
</svg>
