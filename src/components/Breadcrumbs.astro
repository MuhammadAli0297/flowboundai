---
import type { BreadcrumbItem } from "../lib/breadcrumbs"

interface Props {
  items: BreadcrumbItem[]
}

const { items } = Astro.props

const trailPath = (path: string) => (path.endsWith("/") ? path : `${path}/`)
---

<nav aria-label="Breadcrumb" class="mb-4">
  <ol class="flex flex-wrap items-center gap-1.5 font-mono text-xs text-ocean-100/50">
    {items.map((item, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span aria-hidden="true">/</span>}
        {i === items.length - 1 ? (
          <span class="text-ocean-100" aria-current="page">{item.name}</span>
        ) : (
          <a href={trailPath(item.path)} class="transition-colors hover:text-ocean-100 hover:underline">{item.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
