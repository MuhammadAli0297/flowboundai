---
/**
 * Full-bleed ambient hero background for the Pricing page. Same dark,
 * glowing, green-on-black "vibe" as the other hero backgrounds, but a
 * distinct composition: the bolt icon slowly rotates as the hub, a supplier
 * cost signal and a demand signal drift in from the left, and a price-tag
 * node on the right holds a needle that sweeps back and forth but never
 * passes two fixed bound markers, reading as "adjusts, but stays in range."
 */
const hubX = 1190
const hubY = 460

const signals = [
  { x: 880, y: 320, delay: 0 },
  { x: 900, y: 620, delay: 2 },
]

const priceX = 1470
const priceY = 460

const curveIn = (x: number, y: number) =>
  `M${x},${y} Q${(x + hubX) / 2},${(y + hubY) / 2 - 30} ${hubX},${hubY}`

// The "bolt" icon path (SectionIcon), recentred on (0,0) so it can be scaled and rotated as the hub.
const boltPath = "M2,-20 L-10,2 L-2,2 L-6,20 L10,-4 L0,-4 Z"
---

<svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 h-full w-full" aria-hidden="true">
  <defs>
    <radialGradient id="pr-hub-glow-outer" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#468B79" stop-opacity="0.36" />
      <stop offset="55%" stop-color="#468B79" stop-opacity="0.16" />
      <stop offset="100%" stop-color="#468B79" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="pr-hub-glow-inner" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#8FD0B8" stop-opacity="0.45" />
      <stop offset="100%" stop-color="#468B79" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="pr-signal-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#468B79" stop-opacity="0.45" />
      <stop offset="100%" stop-color="#468B79" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="pr-price-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#8FD0B8" stop-opacity="0.55" />
      <stop offset="100%" stop-color="#468B79" stop-opacity="0" />
    </radialGradient>
  </defs>

  <circle cx={hubX} cy={hubY} r="620" fill="url(#pr-hub-glow-outer)" />
  <circle cx={hubX} cy={hubY} r="280" fill="url(#pr-hub-glow-inner)" />

  {signals.map((s) => (
    <g>
      <path d={curveIn(s.x, s.y)} fill="none" stroke="#1F4438" stroke-width="1.5" stroke-opacity="0.5" />

      <circle r="3.5" fill="#66AE95">
        <animateMotion dur="3.6s" repeatCount="indefinite" begin={`${s.delay}s`} path={curveIn(s.x, s.y)} />
        <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.1;0.8;1" dur="3.6s" repeatCount="indefinite" begin={`${s.delay}s`} />
      </circle>

      <circle cx={s.x} cy={s.y} r="26" fill="url(#pr-signal-glow)" />
      <g transform={`translate(${s.x} ${s.y})`}>
        <g class="fb-float" style={`animation-delay: ${s.delay * 0.4}s`}>
          <circle r="10" fill="#0C1F19" stroke="#66AE95" stroke-width="1.5" stroke-opacity="0.9" />
          <path d="M-4,3 Q0,-5 4,3" fill="none" stroke="#8FD0B8" stroke-width="1.3" stroke-linecap="round" />
          <line x1="0" y1="-6" x2="0" y2="6" stroke="#8FD0B8" stroke-width="1.3" stroke-linecap="round" />
        </g>
      </g>
    </g>
  ))}

  <path d={`M${hubX},${hubY} L${priceX},${priceY}`} fill="none" stroke="#2C6E58" stroke-width="1.5" stroke-opacity="0.55" class="fb-dash-flow" />

  <circle cx={priceX} cy={priceY} r="60" fill="url(#pr-price-glow)" />
  <g transform={`translate(${priceX} ${priceY})`}>
    <g class="fb-float">
      <path d="M-24,-8 L-6,-24 L20,-24 L24,-4 L2,20 Z" fill="#003828" stroke="#8FD0B8" stroke-width="1.6" stroke-opacity="0.95" />
      <circle cx="-10" cy="-12" r="3" fill="#003828" stroke="#8FD0B8" stroke-width="1.4" />

      <path d="M-9,10 A15,15 0 0 1 15,4" fill="none" stroke="#1F4438" stroke-width="2" stroke-linecap="round" />
      <circle cx="-9" cy="10" r="2" fill="#8FD0B8" />
      <circle cx="15" cy="4" r="2" fill="#8FD0B8" />
      <line x1="3" y1="7" x2="3" y2="-5" stroke="#C7E3DA" stroke-width="1.8" stroke-linecap="round">
        <animateTransform
          attributeName="transform"
          type="rotate"
          values="-26 3 7; 20 3 7; -26 3 7"
          keyTimes="0;0.5;1"
          dur="4.4s"
          repeatCount="indefinite"
        />
      </line>
    </g>
  </g>

  <circle
    cx={hubX}
    cy={hubY}
    r="92"
    fill="none"
    stroke="#8FD0B8"
    stroke-opacity="0.5"
    class="fb-core-pulse-ring"
    style={`transform-origin: ${hubX}px ${hubY}px`}
  />

  <g transform={`translate(${hubX} ${hubY})`} class="fb-core-breathe">
    <g>
      <animateTransform attributeName="transform" type="rotate" from="0 0 0" to="360 0 0" dur="50s" repeatCount="indefinite" />
      <path d={boltPath} transform="scale(3.1)" fill="#003828" stroke="#8FD0B8" stroke-width="1.4" stroke-linejoin="round" />
    </g>
  </g>
</svg>
