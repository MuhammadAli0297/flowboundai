---
/**
 * Full-bleed ambient hero background for the Wholesale Account Management
 * page. Same dark, glowing, green-on-black "vibe" as the other hero
 * backgrounds, but a distinct composition: the network icon sits fixed as
 * the hub (no rotation), and three account nodes each carry a tier badge
 * and a steady checkmark, gently synced on a slow dashed line rather than
 * flagged, orbiting, or fanned out.
 */
const hubX = 1190
const hubY = 455

const accounts = [
  { x: 900, y: 320, tier: 3, delay: 0 },
  { x: 1460, y: 300, tier: 2, delay: 1.5 },
  { x: 1140, y: 680, tier: 1, delay: 3 },
]

// The "network" icon path (SectionIcon), recentred on (0,0) so it can be scaled as the fixed hub.
const networkLines = "M-12,8 L12,8 M-12,8 L0,-16 M12,8 L0,-16"
const networkNodes = [
  { x: -12, y: 8 },
  { x: 12, y: 8 },
  { x: 0, y: -16 },
]
---

<svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 h-full w-full" aria-hidden="true">
  <defs>
    <radialGradient id="wa-hub-glow-outer" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#468B79" stop-opacity="0.34" />
      <stop offset="55%" stop-color="#468B79" stop-opacity="0.15" />
      <stop offset="100%" stop-color="#468B79" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="wa-hub-glow-inner" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#8FD0B8" stop-opacity="0.4" />
      <stop offset="100%" stop-color="#468B79" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="wa-node-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#468B79" stop-opacity="0.45" />
      <stop offset="100%" stop-color="#468B79" stop-opacity="0" />
    </radialGradient>
  </defs>

  <circle cx={hubX} cy={hubY} r="600" fill="url(#wa-hub-glow-outer)" />
  <circle cx={hubX} cy={hubY} r="260" fill="url(#wa-hub-glow-inner)" />

  {accounts.map((a) => (
    <g>
      <path d={`M${hubX},${hubY} L${a.x},${a.y}`} fill="none" stroke="#1F4438" stroke-width="1.5" stroke-opacity="0.5" class="fb-dash-flow" />

      <circle cx={a.x} cy={a.y} r="26" fill="url(#wa-node-glow)" />
      <g transform={`translate(${a.x} ${a.y})`} class="fb-float" style={`animation-delay: ${a.delay * 0.4}s`}>
        <rect x="-14" y="-11" width="28" height="22" rx="4" fill="#0C1F19" stroke="#66AE95" stroke-width="1.5" stroke-opacity="0.9" />
        {Array.from({ length: a.tier }).map((_, i) => (
          <rect x={-9 + i * 6} y={4 - i * 3} width="3.5" height={3 + i * 3} fill="#8FD0B8" />
        ))}
        <path d="M5,-6 L8,-3 L13,-9" fill="none" stroke="#8FD0B8" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
      </g>
    </g>
  ))}

  <circle
    cx={hubX}
    cy={hubY}
    r="80"
    fill="none"
    stroke="#8FD0B8"
    stroke-opacity="0.45"
    class="fb-core-pulse-ring"
    style={`transform-origin: ${hubX}px ${hubY}px; animation-duration: 4.4s;`}
  />

  <g transform={`translate(${hubX} ${hubY})`} class="fb-core-breathe">
    <g transform="scale(3.1)">
      <path d={networkLines} fill="none" stroke="#8FD0B8" stroke-width="1.2" stroke-linecap="round" />
      {networkNodes.map((n) => (
        <circle cx={n.x} cy={n.y} r="4" fill="#003828" stroke="#8FD0B8" stroke-width="1.4" />
      ))}
    </g>
    <circle r="7" fill="#C7E3DA" />
  </g>
</svg>
