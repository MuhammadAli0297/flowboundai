---
// Wholesale Account Management hero background: "Ledger Sync", ocean-palette, canvas 2D (see
// src/scripts/wholesaleAccountManagementHero.ts). A fixed network hub sits among several account
// nodes, each with a tier ring and a checkmark, breathing calmly in unison. Every few seconds a
// synchronization wave ripples outward from the hub and flashes each account as it passes, no
// urgency anywhere in it. The hub does not rotate.
---

<div class="hero-canvas-wrap absolute inset-0 overflow-hidden" aria-hidden="true">
  <div class="hero-base-gradient absolute inset-0"></div>
  <canvas id="wholesale-account-management-hero" class="absolute inset-0 h-full w-full"></canvas>
  <div class="absolute inset-0 bg-grain opacity-20 mix-blend-overlay"></div>
</div>

<style>
  .hero-base-gradient {
    background:
      radial-gradient(85% 70% at 68% 50%, rgba(74, 111, 165, 0.26), transparent 60%),
      radial-gradient(70% 60% at 98% 85%, rgba(79, 109, 122, 0.22), transparent 60%),
      #104866;
  }
</style>

<script>
  import "../scripts/wholesaleAccountManagementHero"
</script>
